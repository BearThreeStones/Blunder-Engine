{
  "mcpServers": {
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp",
        "--path",
        "${workspaceFolder}"
      ]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "blunder-editor": {
      "type": "stdio",
      "command": "${workspaceFolder}/build/vs2026-debug/bin/Debug/engine_editor.exe",
      "args": [
        "--mcp",
        "--project-root",
        "E:\\Blunder Projects\\Test",
        "--scene",
        "assets/Scenes/sponza.scene.asset"
      ]
    }
  }
}
