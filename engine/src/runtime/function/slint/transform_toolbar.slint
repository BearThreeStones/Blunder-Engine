import { EditorTheme, EditorToolbarButton } from "editor_controls.slint";
import { EditorGlyphs } from "editor_icons.slint";

export component TransformToolbar inherits Rectangle {
    in property <int> transform-mode: 0;
    in property <bool> gizmo-space-global: true;

    callback transform-mode-selected(int);
    callback gizmo-space-toggled();

    height: 32px;
    width: strip.preferred-width;
    horizontal-stretch: 0;
    background: EditorTheme.toolbar.with-alpha(88%);
    border-radius: EditorTheme.radius-surface;
    border-width: 1px;
    border-color: EditorTheme.hairline;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;

    strip := HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 2px;
        alignment: start;

        EditorToolbarButton {
            icon: EditorGlyphs.tool-move;
            checked: root.transform-mode == 1;
            clicked => { root.transform-mode-selected(1); }
        }
        EditorToolbarButton {
            icon: EditorGlyphs.tool-rotate;
            checked: root.transform-mode == 2;
            clicked => { root.transform-mode-selected(2); }
        }
        EditorToolbarButton {
            icon: EditorGlyphs.tool-scale;
            checked: root.transform-mode == 3;
            clicked => { root.transform-mode-selected(3); }
        }

        Rectangle {
            width: 6px;
            horizontal-stretch: 0;
        }

        EditorToolbarButton {
            icon: root.gizmo-space-global ? EditorGlyphs.space-global : EditorGlyphs.space-local;
            clicked => { root.gizmo-space-toggled(); }
        }
    }
}
