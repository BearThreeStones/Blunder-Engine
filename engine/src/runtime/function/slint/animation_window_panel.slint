import { EditorTheme, EditorButton, EditorSlider } from "editor_controls.slint";
import { EditorGlyphs } from "editor_icons.slint";

export component AnimationWindowPanel inherits Rectangle {
    in property <bool> bound: false;
    in property <bool> playing: false;
    in property <bool> paused: false;
    in property <bool> pause-enabled: false;
    in property <bool> stop-enabled: false;
    in property <bool> looping: false;
    in-out property <float> time-scale: 1.0;
    in property <float> playhead: 0.0;
    in property <float> clip-length: 1.0;
    in property <string> clip-name: "";
    in property <string> clock-text: "";
    in property <[string]> fire-clips: [];
    in-out property <string> fire-target: "";
    in property <bool> in-cine: false;
    in property <bool> input-suppressed: false;
    in property <string> time-scale-text: "1.00";

    callback play-requested();
    callback pause-requested();
    callback stop-requested();
    callback loop-toggled();
    callback fire-requested();
    callback enter-cine-requested();
    callback end-cine-requested();
    callback timescale-pressed();
    callback timescale-edited();
    callback timescale-committed();
    callback seeked(float);
    callback fire-target-changed(string);

    background: EditorTheme.window;

    private property <float> ruler-t: root.clip-length > 0.0001 ? Math.max(0.0, Math.min(1.0, root.playhead / root.clip-length)) : 0.0;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            HorizontalLayout {
                spacing: 2px;
                vertical-stretch: 0;

                EditorButton {
                    icon: EditorGlyphs.play;
                    primary: true;
                    enabled: root.bound && !root.playing;
                    clicked => { root.play-requested(); }
                }
                EditorButton {
                    icon: root.paused ? EditorGlyphs.play : EditorGlyphs.pause;
                    enabled: root.bound && root.pause-enabled;
                    clicked => { root.pause-requested(); }
                }
                EditorButton {
                    icon: EditorGlyphs.stop;
                    enabled: root.bound && root.stop-enabled;
                    clicked => { root.stop-requested(); }
                }
                EditorButton {
                    icon: EditorGlyphs.loop;
                    checked: root.looping;
                    enabled: root.bound;
                    clicked => { root.loop-toggled(); }
                }
            }

            Rectangle { width: 8px; }

            HorizontalLayout {
                spacing: 6px;
                vertical-stretch: 0;
                min-width: 160px;

                Image {
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    source: EditorGlyphs.time;
                    colorize: EditorTheme.muted;
                    image-fit: contain;
                }
                EditorSlider {
                    horizontal-stretch: 1;
                    minimum: 0.1;
                    maximum: 2.0;
                    enabled: root.bound;
                    value <=> root.time-scale;
                    pressed => { root.timescale-pressed(); }
                    edited => { root.timescale-edited(); }
                    committed => { root.timescale-committed(); }
                }
                Text {
                    text: root.time-scale-text;
                    color: EditorTheme.muted;
                    font-size: EditorTheme.font-sm;
                    vertical-alignment: center;
                    min-width: 28px;
                }
            }

            Rectangle { horizontal-stretch: 1; }

            Text {
                text: root.bound ? root.clock-text : "";
                color: EditorTheme.muted;
                font-size: EditorTheme.font-sm;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            vertical-stretch: 0;

            fire-combo := Rectangle {
                height: EditorTheme.line;
                min-width: 120px;
                border-radius: EditorTheme.radius-ctl;
                border-width: 1px;
                border-color: EditorTheme.hairline;
                background: EditorTheme.field;
                opacity: root.bound ? 1.0 : 0.45;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 6px;
                    spacing: 4px;
                    Text {
                        text: root.fire-target;
                        color: EditorTheme.default-text;
                        font-size: EditorTheme.font;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Image {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - self.height) / 2;
                        source: EditorGlyphs.option-arrow;
                        colorize: EditorTheme.muted;
                        image-fit: contain;
                    }
                }

                fire-touch := TouchArea {
                    width: 100%;
                    height: 100%;
                    enabled: root.bound && root.fire-clips.length > 0;
                    mouse-cursor: pointer;
                    clicked => { fire-popup.show(); }
                }

                fire-popup := PopupWindow {
                    y: parent.height + 2px;
                    close-policy: close-on-click-outside;
                    Rectangle {
                        background: EditorTheme.window;
                        border-width: 1px;
                        border-color: EditorTheme.hairline;
                        border-radius: EditorTheme.radius-ctl;
                        VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            for name in root.fire-clips: Rectangle {
                                height: EditorTheme.line;
                                border-radius: 2px;
                                background: choice-touch.has-hover ? EditorTheme.button-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: name;
                                        color: name == root.fire-target ? EditorTheme.accent-sel-text : EditorTheme.default-text;
                                        font-size: EditorTheme.font;
                                        vertical-alignment: center;
                                    }
                                }
                                choice-touch := TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => {
                                        root.fire-target = name;
                                        root.fire-target-changed(name);
                                        fire-popup.close();
                                    }
                                }
                            }
                        }
                    }
                }
            }

            EditorButton {
                icon: EditorGlyphs.play-start;
                enabled: root.bound && root.fire-target != "";
                clicked => { root.fire-requested(); }
            }

            Rectangle { width: 8px; }

            EditorButton {
                icon: EditorGlyphs.camera;
                enabled: root.bound && !root.in-cine;
                clicked => { root.enter-cine-requested(); }
            }
            EditorButton {
                icon: EditorGlyphs.transition-end;
                enabled: root.bound && root.in-cine;
                clicked => { root.end-cine-requested(); }
            }

            Rectangle {
                height: EditorTheme.line;
                min-width: 40px;
                border-radius: 999px;
                border-width: 1px;
                border-color: root.in-cine ? #b06aff : EditorTheme.hairline;
                background: root.in-cine ? #6a3d9a : EditorTheme.button;
                opacity: root.in-cine ? 1.0 : 0.35;
                Text {
                    width: 100%;
                    height: 100%;
                    text: "CINE";
                    color: #ffffff;
                    font-size: EditorTheme.font-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: EditorTheme.line;
                min-width: 32px;
                border-radius: 999px;
                border-width: 1px;
                border-color: root.input-suppressed ? #ff6a6a : EditorTheme.hairline;
                background: root.input-suppressed ? #9a3d3d : EditorTheme.button;
                opacity: root.input-suppressed ? 1.0 : 0.35;
                Text {
                    width: 100%;
                    height: 100%;
                    text: "Inp";
                    color: #ffffff;
                    font-size: EditorTheme.font-sm;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle { horizontal-stretch: 1; }
        }

        if root.bound: ruler := Rectangle {
            height: 36px;
            vertical-stretch: 0;
            background: EditorTheme.field;
            border-width: 1px;
            border-color: EditorTheme.hairline;
            border-radius: EditorTheme.radius-ctl;
            clip: true;

            Rectangle {
                x: 8px;
                y: parent.height / 2;
                width: parent.width - 16px;
                height: 1px;
                background: #6a6a6a;
            }
            Rectangle {
                x: 8px + (parent.width - 16px) * root.ruler-t - 1px;
                y: 4px;
                width: 2px;
                height: parent.height - 8px;
                background: EditorTheme.accent;
            }
            Text {
                x: 10px;
                y: 4px;
                text: root.clip-name;
                color: EditorTheme.muted;
                font-size: EditorTheme.font-sm;
            }

            ruler-touch := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                moved => {
                    if (self.pressed) {
                        root.seeked(root.clip-length * Math.max(0.0, Math.min(1.0, (self.mouse-x - 8px) / (parent.width - 16px))));
                    }
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                        root.seeked(root.clip-length * Math.max(0.0, Math.min(1.0, (self.mouse-x - 8px) / (parent.width - 16px))));
                    }
                }
            }
        }

        if !root.bound: Text {
            text: "Select an Object with an AnimationTree";
            color: EditorTheme.muted;
            font-size: EditorTheme.font-sm;
            vertical-stretch: 1;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
