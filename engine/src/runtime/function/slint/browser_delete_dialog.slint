import { EditorTheme, EditorButton, EditorModalPanel } from "editor_controls.slint";

export component BrowserDeleteDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in property <string> folder-name: "";
    in property <int> asset-count: 0;

    callback confirmed();
    callback cancelled();

    visible: root.show-dialog;
    background: EditorTheme.modal-dim;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    EditorModalPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        panel-width: 440px;

        Text {
            text: "Delete from Content Browser";
            color: EditorTheme.default-text;
            font-size: EditorTheme.font-lg;
        }

        Text {
            text: "Delete \"" + root.folder-name + "\" and "
                + root.asset-count + " Asset(s)? This can be undone from Global History.";
            color: EditorTheme.window-text;
            font-size: EditorTheme.font;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            EditorButton {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            EditorButton {
                text: "Delete";
                primary: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
