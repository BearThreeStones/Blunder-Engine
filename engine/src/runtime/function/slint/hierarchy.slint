import { EditorTheme } from "editor_theme.slint";
import {
    EditorIconTreeArrowRight,
    EditorIconTreeArrowDown,
    EditorIconScene,
    EditorIconToolMove,
    EditorIconMesh,
    EditorIconCamera3D,
    EditorIconLight,
    EditorIconSkeleton3D,
    EditorIconAnimationTree,
    EditorIconScript,
    EditorIconSkeletonModifier3D,
} from "editor_icons.slint";

export struct HierarchyRowIcon {
    kind: int,
    index: int,
}

export struct HierarchyTreeRow {
    entity-id: int,
    name: string,
    depth: int,
    expanded: bool,
    has-children: bool,
    selected: bool,
    is-last-sibling: bool,
    ancestor-cont-mask: int,
    icons: [HierarchyRowIcon],
}

component HierarchyLineGutterCell {
    in property <int> column;
    in property <int> row-depth;
    in property <bool> is-last-sibling;
    in property <int> ancestor-cont-mask;

    width: 18px;
    height: 22px;

    property <bool> parent-col: column == row-depth - 1;
    property <bool> through-stem:
        !parent-col
        && column >= 0
        && column <= 30
        && Math.mod(Math.floor(ancestor-cont-mask / Math.pow(2, column)), 2) == 1;
    property <bool> draw-tee: parent-col && !is-last-sibling;
    property <bool> draw-ell: parent-col && is-last-sibling;

    // Through-stem for a non-last ancestor.
    if root.through-stem: Rectangle {
        x: (parent.width - 1px) / 2;
        y: 0;
        width: 1px;
        height: parent.height;
        background: EditorTheme.hier-line;
    }

    // T: full-height stem + tick into the chevron column.
    if root.draw-tee: Rectangle {
        x: (parent.width - 1px) / 2;
        y: 0;
        width: 1px;
        height: parent.height;
        background: EditorTheme.hier-line;
    }
    if root.draw-tee: Rectangle {
        x: (parent.width - 1px) / 2;
        y: (parent.height - 1px) / 2;
        width: parent.width / 2;
        height: 1px;
        background: EditorTheme.hier-line;
    }

    // L: stem to mid-row + tick into the chevron column.
    if root.draw-ell: Rectangle {
        x: (parent.width - 1px) / 2;
        y: 0;
        width: 1px;
        height: parent.height / 2;
        background: EditorTheme.hier-line;
    }
    if root.draw-ell: Rectangle {
        x: (parent.width - 1px) / 2;
        y: (parent.height - 1px) / 2;
        width: parent.width / 2;
        height: 1px;
        background: EditorTheme.hier-line;
    }
}

export component HierarchyPanel {
    in-out property <[HierarchyTreeRow]> tree-rows: [];
    in property <int> selected-entity-id: 0;
    in property <bool> show-title: false;
    in property <string> scene-display-name: "(No Scene)";

    callback entity-selected(int);
    callback entity-context-selected(int);
    callback entity-toggle(int);
    callback create-requested(int, string);
    callback delete-requested(int);
    callback icon-pressed(int, float, float);

    out property <length> hierarchy-origin-x: hierarchy-root.absolute-position.x;
    out property <length> hierarchy-origin-y: hierarchy-root.absolute-position.y;
    out property <length> hierarchy-width: hierarchy-root.width;
    out property <length> hierarchy-height: hierarchy-root.height;
    in-out property <length> tree-origin-y: tree-list.absolute-position.y;

    min-height: 80px;
    vertical-stretch: 0;

    hierarchy-root := Rectangle {
        background: EditorTheme.window;
        border-color: EditorTheme.hairline;
        border-width: 1px;
        vertical-stretch: 1;

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            if root.show-title: Text {
                text: "Hierarchy";
                color: EditorTheme.window-text;
                font-size: 14px;
            }

            if root.show-title: Rectangle { background: EditorTheme.hairline; height: 1px; }

            scene-header := Rectangle {
                horizontal-stretch: 1;
                height: 22px;
                background: transparent;

                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 2px;
                    height: 22px;

                    EditorIconScene {
                        icon-size: 14px;
                        icon-color: EditorTheme.icon;
                        y: (parent.height - self.height) / 2;
                    }

                    Text {
                        text: root.scene-display-name;
                        color: EditorTheme.default-text;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }

                ContextMenuArea {
                    width: 100%;
                    height: 100%;
                    Menu {
                        MenuItem {
                            title: "Empty";
                            activated => { root.create-requested(0, "empty"); }
                        }
                        MenuItem {
                            title: "Camera";
                            activated => { root.create-requested(0, "camera"); }
                        }
                        MenuItem {
                            title: "Light";
                            activated => { root.create-requested(0, "light"); }
                        }
                    }
                }
            }

            tree-panel := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                clip: true;

                tree-scroll := Flickable {
                    width: parent.width;
                    height: parent.height;
                    interactive: true;
                    viewport-width: parent.width;
                    viewport-height: tree-list.preferred-height;

                    ContextMenuArea {
                        width: parent.width;
                        height: Math.max(parent.height, tree-list.preferred-height);
                        Menu {
                            MenuItem {
                                title: "Empty";
                                activated => { root.create-requested(0, "empty"); }
                            }
                            MenuItem {
                                title: "Camera";
                                activated => { root.create-requested(0, "camera"); }
                            }
                            MenuItem {
                                title: "Light";
                                activated => { root.create-requested(0, "light"); }
                            }
                        }
                    }

                    tree-list := VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 0px;

                        for row[index] in root.tree-rows: Rectangle {
                            horizontal-stretch: 1;
                            height: 22px;
                            background: row.selected ? EditorTheme.accent-sel-fill : #00000000;

                            row-touch := TouchArea {
                                width: 100%;
                                height: 100%;

                                property <length> chevron-x: row.depth * 18px;

                                pointer-event(event) => {
                                    if (event.kind == PointerEventKind.down
                                        && event.button == PointerEventButton.left) {
                                        if (row.has-children
                                            && self.mouse-x >= self.chevron-x
                                            && self.mouse-x < self.chevron-x + 18px) {
                                            root.entity-toggle(row.entity-id);
                                        } else {
                                            root.entity-selected(row.entity-id);
                                            if (self.mouse-x >= self.width - icon-strip.width) {
                                                root.icon-pressed(
                                                    row.entity-id,
                                                    self.mouse-x / 1px,
                                                    self.width / 1px);
                                            }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    width: 100%;
                                    height: 100%;
                                    spacing: 0px;

                                    for column in row.depth: HierarchyLineGutterCell {
                                        column: column;
                                        row-depth: row.depth;
                                        is-last-sibling: row.is-last-sibling;
                                        ancestor-cont-mask: row.ancestor-cont-mask;
                                    }

                                    if row.has-children: Rectangle {
                                        width: 18px;
                                        height: 22px;

                                        if row.expanded: EditorIconTreeArrowDown {
                                            icon-size: 10px;
                                            icon-color: EditorTheme.icon;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if !row.expanded: EditorIconTreeArrowRight {
                                            icon-size: 10px;
                                            icon-color: EditorTheme.icon;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    if !row.has-children: Rectangle {
                                        width: 18px;
                                        height: 22px;
                                    }

                                    Rectangle { width: 4px; height: 22px; }

                                    Text {
                                        text: row.name;
                                        color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.default-text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }

                                    icon-strip := HorizontalLayout {
                                        spacing: 2px;
                                        padding-right: 4px;
                                        alignment: end;

                                        for icon in row.icons: Rectangle {
                                            width: 16px;
                                            height: 22px;

                                            if icon.kind == 0: EditorIconToolMove {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 1: EditorIconMesh {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 2: EditorIconCamera3D {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 3: EditorIconLight {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 4: EditorIconSkeleton3D {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 5: EditorIconAnimationTree {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 6: EditorIconScript {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            if icon.kind == 7: EditorIconSkeletonModifier3D {
                                                icon-size: 14px;
                                                icon-color: row.selected ? EditorTheme.accent-sel-text : EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }
                            }

                            ContextMenuArea {
                                x: 0px;
                                y: 0px;
                                width: 100%;
                                height: 100%;
                                Menu {
                                    MenuItem {
                                        title: "Empty";
                                        activated => { root.create-requested(row.entity-id, "empty"); }
                                    }
                                    MenuItem {
                                        title: "Camera";
                                        activated => { root.create-requested(row.entity-id, "camera"); }
                                    }
                                    MenuItem {
                                        title: "Light";
                                        activated => { root.create-requested(row.entity-id, "light"); }
                                    }
                                    MenuSeparator {}
                                    MenuItem {
                                        title: "Delete";
                                        activated => { root.delete-requested(row.entity-id); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
