// Glyphs for icon-only chrome (App Bar Play cluster, Viewport transform strip).
export global EditorGlyphs {
    out property <image> play: @image-url("../../../../3rdparty/godot-icons/Play.svg");
    out property <image> pause: @image-url("../../../../3rdparty/godot-icons/Pause.svg");
    out property <image> stop: @image-url("../../../../3rdparty/godot-icons/Stop.svg");
    out property <image> tool-move: @image-url("../../../../3rdparty/godot-icons/ToolMove.svg");
    out property <image> tool-rotate: @image-url("../../../../3rdparty/godot-icons/ToolRotate.svg");
    out property <image> tool-scale: @image-url("../../../../3rdparty/godot-icons/ToolScale.svg");
    out property <image> space-global: @image-url("../../../../3rdparty/godot-icons/WorldEnvironment.svg");
    out property <image> space-local: @image-url("../../../../3rdparty/godot-icons/Object.svg");
    out property <image> arrow-right: @image-url("../../../../3rdparty/godot-icons/GuiTreeArrowRight.svg");
    out property <image> arrow-down: @image-url("../../../../3rdparty/godot-icons/GuiTreeArrowDown.svg");
    out property <image> option-arrow: @image-url("../../../../3rdparty/godot-icons/GuiOptionArrow.svg");
    out property <image> close: @image-url("../../../../3rdparty/godot-icons/Close.svg");
    out property <image> more: @image-url("../../../../3rdparty/godot-icons/GuiEllipsis.svg");
    out property <image> move-up: @image-url("../../../../3rdparty/godot-icons/MoveUp.svg");
    out property <image> move-down: @image-url("../../../../3rdparty/godot-icons/MoveDown.svg");
    out property <image> mesh: @image-url("../../../../3rdparty/godot-icons/MeshInstance3D.svg");
    out property <image> material: @image-url("../../../../3rdparty/godot-icons/StandardMaterial3D.svg");
    out property <image> script: @image-url("../../../../3rdparty/godot-icons/Script.svg");
    out property <image> camera: @image-url("../../../../3rdparty/godot-icons/Camera3D.svg");
    out property <image> light: @image-url("../../../../3rdparty/godot-icons/GizmoLight.svg");
    out property <image> skeleton: @image-url("../../../../3rdparty/godot-icons/Skeleton3D.svg");
    out property <image> animation-player: @image-url("../../../../3rdparty/godot-icons/AnimationPlayer.svg");
    out property <image> animation-tree: @image-url("../../../../3rdparty/godot-icons/AnimationTree.svg");
    out property <image> skeleton-modifier: @image-url("../../../../3rdparty/godot-icons/SkeletonModifier3D.svg");
    out property <image> loop: @image-url("../../../../3rdparty/godot-icons/Loop.svg");
    // Godot PlayStart.svg uses a z/m compound path; usvg keeps the bar and drops the triangle.
    out property <image> play-start: @image-url("play_start.svg");
    out property <image> transition-end: @image-url("../../../../3rdparty/godot-icons/TransitionEnd.svg");
    out property <image> time: @image-url("../../../../3rdparty/godot-icons/Time.svg");
    out property <image> search: @image-url("../../../../3rdparty/godot-icons/Search.svg");
    out property <image> check: @image-url("../../../../3rdparty/godot-icons/ImportCheck.svg");
    out property <image> console-log: @image-url("console_sev_log.svg");
    out property <image> console-warning: @image-url("console_sev_warning.svg");
    out property <image> console-error: @image-url("console_sev_error.svg");
}
