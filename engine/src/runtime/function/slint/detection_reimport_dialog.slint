import { EditorTheme, EditorButton, EditorModalPanel } from "editor_controls.slint";

export component DetectionReimportDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in property <int> asset-count: 1;

    callback reimport-all();
    callback dismissed();

    visible: root.show-dialog;
    background: EditorTheme.modal-dim;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    EditorModalPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        panel-width: 440px;

        Text {
            text: "Source file updated, reimport?";
            color: EditorTheme.default-text;
            font-size: EditorTheme.font-lg;
        }

        Text {
            text: root.asset-count == 1
                ? "1 Asset changed on disk."
                : root.asset-count + " Assets changed on disk.";
            color: EditorTheme.window-text;
            font-size: EditorTheme.font;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            EditorButton {
                text: "Dismiss";
                clicked => { root.dismissed(); }
            }
            EditorButton {
                text: "Reimport All";
                primary: true;
                clicked => { root.reimport-all(); }
            }
        }
    }
}
