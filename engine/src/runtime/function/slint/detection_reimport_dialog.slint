import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";

export component DetectionReimportDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in property <int> asset-count: 1;

    callback reimport-all();
    callback dismissed();

    visible: root.show-dialog;
    background: #000000aa;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    dialog-panel := Rectangle {
        width: 440px;
        height: 170px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #252525;
        border-color: #444444;
        border-width: 1px;
        border-radius: 6px;

        VerticalBox {
            padding: 16px;
            spacing: 12px;

            Text {
                text: "Source file updated, reimport?";
                color: #f0f0f0;
                font-size: 14px;
            }

            Text {
                text: root.asset-count == 1
                    ? "1 Asset changed on disk."
                    : root.asset-count + " Assets changed on disk.";
                color: #c0c0c0;
                font-size: 12px;
                wrap: word-wrap;
            }

            HorizontalBox {
                spacing: 8px;
                alignment: end;

                Button {
                    text: "Dismiss";
                    clicked => { root.dismissed(); }
                }

                Button {
                    text: "Reimport All";
                    primary: true;
                    clicked => { root.reimport-all(); }
                }
            }
        }
    }
}
