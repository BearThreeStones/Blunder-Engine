import { EditorTheme } from "editor_theme.slint";
import { EditorGlyphs } from "editor_icons.slint";

export { EditorTheme }

export component EditorButton inherits Rectangle {
    in property <string> text: "";
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> checked: false;
    callback clicked();

    private property <bool> icon-only: root.text == "" && root.icon.width > 0;

    height: EditorTheme.line;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    min-width: root.icon-only ? EditorTheme.line : 28px;
    max-width: root.icon-only ? EditorTheme.line : 9999px;
    border-radius: EditorTheme.radius-ctl;
    border-width: 1px;
    border-color: !root.enabled ? EditorTheme.hairline
        : (root.primary || root.checked) ? EditorTheme.accent-line
        : (root.ghost && !ta.has-hover ? transparent : EditorTheme.hairline);
    background: !root.enabled ? EditorTheme.button
        : (root.primary || root.checked)
            ? (ta.pressed ? EditorTheme.accent.mix(#000000, 12%) : (ta.has-hover ? EditorTheme.accent-hover : EditorTheme.accent))
        : root.ghost
            ? (ta.has-hover ? EditorTheme.button : transparent)
            : (ta.pressed ? EditorTheme.button-pressed : (ta.has-hover ? EditorTheme.button-hover : EditorTheme.button));
    opacity: root.enabled ? 1.0 : 0.45;

    VerticalLayout {
        width: 100%;
        height: 100%;
        alignment: center;
        padding-left: root.icon-only ? 0px : 10px;
        padding-right: root.icon-only ? 0px : 10px;

        HorizontalLayout {
            alignment: center;
            spacing: 4px;
            vertical-stretch: 0;

            if root.icon.width > 0: Image {
                width: 14px;
                height: 14px;
                source: root.icon;
                colorize: !root.enabled ? EditorTheme.muted
                    : (root.primary || root.checked) ? EditorTheme.accent-text
                    : EditorTheme.icon;
                image-fit: contain;
            }

            if root.text != "": Text {
                text: root.text;
                color: !root.enabled ? EditorTheme.muted
                    : (root.primary || root.checked) ? EditorTheme.accent-text
                    : EditorTheme.button-text;
                font-size: EditorTheme.font;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component EditorToolbarButton inherits EditorButton {
    height: 24px;
    min-width: 28px;
    max-width: 28px;
    horizontal-stretch: 0;
}

export component EditorSegmented inherits Rectangle {
    height: EditorTheme.line-lg;
    vertical-stretch: 0;
    horizontal-stretch: 0;
    border-radius: EditorTheme.radius-ctl;
    border-width: 1px;
    border-color: EditorTheme.hairline;
    background: EditorTheme.toolbar;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        alignment: center;
        @children
    }
}

export component EditorTab inherits Rectangle {
    in property <string> text: "";
    in property <bool> active: false;
    callback clicked();

    height: EditorTheme.line;
    border-radius: EditorTheme.radius-ctl;
    background: root.active ? EditorTheme.tab-active
        : (ta.has-hover ? EditorTheme.tab-hover : EditorTheme.tab-idle);

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? EditorTheme.default-text : EditorTheme.tab-text;
            font-size: EditorTheme.font;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component EditorFoldout inherits Rectangle {
    in property <string> title: "";
    in property <image> icon;
    in-out property <bool> expanded: true;
    callback toggled();

    height: EditorTheme.line-lg;
    border-radius: EditorTheme.radius-ctl;
    background: ta.has-hover ? EditorTheme.toolbar : transparent;

    // TouchArea behind the row so header children (Remove) keep their own hits.
    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            root.expanded = !root.expanded;
            root.toggled();
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: start;

        Rectangle {
            width: 12px;
            Image {
                y: (parent.height - self.height) / 2;
                width: 12px;
                height: 12px;
                source: root.expanded ? EditorGlyphs.arrow-down : EditorGlyphs.arrow-right;
                colorize: EditorTheme.icon;
                image-fit: contain;
            }
        }
        if root.icon.width > 0: Rectangle {
            width: 14px;
            Image {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                source: root.icon;
                colorize: EditorTheme.icon;
                image-fit: contain;
            }
        }
        Text {
            text: root.title;
            color: EditorTheme.default-text;
            font-size: EditorTheme.font-lg;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

export component EditorTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited();

    height: EditorTheme.line;
    border-radius: EditorTheme.radius-ctl;
    border-width: 1px;
    border-color: input.has-focus ? EditorTheme.accent : EditorTheme.hairline;
    background: EditorTheme.field;
    opacity: root.enabled ? 1.0 : 0.45;

    input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        color: EditorTheme.default-text;
        font-size: EditorTheme.font;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    if root.text == "" && root.placeholder != "" && !input.has-focus: Text {
        x: 8px;
        width: parent.width - 16px;
        height: 100%;
        text: root.placeholder;
        color: EditorTheme.muted;
        font-size: EditorTheme.font;
        vertical-alignment: center;
    }
}

export component EditorSearchField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "Search";
    callback accepted();
    callback edited();

    height: EditorTheme.line;
    border-radius: EditorTheme.radius-ctl;
    border-width: 1px;
    border-color: input.has-focus ? EditorTheme.accent : EditorTheme.hairline;
    background: EditorTheme.field;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 6px;
        alignment: center;

        Text {
            text: "⌕";
            color: EditorTheme.icon;
            font-size: EditorTheme.font;
            vertical-alignment: center;
        }

        input := TextInput {
            horizontal-stretch: 1;
            text <=> root.text;
            color: EditorTheme.default-text;
            font-size: EditorTheme.font;
            vertical-alignment: center;
            single-line: true;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

export component EditorToggle inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <bool> enabled: true;
    callback toggled();

    height: EditorTheme.line;
    opacity: root.enabled ? 1.0 : 0.45;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.checked ? EditorTheme.accent : EditorTheme.hairline;
            background: root.checked ? EditorTheme.accent : EditorTheme.field;
            if root.checked: Text {
                text: "✓";
                color: EditorTheme.accent-text;
                font-size: 10px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.text;
            color: EditorTheme.default-text;
            font-size: EditorTheme.font;
            vertical-alignment: center;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

export component EditorSlider inherits Rectangle {
    in-out property <float> value: 0;
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback edited();

    height: EditorTheme.line;
    min-width: 64px;
    opacity: root.enabled ? 1.0 : 0.45;

    private property <float> span: Math.max(root.maximum - root.minimum, 0.0001);
    private property <float> t: Math.max(0.0, Math.min(1.0, (root.value - root.minimum) / root.span));
    private property <length> thumb-sz: 4px;
    private property <length> ring-sz: 10px;
    private property <length> track-h: 1px;
    private property <bool> dragging: false;
    private property <bool> show-circle: root.dragging || slider-touch.has-hover;
    private property <length> thumb-x: (root.width - root.thumb-sz) * root.t;
    private property <length> ring-x: root.thumb-x + (root.thumb-sz - root.ring-sz) / 2;

    // Match Transform rotation under-slider: 1px track, square thumb.
    // Fill is a sibling (not nested) so layout cannot right-align it.
    Rectangle {
        x: 0px;
        y: (root.height - root.track-h) / 2;
        width: root.width;
        height: root.track-h;
        background: #6a6a6a;
    }
    Rectangle {
        x: 0px;
        y: (root.height - root.track-h) / 2;
        width: root.width * root.t;
        height: root.track-h;
        background: #c8c8c8;
    }
    if root.show-circle: Rectangle {
        x: root.ring-x;
        y: (root.height - root.ring-sz) / 2;
        width: root.ring-sz;
        height: root.ring-sz;
        border-radius: root.ring-sz / 2;
        background: transparent;
        border-width: 1.5px;
        border-color: root.dragging ? #ffffff : #ffffff80;
    }
    Rectangle {
        x: root.thumb-x;
        y: (root.height - root.thumb-sz) / 2;
        width: root.thumb-sz;
        height: root.thumb-sz;
        border-radius: root.show-circle ? (root.thumb-sz / 2) : 0px;
        background: #f0f0f0;
    }

    slider-touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => {
            if (self.pressed) {
                root.dragging = true;
                root.value = Math.max(root.minimum, Math.min(root.maximum,
                    root.minimum + self.mouse-x / root.width * root.span));
                root.edited();
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.dragging = true;
                root.value = Math.max(root.minimum, Math.min(root.maximum,
                    root.minimum + self.mouse-x / root.width * root.span));
                root.edited();
            }
            if (event.kind == PointerEventKind.up) {
                root.dragging = false;
            }
        }
    }
}

export component EditorColorField inherits Rectangle {
    in-out property <float> r: 1.0;
    in-out property <float> g: 1.0;
    in-out property <float> b: 1.0;
    in property <bool> empty: false;
    in property <bool> drop-target: false;
    callback clicked();

    height: EditorTheme.line;
    border-radius: EditorTheme.radius-ctl;
    border-width: root.drop-target ? 2px : 1px;
    border-color: root.drop-target ? EditorTheme.accent : EditorTheme.hairline;
    background: EditorTheme.field;

    HorizontalLayout {
        padding: 3px;
        padding-left: 6px;
        padding-right: 8px;
        spacing: 8px;
        alignment: start;

        Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: EditorTheme.hairline;
            background: root.empty ? EditorTheme.toolbar : rgb(root.r * 255, root.g * 255, root.b * 255);
        }

        Text {
            text: root.empty ? "None" : "";
            color: EditorTheme.muted;
            font-size: EditorTheme.font;
            vertical-alignment: center;
            visible: root.empty;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

/// Godot Inspector object cell (22px recessed row). Not Editor Object Field.
export component InspectorObjectCell inherits Rectangle {
    in property <string> label: "";
    in property <string> display-name: "";
    in property <bool> assigned: false;
    in property <bool> drop-target: false;
    callback pick-requested();
    callback clear-requested();
    callback drop-requested();

    height: 22px;

    HorizontalLayout {
        spacing: 6px;
        alignment: center;
        Text {
            text: root.label;
            color: EditorTheme.muted;
            font-size: 11px;
            width: 96px;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 22px;
            border-radius: 3px;
            border-width: root.drop-target ? 2px : 1px;
            border-color: root.drop-target ? EditorTheme.accent : EditorTheme.hairline;
            background: EditorTheme.field;
            TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.up && root.drop-target {
                        root.drop-requested();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 2px;
                spacing: 4px;
                alignment: center;
                Text {
                    text: root.assigned ? root.display-name : "None";
                    color: root.assigned ? EditorTheme.default-text : EditorTheme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                if root.assigned: TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.clear-requested(); }
                    width: 18px;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 10px;
                        height: 10px;
                        source: EditorGlyphs.close;
                        colorize: EditorTheme.muted;
                        image-fit: contain;
                    }
                }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.pick-requested(); }
                    width: 18px;
                    Image {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 12px;
                        height: 12px;
                        source: EditorGlyphs.more;
                        colorize: EditorTheme.muted;
                        image-fit: contain;
                    }
                }
            }
        }
    }
}

export component EditorObjectField inherits Rectangle {
    in property <string> display-name: "";
    in property <bool> assigned: false;
    in property <bool> drop-target: false;
    callback pick-requested();
    callback clear-requested();

    height: EditorTheme.line;
    border-radius: EditorTheme.radius-ctl;
    border-width: root.drop-target ? 2px : 1px;
    border-color: root.drop-target ? EditorTheme.accent : EditorTheme.hairline;
    background: EditorTheme.field;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 4px;
        spacing: 6px;
        alignment: center;

        Text {
            text: root.assigned ? root.display-name : "None";
            color: root.assigned ? EditorTheme.default-text : EditorTheme.muted;
            font-size: EditorTheme.font;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.assigned: EditorButton {
            text: "×";
            ghost: true;
            clicked => { root.clear-requested(); }
        }

        EditorButton {
            text: "…";
            ghost: true;
            clicked => { root.pick-requested(); }
        }
    }
}

/// Godot-compact Inspector cell (22px, 3px radius, recessed fill). Not Editor Numeric Field.
export component EditorCompactField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback accepted();
    callback edited();

    height: EditorTheme.line;
    border-radius: 3px;
    border-width: 1px;
    border-color: input.has-focus ? EditorTheme.accent : EditorTheme.hairline;
    background: EditorTheme.field;
    opacity: root.enabled ? 1.0 : 0.45;

    input := TextInput {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text <=> root.text;
        enabled: root.enabled;
        color: EditorTheme.default-text;
        font-size: EditorTheme.font-sm;
        vertical-alignment: center;
        single-line: true;
        accepted => { root.accepted(); }
        edited => { root.edited(); }
    }

    if root.text == "" && root.placeholder-text != "" && !input.has-focus: Text {
        x: 6px;
        width: parent.width - 12px;
        height: 100%;
        text: root.placeholder-text;
        color: EditorTheme.muted;
        font-size: EditorTheme.font-sm;
        vertical-alignment: center;
    }
}

export component EditorModalPanel inherits Rectangle {
    in property <length> panel-width: 420px;

    width: panel-width;
    background: EditorTheme.window;
    border-radius: EditorTheme.radius-modal;
    border-width: 1px;
    border-color: EditorTheme.hairline;
    drop-shadow-blur: 28px;
    drop-shadow-color: #00000088;

    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        @children
    }
}
