import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { EditorTheme, EditorButton, EditorToggle, EditorSlider, EditorCompactField, EditorFoldout, InspectorObjectCell, ObjectActiveCheckbox } from "editor_controls.slint";
import { AxisNumberField } from "axis_number_field.slint";
import { InspectorScalarRow } from "inspector_scalar_row.slint";
import { InspectorColorCell } from "inspector_color_cell.slint";
import {
    EditorGlyphs,
    EditorIconInstance,
    EditorIconUnlinked,
    EditorIconTreeArrowRight,
    EditorIconTreeArrowDown,
    EditorIconCamera3D,
    EditorIconLight,
    EditorIconSkeleton3D,
    EditorIconAnimationPlayer,
    EditorIconAnimationTree,
    EditorIconScript,
    EditorIconSkeletonModifier3D,
} from "editor_icons.slint";

export struct BehaviourPropRow {
    key: string,
    kind: string,
    bool-value: bool,
    number-value: float,
    string-value: string,
    missing-type: bool,
    clip-name-invalid: bool,
}

export struct BehaviourRow {
    behaviour-id: int,
    type-name: string,
    missing: bool,
    props: [BehaviourPropRow],
}

export struct SkeletonModifierRow {
    modifier-index: int,
    type-name: string,
    enabled: bool,
    missing: bool,
    bone-name: string,
    open-amount: float,
    attach-driven: bool,
    target-x: float,
    target-y: float,
    target-z: float,
    child-entity-name: string,
}

export struct AnimationClipRow {
    entry-index: int,
    clip-name: string,
    clip-guid: string,
    clip-display: string,
    clip-invalid: bool,
}

export struct AnimationClipPickerRow {
    display-name: string,
    guid: string,
    stem: string,
}

export component InspectorPanel inherits Rectangle {
    in property <bool> has-selection: false;
    in property <string> entity-name: "";
    in property <bool> object-active: true;
    in property <bool> object-active-mixed: false;
    callback object-active-toggled();
    in-out property <float> pos-x;
    in-out property <float> pos-y;
    in-out property <float> pos-z;
    in-out property <float> rot-x;
    in-out property <float> rot-y;
    in-out property <float> rot-z;
    in-out property <float> scale-x;
    in-out property <float> scale-y;
    in-out property <float> scale-z;
    in-out property <float> quat-x: 0.0;
    in-out property <float> quat-y: 0.0;
    in-out property <float> quat-z: 0.0;
    in-out property <float> quat-w: 1.0;

    in property <bool> pos-x-mixed: false;
    in property <bool> pos-y-mixed: false;
    in property <bool> pos-z-mixed: false;
    in property <bool> rot-x-mixed: false;
    in property <bool> rot-y-mixed: false;
    in property <bool> rot-z-mixed: false;
    in property <bool> scale-x-mixed: false;
    in property <bool> scale-y-mixed: false;
    in property <bool> scale-z-mixed: false;

    in-out property <bool> transform-expanded: true;
    in-out property <bool> rotation-edit-mode-euler: true;
    in-out property <bool> scale-link-enabled: true;
    in property <bool> multi-edit-visible: false;
    in-out property <bool> multi-edit-absolute: true;

    in property <bool> layout-drag-active: false;
    in property <bool> browser-drag-active: false;
    /// >=0 row highlight; -1 Add clip; -2 none (Content Browser clip drop).
    in property <int> clip-drop-highlight-index: -2;
    /// Written from clip-list-host / add-clip-host (inside scene inspector branch).
    in-out property <length> clip-list-origin-x: 0px;
    in-out property <length> clip-list-origin-y: 0px;
    in-out property <length> clip-list-width: 0px;
    in-out property <length> clip-row-pitch: 72px;
    in-out property <length> add-clip-origin-y: 0px;
    in-out property <length> add-clip-height: 24px;

    in property <bool> asset-mode: false;
    in property <string> asset-display-name: "";
    in property <string> asset-guid: "";
    in property <string> asset-type: "";
    in property <string> asset-intermediate-path: "";

    in property <image> mesh-preview-image;
    in property <bool> mesh-preview-has-image: false;
    callback mesh-preview-orbit(float, float);
    callback mesh-preview-zoom(float);
    callback mesh-preview-reset();
    callback transform-edited();
    callback field-text-committed(int, string);
    callback field-focus-changed(int, bool);
    callback rotation-mode-changed(bool);
    callback scale-link-toggled(bool);
    callback multi-edit-mode-changed(bool);
    callback inspector-activated();

    in property <bool> mesh-material-section-visible: false;
    in-out property <bool> mesh-material-unlit: false;
    in-out property <float> mesh-base-color-r: 1.0;
    in-out property <float> mesh-base-color-g: 1.0;
    in-out property <float> mesh-base-color-b: 1.0;
    in-out property <float> mesh-base-color-a: 1.0;
    in-out property <float> mesh-metallic: 0.0;
    in-out property <float> mesh-roughness: 1.0;
    in-out property <float> mesh-ambient-r: 0.0;
    in-out property <float> mesh-ambient-g: 0.0;
    in-out property <float> mesh-ambient-b: 0.0;
    in-out property <float> mesh-diffuse-r: 1.0;
    in-out property <float> mesh-diffuse-g: 1.0;
    in-out property <float> mesh-diffuse-b: 1.0;
    in-out property <float> mesh-specular-r: 0.4;
    in-out property <float> mesh-specular-g: 0.4;
    in-out property <float> mesh-specular-b: 0.4;
    in-out property <float> mesh-shininess: 32.0;
    in property <string> mesh-slot-base-color-name: "";
    in property <bool> mesh-slot-base-color-assigned: false;
    in property <string> mesh-slot-metallic-name: "";
    in property <bool> mesh-slot-metallic-assigned: false;
    in property <string> mesh-slot-normal-name: "";
    in property <bool> mesh-slot-normal-assigned: false;
    in property <string> mesh-slot-occlusion-name: "";
    in property <bool> mesh-slot-occlusion-assigned: false;
    callback mesh-material-unlit-toggled(bool);
    callback mesh-material-scalar-committed(int, float, float, float, float, bool);
    callback color-hex-entered(int, string);
    callback mesh-material-reset-requested();
    callback mesh-slot-pick-requested(int);
    callback mesh-slot-clear-requested(int);
    callback mesh-slot-drop-requested(int);

    in property <[BehaviourRow]> behaviours: [];
    in property <[string]> behaviour-type-choices: [];
    /// Co-located AnimationPlayer logical names + leading empty clear option.
    in property <[string]> behaviour-clip-name-choices: [];
    in-out property <int> behaviour-clip-name-picker-id: -1;
    in-out property <string> behaviour-clip-name-picker-key: "";
    in-out property <bool> behaviours-expanded: true;
    callback add-behaviour(string);
    callback remove-behaviour(int);
    callback reorder-behaviour(int, int);
    callback commit-behaviour-prop(int, string, string, float, bool, bool);

    in property <[SkeletonModifierRow]> skeleton-modifiers: [];
    in property <[string]> skeleton-modifier-type-choices: [];
    in-out property <bool> skeleton-modifiers-expanded: true;
    callback add-skeleton-modifier(string);
    callback remove-skeleton-modifier(int);
    callback reorder-skeleton-modifier(int, int);
    callback set-skeleton-modifier-enabled(int, bool);
    callback commit-skeleton-modifier-field(int, string, string, float, bool, bool);

    in property <bool> has-camera: false;
    in-out property <float> camera-fov: 45.0;
    in-out property <float> camera-near: 0.1;
    in-out property <float> camera-far: 1000.0;
    in-out property <bool> camera-is-main: false;
    in-out property <bool> camera-expanded: true;
    callback camera-edited(bool);

    in property <bool> has-light: false;
    in-out property <int> light-type: 0;
    in-out property <float> light-comp-color-r: 1.0;
    in-out property <float> light-comp-color-g: 1.0;
    in-out property <float> light-comp-color-b: 1.0;
    in-out property <float> light-intensity: 1.0;
    in-out property <bool> light-enabled: true;
    in-out property <int> light-contribution: 0;
    in-out property <float> light-range: 10.0;
    in-out property <float> light-inner-cone: 0.0;
    in-out property <float> light-outer-cone: 45.0;
    in-out property <float> light-width: 1.0;
    in-out property <float> light-height: 1.0;
    in-out property <string> light-linking-text: "";
    in-out property <bool> light-expanded: true;
    callback light-edited(bool);

    in property <bool> add-menu-enabled: false;
    in property <bool> has-skeleton: false;
    in property <bool> has-animation-tree: false;
    in property <bool> remove-skeleton-enabled: true;
    in-out property <bool> skeleton-expanded: true;
    in-out property <bool> animation-tree-expanded: true;
    callback add-unique-attachment(string);
    callback remove-unique-attachment(string);
    callback add-clip();
    callback remove-clip(int);

    in property <bool> has-animation-player: false;
    in property <[AnimationClipRow]> animation-clips: [];
    in-out property <bool> animation-player-expanded: true;
    callback commit-animation-clip(int, string, string);
    /// -1 = Add clip (append); >=0 = retarget that row.
    callback open-clip-picker(int);
    in property <[AnimationClipPickerRow]> clip-picker-choices: [];
    in-out property <bool> clip-picker-open: false;
    in property <int> clip-picker-target-index: -1;
    callback pick-clip-choice(string, string, string);

    in property <bool> anim-tree-canvas-open-enabled: false;
    callback open-anim-tree-canvas-requested();

    background: EditorTheme.window;
    border-color: EditorTheme.hairline;
    border-width: 1px;
    clip: true;

    VerticalLayout {
        padding: 10px;
        spacing: 8px;

        Flickable {
            vertical-stretch: 1;
            interactive: !root.layout-drag-active;
            viewport-width: parent.width - 20px;
            viewport-height: 2900px;

            VerticalBox {
                width: parent.width;
                spacing: 6px;
                padding-right: 4px;
                alignment: start;

                if root.asset-mode: VerticalBox {
                    spacing: 8px;

                    Text {
                        text: "Mesh Preview";
                        color: EditorTheme.default-text;
                        font-size: 13px;
                    }

                    Rectangle {
                        min-height: 200px;
                        background: EditorTheme.field;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;
                        border-radius: 3px;
                        clip: true;

                        if root.mesh-preview-has-image: Image {
                            width: 100%;
                            height: 100%;
                            source: root.mesh-preview-image;
                            image-fit: contain;
                        }
                        if !root.mesh-preview-has-image: Text {
                            text: "Loading preview…";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        preview-touch := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: default;
                            property <bool> orbiting: false;
                            property <length> orbit-anchor-x: 0px;
                            property <length> orbit-anchor-y: 0px;

                            moved => {
                                if (preview-touch.orbiting) {
                                    root.mesh-preview-orbit(
                                        (self.mouse-x - preview-touch.orbit-anchor-x) / 1px,
                                        (self.mouse-y - preview-touch.orbit-anchor-y) / 1px);
                                    preview-touch.orbit-anchor-x = self.mouse-x;
                                    preview-touch.orbit-anchor-y = self.mouse-y;
                                }
                            }
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left &&
                                    event.kind == PointerEventKind.down) {
                                    preview-touch.orbiting = true;
                                    preview-touch.orbit-anchor-x = self.mouse-x;
                                    preview-touch.orbit-anchor-y = self.mouse-y;
                                }
                                if (event.button == PointerEventButton.left &&
                                    event.kind == PointerEventKind.up) {
                                    preview-touch.orbiting = false;
                                }
                                if (event.kind == PointerEventKind.cancel) {
                                    preview-touch.orbiting = false;
                                }
                            }
                            double-clicked => { root.mesh-preview-reset(); }
                            scroll-event(event) => {
                                root.mesh-preview-zoom(event.delta-y / 1px);
                                accept
                            }
                        }
                    }

                    Text {
                        text: "Asset";
                        color: EditorTheme.default-text;
                        font-size: 13px;
                    }

                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Name";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            width: 72px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.asset-display-name;
                            color: EditorTheme.default-text;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "GUID";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            width: 72px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.asset-guid != "" ? root.asset-guid : "(unknown)";
                            color: EditorTheme.default-text;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Type";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            width: 72px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.asset-type;
                            color: EditorTheme.default-text;
                            font-size: 11px;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Intermediate";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            width: 72px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.asset-intermediate-path != ""
                                ? root.asset-intermediate-path
                                : "(unknown)";
                            color: EditorTheme.default-text;
                            font-size: 11px;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    Rectangle { background: EditorTheme.hairline; height: 1px; }

                    if root.mesh-material-section-visible: EditorFoldout {
                        title: "Material";
                        icon: EditorGlyphs.material;
                        expanded: true;
                        EditorButton {
                            text: "Reset overrides";
                            clicked => {
                                root.inspector-activated();
                                root.mesh-material-reset-requested();
                            }
                        }
                    }

                    if root.mesh-material-section-visible: VerticalBox {
                        spacing: 6px;
                        EditorToggle {
                            text: "Unlit";
                            checked: root.mesh-material-unlit;
                            toggled => {
                                root.inspector-activated();
                                root.mesh-material-unlit = self.checked;
                                root.mesh-material-unlit-toggled(self.checked);
                            }
                        }
                        InspectorColorCell {
                            label: "Base Color";
                            r <=> root.mesh-base-color-r;
                            g <=> root.mesh-base-color-g;
                            b <=> root.mesh-base-color-b;
                            a <=> root.mesh-base-color-a;
                            show-alpha: true;
                            enable-reset: false;
                            live-edited => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(0, root.mesh-base-color-r, root.mesh-base-color-g, root.mesh-base-color-b, root.mesh-base-color-a, false);
                            }
                            committed => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(0, root.mesh-base-color-r, root.mesh-base-color-g, root.mesh-base-color-b, root.mesh-base-color-a, true);
                            }
                            hex-entered(t) => { root.color-hex-entered(1, t); }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Metallic"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            AxisNumberField { axis-label: "m"; axis-color: #c0c0c0; value <=> root.mesh-metallic; live-edited => { root.inspector-activated(); } text-committed(t) => { root.inspector-activated(); root.mesh-material-scalar-committed(1, root.mesh-metallic, 0.0, 0.0, 0.0, true); } focus-changed(focused) => { if focused { root.inspector-activated(); } else { root.mesh-material-scalar-committed(1, root.mesh-metallic, 0.0, 0.0, 0.0, true); } } }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Roughness"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            AxisNumberField { axis-label: "r"; axis-color: #c0c0c0; value <=> root.mesh-roughness; live-edited => { root.inspector-activated(); } text-committed(t) => { root.inspector-activated(); root.mesh-material-scalar-committed(2, root.mesh-roughness, 0.0, 0.0, 0.0, true); } focus-changed(focused) => { if focused { root.inspector-activated(); } else { root.mesh-material-scalar-committed(2, root.mesh-roughness, 0.0, 0.0, 0.0, true); } } }
                        }
                        InspectorColorCell {
                            label: "Ambient";
                            r <=> root.mesh-ambient-r;
                            g <=> root.mesh-ambient-g;
                            b <=> root.mesh-ambient-b;
                            enable-reset: false;
                            live-edited => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(3, root.mesh-ambient-r, root.mesh-ambient-g, root.mesh-ambient-b, 0.0, false);
                            }
                            committed => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(3, root.mesh-ambient-r, root.mesh-ambient-g, root.mesh-ambient-b, 0.0, true);
                            }
                            hex-entered(t) => { root.color-hex-entered(2, t); }
                        }
                        InspectorColorCell {
                            label: "Diffuse";
                            r <=> root.mesh-diffuse-r;
                            g <=> root.mesh-diffuse-g;
                            b <=> root.mesh-diffuse-b;
                            enable-reset: false;
                            live-edited => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(4, root.mesh-diffuse-r, root.mesh-diffuse-g, root.mesh-diffuse-b, 0.0, false);
                            }
                            committed => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(4, root.mesh-diffuse-r, root.mesh-diffuse-g, root.mesh-diffuse-b, 0.0, true);
                            }
                            hex-entered(t) => { root.color-hex-entered(3, t); }
                        }
                        InspectorColorCell {
                            label: "Specular";
                            r <=> root.mesh-specular-r;
                            g <=> root.mesh-specular-g;
                            b <=> root.mesh-specular-b;
                            enable-reset: false;
                            live-edited => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(5, root.mesh-specular-r, root.mesh-specular-g, root.mesh-specular-b, 0.0, false);
                            }
                            committed => {
                                root.inspector-activated();
                                root.mesh-material-scalar-committed(5, root.mesh-specular-r, root.mesh-specular-g, root.mesh-specular-b, 0.0, true);
                            }
                            hex-entered(t) => { root.color-hex-entered(4, t); }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Shininess"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            AxisNumberField { axis-label: "s"; axis-color: #c0c0c0; value <=> root.mesh-shininess; live-edited => { root.inspector-activated(); } text-committed(t) => { root.inspector-activated(); root.mesh-material-scalar-committed(6, root.mesh-shininess, 0.0, 0.0, 0.0, true); } focus-changed(focused) => { if focused { root.inspector-activated(); } else { root.mesh-material-scalar-committed(6, root.mesh-shininess, 0.0, 0.0, 0.0, true); } } }
                        }
                        InspectorObjectCell {
                            label: "Base Color";
                            display-name: root.mesh-slot-base-color-name;
                            assigned: root.mesh-slot-base-color-assigned;
                            drop-target: root.browser-drag-active;
                            pick-requested => { root.inspector-activated(); root.mesh-slot-pick-requested(0); }
                            clear-requested => { root.inspector-activated(); root.mesh-slot-clear-requested(0); }
                            drop-requested => { root.inspector-activated(); root.mesh-slot-drop-requested(0); }
                        }
                        InspectorObjectCell {
                            label: "Metallic-Roughness";
                            display-name: root.mesh-slot-metallic-name;
                            assigned: root.mesh-slot-metallic-assigned;
                            drop-target: root.browser-drag-active;
                            pick-requested => { root.inspector-activated(); root.mesh-slot-pick-requested(1); }
                            clear-requested => { root.inspector-activated(); root.mesh-slot-clear-requested(1); }
                            drop-requested => { root.inspector-activated(); root.mesh-slot-drop-requested(1); }
                        }
                        InspectorObjectCell {
                            label: "Normal";
                            display-name: root.mesh-slot-normal-name;
                            assigned: root.mesh-slot-normal-assigned;
                            drop-target: root.browser-drag-active;
                            pick-requested => { root.inspector-activated(); root.mesh-slot-pick-requested(2); }
                            clear-requested => { root.inspector-activated(); root.mesh-slot-clear-requested(2); }
                            drop-requested => { root.inspector-activated(); root.mesh-slot-drop-requested(2); }
                        }
                        InspectorObjectCell {
                            label: "Occlusion";
                            display-name: root.mesh-slot-occlusion-name;
                            assigned: root.mesh-slot-occlusion-assigned;
                            drop-target: root.browser-drag-active;
                            pick-requested => { root.inspector-activated(); root.mesh-slot-pick-requested(3); }
                            clear-requested => { root.inspector-activated(); root.mesh-slot-clear-requested(3); }
                            drop-requested => { root.inspector-activated(); root.mesh-slot-drop-requested(3); }
                        }
                    }
                }

                if !root.asset-mode: VerticalBox {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 0;

                EditorFoldout {
                    title: "Transform";
                    icon: EditorGlyphs.tool-move;
                    expanded <=> root.transform-expanded;
                }

                if root.transform-expanded: VerticalBox {
                    spacing: 6px;
                    alignment: start;
                    vertical-stretch: 0;

                    HorizontalBox {
                        spacing: 6px;
                        alignment: start;

                        if root.has-selection && !root.asset-mode: ObjectActiveCheckbox {
                            checked: root.object-active;
                            mixed: root.object-active-mixed;
                            clicked => { root.object-active-toggled(); }
                        }

                        Text {
                            text: root.has-selection ? root.entity-name : "No selection";
                            color: EditorTheme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }

                    if root.multi-edit-visible: HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Multi-edit";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        EditorButton {
                            text: "Absolute";
                            checked: root.multi-edit-absolute;
                            clicked => {
                                root.multi-edit-absolute = true;
                                root.multi-edit-mode-changed(true);
                            }
                        }
                        EditorButton {
                            text: "Delta";
                            checked: !root.multi-edit-absolute;
                            clicked => {
                                root.multi-edit-absolute = false;
                                root.multi-edit-mode-changed(false);
                            }
                        }
                    }

                    Text { text: "Position"; color: EditorTheme.muted; font-size: 12px; }
                    HorizontalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        AxisNumberField {
                            axis-label: "x"; axis-color: #ff3352; unit: "m";
                            value <=> root.pos-x; mixed: root.pos-x-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(0, t); }
                            focus-changed(f) => { root.field-focus-changed(0, f); }
                        }
                        AxisNumberField {
                            axis-label: "y"; axis-color: #8bdc00; unit: "m";
                            value <=> root.pos-y; mixed: root.pos-y-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(1, t); }
                            focus-changed(f) => { root.field-focus-changed(1, f); }
                        }
                        AxisNumberField {
                            axis-label: "z"; axis-color: #2890ff; unit: "m";
                            value <=> root.pos-z; mixed: root.pos-z-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(2, t); }
                            focus-changed(f) => { root.field-focus-changed(2, f); }
                        }
                    }

                    Text { text: "Rotation"; color: EditorTheme.muted; font-size: 12px; }
                    if root.rotation-edit-mode-euler || root.multi-edit-visible: HorizontalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        AxisNumberField {
                            axis-label: "x"; axis-color: #ff3352; unit: "°";
                            show-slider: !root.multi-edit-visible;
                            value <=> root.rot-x; mixed: root.rot-x-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(3, t); }
                            focus-changed(f) => { root.field-focus-changed(3, f); }
                        }
                        AxisNumberField {
                            axis-label: "y"; axis-color: #8bdc00; unit: "°";
                            show-slider: !root.multi-edit-visible;
                            value <=> root.rot-y; mixed: root.rot-y-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(4, t); }
                            focus-changed(f) => { root.field-focus-changed(4, f); }
                        }
                        AxisNumberField {
                            axis-label: "z"; axis-color: #2890ff; unit: "°";
                            show-slider: !root.multi-edit-visible;
                            value <=> root.rot-z; mixed: root.rot-z-mixed;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(5, t); }
                            focus-changed(f) => { root.field-focus-changed(5, f); }
                        }
                    }
                    if !root.rotation-edit-mode-euler && !root.multi-edit-visible: VerticalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        HorizontalBox {
                            spacing: 4px;
                            vertical-stretch: 0;
                            AxisNumberField {
                                axis-label: "x"; axis-color: #ff3352;
                                value <=> root.quat-x;
                                live-edited => { root.transform-edited(); }
                                text-committed(t) => { root.field-text-committed(9, t); }
                                focus-changed(f) => { root.field-focus-changed(9, f); }
                            }
                            AxisNumberField {
                                axis-label: "y"; axis-color: #8bdc00;
                                value <=> root.quat-y;
                                live-edited => { root.transform-edited(); }
                                text-committed(t) => { root.field-text-committed(10, t); }
                                focus-changed(f) => { root.field-focus-changed(10, f); }
                            }
                        }
                        HorizontalBox {
                            spacing: 4px;
                            vertical-stretch: 0;
                            AxisNumberField {
                                axis-label: "z"; axis-color: #2890ff;
                                value <=> root.quat-z;
                                live-edited => { root.transform-edited(); }
                                text-committed(t) => { root.field-text-committed(11, t); }
                                focus-changed(f) => { root.field-focus-changed(11, f); }
                            }
                            AxisNumberField {
                                axis-label: "w"; axis-color: #c0c0c0;
                                value <=> root.quat-w;
                                live-edited => { root.transform-edited(); }
                                text-committed(t) => { root.field-text-committed(12, t); }
                                focus-changed(f) => { root.field-focus-changed(12, f); }
                            }
                        }
                    }

                    HorizontalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        Text {
                            text: "Scale";
                            color: EditorTheme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.scale-link-enabled = !root.scale-link-enabled;
                                root.scale-link-toggled(root.scale-link-enabled);
                            }
                            Rectangle {
                                width: 28px;
                                height: 22px;
                                background: root.scale-link-enabled ? EditorTheme.accent-soft : EditorTheme.button;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: EditorTheme.hairline;
                                if root.scale-link-enabled: EditorIconInstance {
                                    icon-size: 14px;
                                    icon-color: EditorTheme.icon;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                if !root.scale-link-enabled: EditorIconUnlinked {
                                    icon-size: 14px;
                                    icon-color: EditorTheme.muted;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                    HorizontalBox {
                        spacing: 4px;
                        vertical-stretch: 0;
                        AxisNumberField {
                            axis-label: "x"; axis-color: #ff3352;
                            value <=> root.scale-x; mixed: root.scale-x-mixed;
                            scrub-sensitivity: 0.01;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(6, t); }
                            focus-changed(f) => { root.field-focus-changed(6, f); }
                        }
                        AxisNumberField {
                            axis-label: "y"; axis-color: #8bdc00;
                            value <=> root.scale-y; mixed: root.scale-y-mixed;
                            scrub-sensitivity: 0.01;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(7, t); }
                            focus-changed(f) => { root.field-focus-changed(7, f); }
                        }
                        AxisNumberField {
                            axis-label: "z"; axis-color: #2890ff;
                            value <=> root.scale-z; mixed: root.scale-z-mixed;
                            scrub-sensitivity: 0.01;
                            live-edited => { root.transform-edited(); }
                            text-committed(t) => { root.field-text-committed(8, t); }
                            focus-changed(f) => { root.field-focus-changed(8, f); }
                        }
                    }

                    if !root.multi-edit-visible: HorizontalBox {
                        spacing: 6px;
                        Text {
                            text: "Rotation Edit Mode";
                            color: EditorTheme.muted;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            background: EditorTheme.hairline;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: EditorTheme.hairline;
                            height: 22px;
                            width: 110px;
                            horizontal-stretch: 0;

                            TouchArea {
                                mouse-cursor: pointer;
                                width: 100%;
                                height: 100%;
                                clicked => { rotation-mode-popup.show(); }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 6px;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: root.rotation-edit-mode-euler ? "Euler" : "Quaternion";
                                        color: EditorTheme.default-text;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    EditorIconTreeArrowDown {
                                        icon-color: EditorTheme.muted;
                                        icon-size: 10px;
                                    }
                                }
                            }

                            rotation-mode-popup := PopupWindow {
                                x: 0;
                                y: parent.height + 2px;
                                width: parent.width;
                                close-policy: close-on-click-outside;

                                Rectangle {
                                    background: EditorTheme.field;
                                    border-color: EditorTheme.hairline;
                                    border-width: 1px;
                                    border-radius: 3px;

                                    VerticalLayout {
                                        padding: 2px;
                                        spacing: 0px;

                                        for mode[index] in ["Euler", "Quaternion"]: Rectangle {
                                            height: 22px;
                                            background: opt-touch.has-hover ? EditorTheme.button-hover : transparent;
                                            border-radius: 2px;

                                            opt-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.rotation-edit-mode-euler = index == 0;
                                                    root.rotation-mode-changed(index == 0);
                                                    rotation-mode-popup.close();
                                                }

                                                Text {
                                                    x: 8px;
                                                    width: parent.width - 16px;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    text: mode;
                                                    color: ((index == 0) == root.rotation-edit-mode-euler) ? EditorTheme.accent-sel-text : EditorTheme.default-text;
                                                    font-size: 11px;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { background: EditorTheme.hairline; height: 1px; }

                Rectangle {
                    background: EditorTheme.button;
                    border-radius: EditorTheme.radius-ctl;
                    border-width: 1px;
                    border-color: EditorTheme.hairline;
                    height: EditorTheme.line;

                    TouchArea {
                        mouse-cursor: root.add-menu-enabled ? pointer : default;
                        width: 100%;
                        height: 100%;
                        clicked => {
                            if root.add-menu-enabled {
                                add-menu-popup.show();
                            }
                        }
                        Text {
                            text: "Add…";
                            color: root.add-menu-enabled ? EditorTheme.accent-sel-text : EditorTheme.muted;
                            font-size: EditorTheme.font;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    add-menu-popup := PopupWindow {
                        x: 0;
                        y: parent.height + 2px;
                        width: parent.width;
                        close-policy: close-on-click-outside;

                        Rectangle {
                            width: 100%;
                            background: EditorTheme.window;
                            border-color: EditorTheme.hairline;
                            border-width: 1px;
                            border-radius: EditorTheme.radius-ctl;
                            max-height: 280px;
                            clip: true;

                            Flickable {
                                width: 100%;
                                viewport-width: self.width;
                                viewport-height: 280px;
                                VerticalLayout {
                                    width: 100%;
                                    padding: 4px;
                                    spacing: 0px;

                                    Text {
                                        text: "Unique attachments";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }
                                    unique-camera-row := Rectangle {
                                        height: 22px;
                                        background: unique-camera-touch.has-hover && !root.has-camera ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconCamera3D {
                                                icon-size: 14px;
                                                icon-color: root.has-camera ? EditorTheme.muted : EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: "Camera";
                                                color: root.has-camera ? EditorTheme.muted : EditorTheme.default-text;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                        unique-camera-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: root.has-camera ? default : pointer;
                                            clicked => {
                                                if !root.has-camera {
                                                    root.add-unique-attachment("Camera");
                                                    add-menu-popup.close();
                                                }
                                            }
                                        }
                                    }
                                    unique-light-row := Rectangle {
                                        height: 22px;
                                        background: unique-light-touch.has-hover && !root.has-light ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconLight {
                                                icon-size: 14px;
                                                icon-color: root.has-light ? EditorTheme.muted : EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: "Light";
                                                color: root.has-light ? EditorTheme.muted : EditorTheme.default-text;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                        unique-light-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: root.has-light ? default : pointer;
                                            clicked => {
                                                if !root.has-light {
                                                    root.add-unique-attachment("Light");
                                                    add-menu-popup.close();
                                                }
                                            }
                                        }
                                    }
                                    unique-skeleton-row := Rectangle {
                                        height: 22px;
                                        background: unique-skeleton-touch.has-hover && !root.has-skeleton ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconSkeleton3D {
                                                icon-size: 14px;
                                                icon-color: root.has-skeleton ? EditorTheme.muted : EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: "Skeleton";
                                                color: root.has-skeleton ? EditorTheme.muted : EditorTheme.default-text;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                        unique-skeleton-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: root.has-skeleton ? default : pointer;
                                            clicked => {
                                                if !root.has-skeleton {
                                                    root.add-unique-attachment("Skeleton");
                                                    add-menu-popup.close();
                                                }
                                            }
                                        }
                                    }
                                    unique-player-row := Rectangle {
                                        height: 22px;
                                        background: unique-player-touch.has-hover && !root.has-animation-player ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconAnimationPlayer {
                                                icon-size: 14px;
                                                icon-color: root.has-animation-player ? EditorTheme.muted : EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: "AnimationPlayer";
                                                color: root.has-animation-player ? EditorTheme.muted : EditorTheme.default-text;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                        unique-player-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: root.has-animation-player ? default : pointer;
                                            clicked => {
                                                if !root.has-animation-player {
                                                    root.add-unique-attachment("AnimationPlayer");
                                                    add-menu-popup.close();
                                                }
                                            }
                                        }
                                    }
                                    unique-tree-row := Rectangle {
                                        height: 22px;
                                        background: unique-tree-touch.has-hover && !root.has-animation-tree ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconAnimationTree {
                                                icon-size: 14px;
                                                icon-color: root.has-animation-tree ? EditorTheme.muted : EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: "AnimationTree";
                                                color: root.has-animation-tree ? EditorTheme.muted : EditorTheme.default-text;
                                                font-size: 11px;
                                                horizontal-stretch: 1;
                                                overflow: elide;
                                            }
                                        }
                                        unique-tree-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: root.has-animation-tree ? default : pointer;
                                            clicked => {
                                                if !root.has-animation-tree {
                                                    root.add-unique-attachment("AnimationTree");
                                                    add-menu-popup.close();
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Behaviours";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }
                                    if root.behaviour-type-choices.length == 0: Text {
                                        text: "build Scripts first";
                                        color: EditorTheme.muted;
                                        font-size: 11px;
                                        height: 22px;
                                        vertical-alignment: center;
                                    }
                                    for choice in root.behaviour-type-choices: Rectangle {
                                        height: 22px;
                                        background: behaviour-choice-touch.has-hover ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconScript {
                                                icon-size: 14px;
                                                icon-color: EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: choice;
                                                color: EditorTheme.default-text;
                                                font-size: 11px;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        behaviour-choice-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.add-behaviour(choice);
                                                add-menu-popup.close();
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Skeleton Modifiers";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }
                                    for choice in root.skeleton-modifier-type-choices: Rectangle {
                                        height: 22px;
                                        background: modifier-choice-touch.has-hover ? EditorTheme.button-hover : transparent;
                                        border-radius: 2px;
                                        HorizontalLayout {
                                            width: 100%;
                                            height: 100%;
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            EditorIconSkeletonModifier3D {
                                                icon-size: 14px;
                                                icon-color: EditorTheme.default-text;
                                                y: (parent.height - self.height) / 2;
                                            }
                                            Text {
                                                vertical-alignment: center;
                                                text: choice;
                                                color: EditorTheme.default-text;
                                                font-size: 11px;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        modifier-choice-touch := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.add-skeleton-modifier(choice);
                                                add-menu-popup.close();
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.behaviours.length > 0: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.behaviours.length > 0: EditorFoldout {
                    title: "Behaviours";
                    icon: EditorGlyphs.script;
                    expanded <=> root.behaviours-expanded;
                }

                if root.behaviours.length > 0 && root.behaviours-expanded: VerticalBox {
                    spacing: 6px;

                    if !root.has-selection: Text {
                        text: "Select an entity";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }

                    for behaviour[i] in root.behaviours: Rectangle {
                        background: EditorTheme.field;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: behaviour.missing ? #6a3a3a : EditorTheme.hairline;

                        VerticalBox {
                            width: 100%;
                            padding: 6px;
                            spacing: 4px;

                        HorizontalBox {
                            spacing: 4px;
                            EditorIconScript {
                                icon-size: 14px;
                                icon-color: behaviour.missing ? #ff9a9a : EditorTheme.default-text;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: behaviour.type-name + (behaviour.missing ? " (missing)" : "");
                                color: behaviour.missing ? #ff9a9a : EditorTheme.default-text;
                                font-size: 12px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if i > 0: up-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.reorder-behaviour(i, i - 1); }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    background: up-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                                    border-radius: 3px;
                                    Image {
                                        x: (parent.width - 10px) / 2;
                                        y: (parent.height - 10px) / 2;
                                        width: 10px;
                                        height: 10px;
                                        source: EditorGlyphs.move-up;
                                        colorize: EditorTheme.muted;
                                        image-fit: contain;
                                    }
                                }
                            }
                            if i < root.behaviours.length - 1: down-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.reorder-behaviour(i, i + 1); }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    background: down-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                                    border-radius: 3px;
                                    Image {
                                        x: (parent.width - 10px) / 2;
                                        y: (parent.height - 10px) / 2;
                                        width: 10px;
                                        height: 10px;
                                        source: EditorGlyphs.move-down;
                                        colorize: EditorTheme.muted;
                                        image-fit: contain;
                                    }
                                }
                            }
                            remove-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.remove-behaviour(behaviour.behaviour-id); }
                                Rectangle {
                                    width: 22px;
                                    height: 22px;
                                    background: remove-touch.has-hover ? #5a2a2a : #3a2a2a;
                                    border-radius: 3px;
                                    Image {
                                        x: (parent.width - 10px) / 2;
                                        y: (parent.height - 10px) / 2;
                                        width: 10px;
                                        height: 10px;
                                        source: EditorGlyphs.close;
                                        colorize: #ffaaaa;
                                        image-fit: contain;
                                    }
                                }
                            }
                        }

                        if behaviour.missing: Text {
                            text: "Type not in catalog — remove or rebuild Scripts";
                            color: #a07070;
                            font-size: 10px;
                        }

                        for prop[j] in behaviour.props: VerticalBox {
                            spacing: 2px;
                            if prop.kind == "bool": HorizontalBox {
                                spacing: 6px;
                                EditorToggle {
                                    text: prop.key;
                                    checked: prop.bool-value;
                                    toggled => {
                                        root.commit-behaviour-prop(
                                            behaviour.behaviour-id, prop.key, "", 0.0, self.checked, true);
                                    }
                                }
                            }
                            if prop.kind == "number": InspectorScalarRow {
                                label: prop.key;
                                value: prop.number-value;
                                reset-value: 0.0;
                                live-edited => {
                                    root.commit-behaviour-prop(
                                        behaviour.behaviour-id, prop.key, "", self.value, false, false);
                                }
                                committed => {
                                    root.commit-behaviour-prop(
                                        behaviour.behaviour-id, prop.key, "", self.value, false, true);
                                }
                            }
                            if prop.kind == "string": HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: prop.key;
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    width: 96px;
                                    vertical-alignment: center;
                                }
                                str-input := EditorCompactField {
                                    horizontal-stretch: 1;
                                    text: prop.string-value;
                                    accepted => {
                                        root.commit-behaviour-prop(
                                            behaviour.behaviour-id, prop.key, self.text, 0.0, false, true);
                                    }
                                    changed has-focus => {
                                        if (!self.has-focus) {
                                            root.commit-behaviour-prop(
                                                behaviour.behaviour-id, prop.key, self.text, 0.0, false, true);
                                        }
                                    }
                                }
                            }
                            if prop.kind == "clip_name": VerticalBox {
                                spacing: 4px;
                                HorizontalBox {
                                    spacing: 6px;
                                    Text {
                                        text: prop.key;
                                        color: EditorTheme.muted;
                                        font-size: 11px;
                                        width: 96px;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: prop.string-value == "" ? "(empty)" : prop.string-value;
                                        color: prop.clip-name-invalid ? #ff8080 : #e0e0e0;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    clip-name-pick-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            if (root.behaviour-clip-name-picker-id == behaviour.behaviour-id
                                                && root.behaviour-clip-name-picker-key == prop.key) {
                                                root.behaviour-clip-name-picker-id = -1;
                                                root.behaviour-clip-name-picker-key = "";
                                            } else {
                                                root.behaviour-clip-name-picker-id = behaviour.behaviour-id;
                                                root.behaviour-clip-name-picker-key = prop.key;
                                            }
                                        }
                                        Rectangle {
                                            width: 44px;
                                            height: 20px;
                                            background: clip-name-pick-touch.has-hover ? #3a4a5a : #2a3a4a;
                                            border-radius: 3px;
                                            Text {
                                                text: "Pick";
                                                color: EditorTheme.accent-sel-text;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                if root.behaviour-clip-name-picker-id == behaviour.behaviour-id
                                    && root.behaviour-clip-name-picker-key == prop.key: VerticalBox {
                                    spacing: 2px;
                                    for choice[ci] in root.behaviour-clip-name-choices: TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.commit-behaviour-prop(
                                                behaviour.behaviour-id, prop.key, choice, 0.0, false, true);
                                            root.behaviour-clip-name-picker-id = -1;
                                            root.behaviour-clip-name-picker-key = "";
                                        }
                                        Rectangle {
                                            height: 20px;
                                            background: #333333;
                                            border-radius: 3px;
                                            Text {
                                                text: choice == "" ? "(empty)" : choice;
                                                color: #e0e0e0;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                horizontal-alignment: left;
                                                padding-left: 6px;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        }
                    }
                }

                if root.skeleton-modifiers.length > 0: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.skeleton-modifiers.length > 0: EditorFoldout {
                    title: "Skeleton Modifiers";
                    icon: EditorGlyphs.skeleton-modifier;
                    expanded <=> root.skeleton-modifiers-expanded;
                }

                if root.skeleton-modifiers.length > 0 && root.skeleton-modifiers-expanded: VerticalBox {
                    spacing: 6px;

                    if !root.has-selection: Text {
                        text: "Select an entity";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }

                    for modifier[i] in root.skeleton-modifiers: Rectangle {
                        background: EditorTheme.field;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: modifier.missing ? #6a3a3a : EditorTheme.hairline;

                        VerticalBox {
                            width: 100%;
                            padding: 6px;
                            spacing: 4px;

                            HorizontalBox {
                                spacing: 4px;
                                EditorIconSkeletonModifier3D {
                                    icon-size: 14px;
                                    icon-color: modifier.missing ? #ff9a9a : EditorTheme.default-text;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: modifier.type-name + (modifier.missing ? " (missing)" : "");
                                    color: modifier.missing ? #ff9a9a : EditorTheme.default-text;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if i > 0: skel-up-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.reorder-skeleton-modifier(i, i - 1); }
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        background: skel-up-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                                        border-radius: 3px;
                                        Image {
                                            x: (parent.width - 10px) / 2;
                                            y: (parent.height - 10px) / 2;
                                            width: 10px;
                                            height: 10px;
                                            source: EditorGlyphs.move-up;
                                            colorize: EditorTheme.muted;
                                            image-fit: contain;
                                        }
                                    }
                                }
                                if i < root.skeleton-modifiers.length - 1: skel-down-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.reorder-skeleton-modifier(i, i + 1); }
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        background: skel-down-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                                        border-radius: 3px;
                                        Image {
                                            x: (parent.width - 10px) / 2;
                                            y: (parent.height - 10px) / 2;
                                            width: 10px;
                                            height: 10px;
                                            source: EditorGlyphs.move-down;
                                            colorize: EditorTheme.muted;
                                            image-fit: contain;
                                        }
                                    }
                                }
                                skel-remove-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.remove-skeleton-modifier(modifier.modifier-index); }
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        background: skel-remove-touch.has-hover ? #5a2a2a : #3a2a2a;
                                        border-radius: 3px;
                                        Image {
                                            x: (parent.width - 10px) / 2;
                                            y: (parent.height - 10px) / 2;
                                            width: 10px;
                                            height: 10px;
                                            source: EditorGlyphs.close;
                                            colorize: #ffaaaa;
                                            image-fit: contain;
                                        }
                                    }
                                }
                            }

                            if modifier.missing: Text {
                                text: "Type not in catalog — remove or keep for Save";
                                color: #a07070;
                                font-size: 10px;
                            }

                            if !modifier.missing: EditorToggle {
                                text: "Enabled";
                                checked: modifier.enabled;
                                toggled => {
                                    root.set-skeleton-modifier-enabled(
                                        modifier.modifier-index, self.checked);
                                }
                            }

                            if !modifier.missing: HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: "Bone";
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    width: 96px;
                                    vertical-alignment: center;
                                }
                                bone-input := EditorCompactField {
                                    horizontal-stretch: 1;
                                    text: modifier.bone-name;
                                    accepted => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "bone_name", self.text, 0.0, false, true);
                                    }
                                    changed has-focus => {
                                        if (!self.has-focus) {
                                            root.commit-skeleton-modifier-field(
                                                modifier.modifier-index, "bone_name", self.text, 0.0, false, true);
                                        }
                                    }
                                }
                            }

                            if !modifier.missing && modifier.type-name == "PaperMouth": VerticalBox {
                                spacing: 4px;
                                InspectorScalarRow {
                                    label: "Open Amount";
                                    value: modifier.open-amount;
                                    reset-value: 0.0;
                                    live-edited => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "open_amount", "", self.value, false, false);
                                    }
                                    committed => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "open_amount", "", self.value, false, true);
                                    }
                                }
                                EditorToggle {
                                    text: "Attach Driven";
                                    checked: modifier.attach-driven;
                                    toggled => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "attach_driven", "", 0.0, self.checked, true);
                                    }
                                }
                            }

                            if !modifier.missing && modifier.type-name == "SkeletonAttachModifier": HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: "Child Entity";
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    width: 96px;
                                    vertical-alignment: center;
                                }
                                child-input := EditorCompactField {
                                    horizontal-stretch: 1;
                                    text: modifier.child-entity-name;
                                    accepted => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "child_entity_name", self.text, 0.0, false, true);
                                    }
                                    changed has-focus => {
                                        if (!self.has-focus) {
                                            root.commit-skeleton-modifier-field(
                                                modifier.modifier-index, "child_entity_name", self.text, 0.0, false, true);
                                        }
                                    }
                                }
                            }

                            if !modifier.missing && modifier.type-name == "SkeletonLookAtModifier": VerticalBox {
                                spacing: 4px;
                                InspectorScalarRow {
                                    label: "Target X";
                                    value: modifier.target-x;
                                    reset-value: 0.0;
                                    live-edited => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_x", "", self.value, false, false);
                                    }
                                    committed => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_x", "", self.value, false, true);
                                    }
                                }
                                InspectorScalarRow {
                                    label: "Target Y";
                                    value: modifier.target-y;
                                    reset-value: 0.0;
                                    live-edited => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_y", "", self.value, false, false);
                                    }
                                    committed => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_y", "", self.value, false, true);
                                    }
                                }
                                InspectorScalarRow {
                                    label: "Target Z";
                                    value: modifier.target-z;
                                    reset-value: 1.0;
                                    live-edited => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_z", "", self.value, false, false);
                                    }
                                    committed => {
                                        root.commit-skeleton-modifier-field(
                                            modifier.modifier-index, "target_z", "", self.value, false, true);
                                    }
                                }
                            }
                        }
                    }
                }

                if root.has-camera: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.has-camera: EditorFoldout {
                    title: "Camera";
                    icon: EditorGlyphs.camera;
                    expanded <=> root.camera-expanded;
                    EditorButton {
                        text: "Remove";
                        clicked => { root.remove-unique-attachment("Camera"); }
                    }
                }

                if root.has-camera && root.camera-expanded: VerticalBox {
                    spacing: 6px;

                    if !root.has-selection || root.multi-edit-visible: Text {
                        text: root.has-selection ? "Select one entity" : "Select an entity";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }

                    if root.has-selection && !root.multi-edit-visible && root.has-camera: VerticalBox {
                        spacing: 6px;

                        InspectorScalarRow {
                            label: "FOV";
                            value <=> root.camera-fov;
                            reset-value: 45.0;
                            live-edited => { root.camera-edited(false); }
                            committed => { root.camera-edited(true); }
                        }

                        InspectorScalarRow {
                            label: "Near";
                            value <=> root.camera-near;
                            reset-value: 0.1;
                            live-edited => { root.camera-edited(false); }
                            committed => { root.camera-edited(true); }
                        }

                        InspectorScalarRow {
                            label: "Far";
                            value <=> root.camera-far;
                            reset-value: 1000.0;
                            live-edited => { root.camera-edited(false); }
                            committed => { root.camera-edited(true); }
                        }

                        EditorToggle {
                            text: "Main";
                            checked: root.camera-is-main;
                            toggled => {
                                root.camera-is-main = self.checked;
                                root.camera-edited(true);
                            }
                        }
                    }
                }

                if root.has-light: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.has-light: EditorFoldout {
                    title: "Light";
                    icon: EditorGlyphs.light;
                    expanded <=> root.light-expanded;
                    EditorButton {
                        text: "Remove";
                        clicked => { root.remove-unique-attachment("Light"); }
                    }
                }

                if root.has-light && root.light-expanded: VerticalBox {
                    spacing: 6px;
                    if root.has-selection && !root.multi-edit-visible && root.has-light: VerticalBox {
                        spacing: 6px;
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Type"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.light-type = root.light-type >= 3 ? 0 : root.light-type + 1;
                                    root.light-edited(true);
                                }
                                Text {
                                    text: root.light-type == 0 ? "Directional" : (root.light-type == 1 ? "Point" : (root.light-type == 2 ? "Spot" : "Area"));
                                    color: EditorTheme.default-text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        light-color-cell := InspectorColorCell {
                            label: "Color";
                            r <=> root.light-comp-color-r;
                            g <=> root.light-comp-color-g;
                            b <=> root.light-comp-color-b;
                            enable-reset: true;
                            reset-r: 1.0;
                            reset-g: 1.0;
                            reset-b: 1.0;
                            live-edited => {
                                root.light-comp-color-r = light-color-cell.r;
                                root.light-comp-color-g = light-color-cell.g;
                                root.light-comp-color-b = light-color-cell.b;
                                root.light-edited(false);
                            }
                            committed => { root.light-edited(true); }
                            hex-entered(t) => { root.color-hex-entered(0, t); }
                        }
                        InspectorScalarRow {
                            label: "Intensity";
                            value <=> root.light-intensity;
                            reset-value: 1.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        EditorToggle {
                            text: "Enabled";
                            checked: root.light-enabled;
                            toggled => { root.light-enabled = self.checked; root.light-edited(true); }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Contribution"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.light-contribution = root.light-contribution >= 2 ? 0 : root.light-contribution + 1;
                                    root.light-edited(true);
                                }
                                Text {
                                    text: root.light-contribution == 0 ? "Illuminate and shadows" : (root.light-contribution == 1 ? "Illuminate only" : "Shadows only");
                                    color: EditorTheme.default-text;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if root.light-type == 1 || root.light-type == 2: InspectorScalarRow {
                            label: "Range";
                            value <=> root.light-range;
                            reset-value: 10.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        if root.light-type == 2: InspectorScalarRow {
                            label: "Inner";
                            value <=> root.light-inner-cone;
                            reset-value: 0.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        if root.light-type == 2: InspectorScalarRow {
                            label: "Outer";
                            value <=> root.light-outer-cone;
                            reset-value: 45.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        if root.light-type == 3: InspectorScalarRow {
                            label: "Width";
                            value <=> root.light-width;
                            reset-value: 1.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        if root.light-type == 3: InspectorScalarRow {
                            label: "Height";
                            value <=> root.light-height;
                            reset-value: 1.0;
                            live-edited => { root.light-edited(false); }
                            committed => { root.light-edited(true); }
                        }
                        HorizontalBox {
                            spacing: 6px;
                            Text { text: "Linking"; color: EditorTheme.muted; font-size: 11px; width: 96px; vertical-alignment: center; }
                            linking-input := EditorCompactField {
                                horizontal-stretch: 1;
                                text: root.light-linking-text;
                                placeholder-text: "empty = all meshes";
                                accepted => { root.light-linking-text = self.text; root.light-edited(true); }
                                changed has-focus => {
                                    if (!self.has-focus) { root.light-linking-text = self.text; root.light-edited(true); }
                                }
                            }
                        }
                    }
                }

                if root.has-skeleton: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.has-skeleton: EditorFoldout {
                    title: "Skeleton";
                    icon: EditorGlyphs.skeleton;
                    expanded <=> root.skeleton-expanded;
                    EditorButton {
                        text: "Remove";
                        enabled: root.remove-skeleton-enabled;
                        clicked => { root.remove-unique-attachment("Skeleton"); }
                    }
                }

                if root.has-skeleton && root.skeleton-expanded: VerticalBox {
                    spacing: 6px;
                    if !root.has-selection || root.multi-edit-visible: Text {
                        text: root.has-selection ? "Select one entity" : "Select an entity";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }
                    if root.has-selection && !root.multi-edit-visible: Text {
                        text: "Rest/bind on this Object";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }
                }

                if root.has-animation-player: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.has-animation-player: EditorFoldout {
                    title: "Animation Player";
                    icon: EditorGlyphs.animation-player;
                    expanded <=> root.animation-player-expanded;
                    EditorButton {
                        text: "Remove";
                        clicked => { root.remove-unique-attachment("AnimationPlayer"); }
                    }
                }

                // Always-present within scene inspector branch (not under nested `if`).
                clip-list-host := VerticalBox {
                    spacing: 0px;
                    vertical-stretch: 0;
                    height: root.clip-row-pitch * root.animation-clips.length;
                    visible: root.has-animation-player && root.animation-player-expanded
                        && root.has-selection && !root.multi-edit-visible;
                    changed width => {
                        root.clip-list-origin-x = self.absolute-position.x;
                        root.clip-list-origin-y = self.absolute-position.y;
                        root.clip-list-width = self.width;
                    }
                    changed height => {
                        root.clip-list-origin-x = self.absolute-position.x;
                        root.clip-list-origin-y = self.absolute-position.y;
                        root.clip-list-width = self.width;
                    }
                    changed visible => {
                        root.clip-list-origin-x = self.absolute-position.x;
                        root.clip-list-origin-y = self.absolute-position.y;
                        root.clip-list-width = self.width;
                    }

                    for clip[i] in root.animation-clips: Rectangle {
                        height: root.clip-row-pitch;
                        vertical-stretch: 0;
                        width: 100%;
                        background: root.browser-drag-active && root.clip-drop-highlight-index == clip.entry-index
                            ? EditorTheme.accent-soft
                            : transparent;
                        border-radius: 3px;
                        border-width: root.browser-drag-active && root.clip-drop-highlight-index == clip.entry-index ? 1px : 0px;
                        border-color: EditorTheme.accent-line;

                        VerticalBox {
                            padding: 2px;
                            spacing: 4px;
                            HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: "Name";
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    width: 48px;
                                    vertical-alignment: center;
                                }
                                clip-name-input := EditorCompactField {
                                    horizontal-stretch: 1;
                                    text: clip.clip-name;
                                    accepted => {
                                        root.commit-animation-clip(
                                            clip.entry-index, self.text, clip.clip-guid);
                                    }
                                    changed has-focus => {
                                        if (!self.has-focus) {
                                            root.commit-animation-clip(
                                                clip.entry-index, self.text, clip.clip-guid);
                                        }
                                    }
                                }
                            }
                            HorizontalBox {
                                spacing: 6px;
                                Text {
                                    text: "Clip";
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    width: 48px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: clip.clip-display;
                                    color: clip.clip-invalid ? #ff8080 : #e0e0e0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                clip-pick-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.open-clip-picker(clip.entry-index); }
                                    Rectangle {
                                        width: 44px;
                                        height: 20px;
                                        background: clip-pick-touch.has-hover ? #3a4a5a : #2a3a4a;
                                        border-radius: 3px;
                                        Text {
                                            text: "Pick";
                                            color: EditorTheme.accent-sel-text;
                                            font-size: 10px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                EditorButton {
                                    text: "Remove";
                                    clicked => { root.remove-clip(clip.entry-index); }
                                }
                            }
                        }
                    }
                }

                add-clip-host := TouchArea {
                    mouse-cursor: pointer;
                    height: 24px;
                    vertical-stretch: 0;
                    visible: root.has-animation-player && root.animation-player-expanded
                        && root.has-selection && !root.multi-edit-visible;
                    changed width => {
                        root.add-clip-origin-y = self.absolute-position.y;
                        root.add-clip-height = self.height;
                        root.clip-list-origin-x = clip-list-host.absolute-position.x;
                        root.clip-list-origin-y = clip-list-host.absolute-position.y;
                        root.clip-list-width = clip-list-host.width;
                    }
                    changed height => {
                        root.add-clip-origin-y = self.absolute-position.y;
                        root.add-clip-height = self.height;
                    }
                    changed visible => {
                        root.add-clip-origin-y = self.absolute-position.y;
                        root.add-clip-height = self.height;
                    }
                    clicked => { root.open-clip-picker(-1); }
                    Rectangle {
                        background: root.browser-drag-active && root.clip-drop-highlight-index == -1
                            ? EditorTheme.accent-soft
                            : EditorTheme.button;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.browser-drag-active && root.clip-drop-highlight-index == -1
                            ? EditorTheme.accent-line
                            : EditorTheme.hairline;
                        height: 24px;
                        Text {
                            text: "Add clip";
                            color: EditorTheme.accent-sel-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.has-animation-player && root.animation-player-expanded: VerticalBox {
                    spacing: 6px;

                    if !root.has-selection || root.multi-edit-visible: Text {
                        text: root.has-selection ? "Select one entity" : "Select an entity";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }

                    if root.clip-picker-open: VerticalBox {
                        spacing: 4px;
                        Text {
                            text: root.clip-picker-target-index < 0 ? "Pick AnimationClip (append)" : "Pick AnimationClip (retarget)";
                            color: EditorTheme.muted;
                            font-size: 11px;
                        }
                        if root.clip-picker-choices.length == 0: Text {
                            text: "No AnimationClip assets in registry";
                            color: EditorTheme.muted;
                            font-size: 11px;
                        }
                        for choice[ci] in root.clip-picker-choices: TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.pick-clip-choice(choice.guid, choice.stem, choice.display-name);
                                root.clip-picker-open = false;
                            }
                            Rectangle {
                                height: 22px;
                                background: #333333;
                                border-radius: 3px;
                                Text {
                                    text: choice.display-name;
                                    color: #e0e0e0;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    padding-left: 6px;
                                }
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clip-picker-open = false; }
                            Rectangle {
                                height: 22px;
                                background: EditorTheme.hairline;
                                border-radius: 3px;
                                Text {
                                    text: "Cancel";
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                if root.has-animation-tree: Rectangle { background: EditorTheme.hairline; height: 1px; }

                if root.has-animation-tree: EditorFoldout {
                    title: "AnimationTree";
                    icon: EditorGlyphs.animation-tree;
                    expanded <=> root.animation-tree-expanded;
                    EditorButton {
                        text: "Remove";
                        clicked => { root.remove-unique-attachment("AnimationTree"); }
                    }
                }
                if root.has-animation-tree && root.animation-tree-expanded: VerticalBox {
                    spacing: 6px;
                    EditorButton {
                        text: "Open Canvas";
                        enabled: root.anim-tree-canvas-open-enabled;
                        clicked => { root.open-anim-tree-canvas-requested(); }
                    }
                    if !root.anim-tree-canvas-open-enabled: Text {
                        text: "Select Object with AnimationTree Asset GUID";
                        color: EditorTheme.muted;
                        font-size: 11px;
                    }
            }
        }
    }
}
}
}
