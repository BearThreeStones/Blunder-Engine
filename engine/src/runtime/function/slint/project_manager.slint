import { EditorTheme, EditorButton, EditorTextField, EditorToggle, EditorModalPanel } from "editor_controls.slint";

export struct ProjectRow {
    name: string,
    path: string,
    missing: bool,
    last-opened: string,
}

export component ProjectManagerWindow inherits Window {
    title: "Blunder Project Manager";
    preferred-width: 1100px;
    preferred-height: 700px;
    background: EditorTheme.app-bar;

    in-out property <[ProjectRow]> projects: [];
    in-out property <int> selected-index: -1;
    in property <string> status-text: "";

    in-out property <bool> create-dialog-visible: false;
    in-out property <string> create-name: "New Project";
    in-out property <string> create-path: "";
    in-out property <bool> create-folder: true;

    in-out property <bool> import-dialog-visible: false;
    in-out property <string> import-path: "";

    callback open-requested();
    callback remove-requested();
    callback create-browse-requested();
    callback create-confirm-requested();
    callback create-cancel-requested();
    callback import-browse-requested();
    callback import-confirm-requested();
    callback import-cancel-requested();
    callback show-create-requested();
    callback show-import-requested();
    callback selection-changed(int);

    VerticalLayout {
        padding: 0;
        spacing: 0;

        Rectangle {
            height: EditorTheme.app-bar-height;
            background: EditorTheme.app-bar;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 24px;
                alignment: start;
                Text {
                    text: "BLUNDER";
                    color: EditorTheme.default-text;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 0;
                    Text {
                        text: "Projects";
                        color: EditorTheme.default-text;
                        font-size: 13px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 2px;
                        background: EditorTheme.accent;
                        width: 64px;
                    }
                }
            }
        }
        Rectangle { height: 1px; background: EditorTheme.hairline; }

        HorizontalLayout {
            padding: 12px;
            spacing: 12px;

            VerticalLayout {
                spacing: 10px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 8px;
                    EditorButton {
                        text: "Create";
                        primary: true;
                        clicked => { root.show-create-requested(); }
                    }
                    EditorButton {
                        text: "Import";
                        clicked => { root.show-import-requested(); }
                    }
                }

                Rectangle {
                    background: EditorTheme.window;
                    border-radius: EditorTheme.radius-surface;
                    border-width: 1px;
                    border-color: EditorTheme.hairline;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 6px;
                        spacing: 6px;
                        if root.projects.length == 0: Text {
                            text: "No projects yet. Create or Import to get started.";
                            color: EditorTheme.muted;
                        }
                        for project[index] in root.projects: Rectangle {
                            height: 56px;
                            background: index == root.selected-index ? EditorTheme.accent-sel-fill : transparent;
                            border-radius: EditorTheme.radius-ctl;
                            border-width: 1px;
                            border-color: index == root.selected-index ? EditorTheme.accent-line : EditorTheme.hairline;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 16px;
                                VerticalLayout {
                                    spacing: 2px;
                                    vertical-stretch: 1;
                                    alignment: center;
                                    Text {
                                        text: project.name;
                                        color: project.missing ? #cc6666
                                            : (index == root.selected-index ? EditorTheme.accent-sel-text : EditorTheme.default-text);
                                        font-size: 14px;
                                        font-weight: 600;
                                    }
                                    Text {
                                        text: project.missing ? project.path + " (missing)" : project.path;
                                        color: EditorTheme.muted;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                Text {
                                    text: project.last-opened;
                                    color: EditorTheme.muted;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 150px;
                                }
                            }
                            TouchArea {
                                clicked => {
                                    root.selected-index = index;
                                    root.selection-changed(index);
                                }
                                double-clicked => {
                                    root.selected-index = index;
                                    root.selection-changed(index);
                                    root.open-requested();
                                }
                            }
                        }
                    }
                }
            }

            VerticalLayout {
                width: 140px;
                spacing: 8px;
                padding-top: 34px;
                EditorButton {
                    text: "Open";
                    primary: true;
                    enabled: root.selected-index >= 0;
                    clicked => { root.open-requested(); }
                }
                EditorButton {
                    text: "Remove";
                    enabled: root.selected-index >= 0;
                    clicked => { root.remove-requested(); }
                }
            }
        }

        Rectangle { height: 1px; background: EditorTheme.hairline; }
        Rectangle {
            height: 28px;
            background: EditorTheme.app-bar;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.status-text;
                    color: EditorTheme.muted;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    if root.create-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: EditorTheme.modal-dim;
        EditorModalPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            panel-width: 500px;
            Text {
                text: "Create New Project";
                color: EditorTheme.default-text;
                font-size: 16px;
                font-weight: 700;
            }
            Text { text: "Name"; color: EditorTheme.muted; font-size: EditorTheme.font; }
            EditorTextField { text <=> root.create-name; }
            Text { text: "Path"; color: EditorTheme.muted; font-size: EditorTheme.font; }
            HorizontalLayout {
                spacing: 8px;
                EditorTextField {
                    horizontal-stretch: 1;
                    text <=> root.create-path;
                }
                EditorButton {
                    text: "Browse…";
                    clicked => { root.create-browse-requested(); }
                }
            }
            EditorToggle {
                text: "Create Folder";
                checked <=> root.create-folder;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                EditorButton {
                    text: "Cancel";
                    clicked => { root.create-cancel-requested(); }
                }
                EditorButton {
                    text: "Create & Open";
                    primary: true;
                    clicked => { root.create-confirm-requested(); }
                }
            }
        }
    }

    if root.import-dialog-visible: Rectangle {
        width: 100%;
        height: 100%;
        background: EditorTheme.modal-dim;
        EditorModalPanel {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            panel-width: 500px;
            Text {
                text: "Import Existing Project";
                color: EditorTheme.default-text;
                font-size: 16px;
                font-weight: 700;
            }
            Text {
                text: "Project path (folder or project.blunder)";
                color: EditorTheme.muted;
                font-size: EditorTheme.font;
            }
            HorizontalLayout {
                spacing: 8px;
                EditorTextField {
                    horizontal-stretch: 1;
                    text <=> root.import-path;
                }
                EditorButton {
                    text: "Browse…";
                    clicked => { root.import-browse-requested(); }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                EditorButton {
                    text: "Cancel";
                    clicked => { root.import-cancel-requested(); }
                }
                EditorButton {
                    text: "Import & Open";
                    primary: true;
                    clicked => { root.import-confirm-requested(); }
                }
            }
        }
    }
}
