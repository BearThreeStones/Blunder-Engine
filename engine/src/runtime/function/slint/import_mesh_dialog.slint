import { EditorTheme, EditorButton, EditorToggle, EditorSlider, EditorModalPanel } from "editor_controls.slint";

export component ImportMeshDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in-out property <bool> import-materials: true;
    in-out property <bool> import-animations: true;
    in-out property <float> import-scale: 1.0;

    callback confirmed();
    callback cancelled();

    visible: root.show-dialog;
    background: EditorTheme.modal-dim;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    EditorModalPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        panel-width: 320px;

        Text {
            text: "Import Mesh";
            color: EditorTheme.default-text;
            font-size: EditorTheme.font-lg;
        }

        EditorToggle {
            text: "Import Materials";
            checked <=> root.import-materials;
        }

        EditorToggle {
            text: "Import Animations";
            checked <=> root.import-animations;
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "Scale";
                color: EditorTheme.window-text;
                vertical-alignment: center;
            }
            Text {
                text: Math.round(root.import-scale * 100) / 100;
                color: EditorTheme.accent-sel-text;
                width: 48px;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        EditorSlider {
            minimum: 0.01;
            maximum: 10.0;
            value <=> root.import-scale;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            EditorButton {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            EditorButton {
                text: "Import";
                primary: true;
                clicked => { root.confirmed(); }
            }
        }
    }
}
