import { Button, CheckBox, VerticalBox, HorizontalBox, Slider } from "std-widgets.slint";

export component ImportMeshDialog inherits Rectangle {
    in property <bool> show-dialog: false;
    in-out property <bool> import-materials: true;
    in-out property <bool> import-animations: true;
    in-out property <float> import-scale: 1.0;

    callback confirmed();
    callback cancelled();

    visible: root.show-dialog;
    background: #000000aa;

    // Absorb all pointer events on the backdrop so clicks don't fall through.
    TouchArea {
        width: 100%;
        height: 100%;
    }

    dialog-panel := Rectangle {
        width: 320px;
        height: 240px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #252525;
        border-color: #444444;
        border-width: 1px;
        border-radius: 6px;

        VerticalBox {
            padding: 12px;
            spacing: 8px;

            Text {
                text: "Import Mesh";
                color: #f0f0f0;
                font-size: 14px;
            }

            CheckBox {
                text: "Import Materials";
                checked <=> root.import-materials;
            }

            CheckBox {
                text: "Import Animations";
                checked <=> root.import-animations;
            }

            HorizontalBox {
                spacing: 8px;
                Text {
                    text: "Scale";
                    color: #c0c0c0;
                    vertical-alignment: center;
                }
                Text {
                    text: Math.round(root.import-scale * 100) / 100;
                    color: #bde7ff;
                    width: 48px;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }

            Slider {
                minimum: 0.01;
                maximum: 10.0;
                value <=> root.import-scale;
            }

            HorizontalBox {
                spacing: 8px;
                Button {
                    text: "Cancel";
                    clicked => { root.cancelled(); }
                }
                Button {
                    text: "Import";
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
