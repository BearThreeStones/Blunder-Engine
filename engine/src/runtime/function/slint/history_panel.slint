import { EditorTheme, EditorToggle, EditorTab } from "editor_controls.slint";
import {
    ContentBrowser,
    BrowserTreeRow,
    BrowserGridRow,
    BrowserPathSegment,
} from "content_browser.slint";

export struct HistoryRow {
    label: string,
    index: int,
    stack: int,
    is-applied: bool,
    is-current: bool,
    is-group: bool,
}

export component HistoryPanel {
    in-out property <[HistoryRow]> rows: [];
    in-out property <bool> filter-scene: true;
    in-out property <bool> filter-global: true;

    callback filter-changed();
    callback entry-clicked(int, int);

    min-height: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    Rectangle {
        background: EditorTheme.window;
        border-color: EditorTheme.hairline;
        border-width: 1px;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            Rectangle {
                height: 34px;
                background: EditorTheme.toolbar;

                HorizontalLayout {
                    padding: 6px;
                    padding-left: 10px;
                    spacing: 14px;
                    alignment: start;

                    EditorToggle {
                        text: "Scene";
                        checked <=> root.filter-scene;
                        toggled => { root.filter-changed(); }
                    }
                    EditorToggle {
                        text: "Global";
                        checked <=> root.filter-global;
                        toggled => { root.filter-changed(); }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: EditorTheme.field;
                clip: true;

                Flickable {
                    width: 100%;
                    height: 100%;
                    viewport-width: self.width;
                    viewport-height: history-list.preferred-height;

                    history-list := VerticalLayout {
                        alignment: start;
                        spacing: 0px;
                        width: parent.width;

                        for row[i] in root.rows: Rectangle {
                            height: 26px;
                            width: parent.width;
                            background: row.is-group ? EditorTheme.toolbar
                                : (row.is-current ? EditorTheme.accent-sel-fill : transparent);

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                alignment: center;

                                Text {
                                    text: row.label;
                                    color: row.is-group ? EditorTheme.muted
                                        : (row.is-applied ? EditorTheme.default-text : EditorTheme.muted);
                                    font-size: row.is-group ? 11px : 12px;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }

                            TouchArea {
                                width: 100%;
                                height: 100%;
                                clicked => {
                                    if (!row.is-group) {
                                        root.entry-clicked(row.stack, row.index);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// Sibling File System / History tabs wrapping ContentBrowser + HistoryPanel.
export component FilesystemHistoryHost {
    in-out property <[BrowserTreeRow]> tree-rows: [];
    in-out property <[BrowserGridRow]> grid-rows: [];
    in-out property <[BrowserPathSegment]> path-segments: [];
    in property <bool> drag-active: false;
    in property <string> drag-source-path: "";
    in property <string> drop-highlight-path: "";
    in property <bool> viewport-drop-active: false;
    in property <string> status-text: "0 items";
    in property <string> selected-folder-path: "";
    in-out property <string> selected-grid-path: "";
    in-out property <length> thumb-size: 80px;
    in-out property <bool> details-view: false;
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;
    in-out property <length> tree-pane-width: 200px;
    in property <bool> layout-drag-active: false;

    in-out property <[HistoryRow]> history-rows: [];
    in-out property <bool> history-filter-scene: true;
    in-out property <bool> history-filter-global: true;
    in-out property <int> active-subtab: 0;

    callback folder-selected(string);
    callback folder-toggle(string);
    callback refresh-requested();
    callback import-requested();
    callback new-scene-requested(string);
    callback new-folder-requested(string);
    callback rename-requested(string);
    callback delete-requested(string);
    callback duplicate-scene-requested(string);
    callback open-scene-requested(string);
    callback grid-select(string, bool, bool);
    callback item-press(string, float, float);
    callback item-move(string, float, float);
    callback item-release(string, float, float);
    callback layout-drag-active-changed(bool);
    callback search-changed(string);
    callback path-segment-clicked(string);
    callback sort-clicked(int);
    callback history-filter-changed();
    callback history-entry-clicked(int, int);
    in-out property <string> inline-rename-path: "";
    in-out property <string> inline-rename-buffer: "";
    callback inline-rename-commit(string);
    callback inline-rename-cancel();

    out property <length> browser-origin-x: browser.browser-origin-x;
    out property <length> browser-origin-y: browser.browser-origin-y;
    out property <length> browser-width: browser.browser-width;
    out property <length> browser-height: browser.browser-height;
    in-out property <length> tree-origin-y <=> browser.tree-origin-y;
    in-out property <length> tree-panel-height <=> browser.tree-panel-height;
    in-out property <length> grid-origin-x <=> browser.grid-origin-x;
    in-out property <length> grid-origin-y <=> browser.grid-origin-y;
    in-out property <length> grid-area-width <=> browser.grid-area-width;
    in-out property <length> grid-viewport-y <=> browser.grid-viewport-y;
    in-out property <int> grid-column-count <=> browser.grid-column-count;

    min-height: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    // Fill the dock tile and position the active page directly below the
    // subtab bar. A VerticalLayout placed the custom page at the host's
    // bottom edge, outside the tile's clip — looks like an empty browser.
    host-root := Rectangle {
        width: 100%;
        height: 100%;
        background: EditorTheme.window;

        Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            subtab-bar := Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 28px;
                background: EditorTheme.app-bar;

                HorizontalLayout {
                    padding-left: 8px;
                    spacing: 4px;
                    alignment: start;

                    EditorTab {
                        text: "File System";
                        active: root.active-subtab == 0;
                        clicked => { root.active-subtab = 0; }
                    }
                    EditorTab {
                        text: "History";
                        active: root.active-subtab == 1;
                        clicked => { root.active-subtab = 1; }
                    }
                }
            }

            browser := ContentBrowser {
                x: 0px;
                y: 28px;
                width: 100%;
                height: parent.height > 28px ? parent.height - 28px : 0px;
                visible: root.active-subtab == 0;
                layout-drag-active: root.layout-drag-active;
                tree-rows <=> root.tree-rows;
                grid-rows <=> root.grid-rows;
                path-segments <=> root.path-segments;
                drag-active: root.drag-active;
                drag-source-path: root.drag-source-path;
                drop-highlight-path: root.drop-highlight-path;
                viewport-drop-active: root.viewport-drop-active;
                status-text: root.status-text;
                selected-folder-path: root.selected-folder-path;
                selected-grid-path <=> root.selected-grid-path;
                tree-pane-width <=> root.tree-pane-width;
                thumb-size <=> root.thumb-size;
                details-view <=> root.details-view;
                sort-column: root.sort-column;
                sort-ascending: root.sort-ascending;
                inline-rename-path: root.inline-rename-path;
                inline-rename-buffer: root.inline-rename-buffer;
                folder-selected(path) => { root.folder-selected(path); }
                folder-toggle(path) => { root.folder-toggle(path); }
                refresh-requested => { root.refresh-requested(); }
                import-requested => { root.import-requested(); }
                new-scene-requested(path) => { root.new-scene-requested(path); }
                new-folder-requested(path) => { root.new-folder-requested(path); }
                rename-requested(path) => { root.rename-requested(path); }
                delete-requested(path) => { root.delete-requested(path); }
                duplicate-scene-requested(path) => { root.duplicate-scene-requested(path); }
                open-scene-requested(path) => { root.open-scene-requested(path); }
                grid-select(path, ctrl, shift) => { root.grid-select(path, ctrl, shift); }
                item-press(path, x, y) => { root.item-press(path, x, y); }
                item-move(path, x, y) => { root.item-move(path, x, y); }
                item-release(path, x, y) => { root.item-release(path, x, y); }
                layout-drag-active-changed(active) => {
                    root.layout-drag-active-changed(active);
                }
                search-changed(text) => { root.search-changed(text); }
                path-segment-clicked(path) => { root.path-segment-clicked(path); }
                sort-clicked(column) => { root.sort-clicked(column); }
                inline-rename-commit(name) => { root.inline-rename-commit(name); }
                inline-rename-cancel => { root.inline-rename-cancel(); }
            }

            HistoryPanel {
                x: 0px;
                y: 28px;
                width: 100%;
                height: parent.height > 28px ? parent.height - 28px : 0px;
                visible: root.active-subtab == 1;
                rows <=> root.history-rows;
                filter-scene <=> root.history-filter-scene;
                filter-global <=> root.history-filter-global;
                filter-changed => { root.history-filter-changed(); }
                entry-clicked(stack, index) => { root.history-entry-clicked(stack, index); }
            }
        }
    }
}
