    callback browser-inline-rename-commit(string);
    callback browser-inline-rename-cancel();

    in property <string> inspector-entity-name: "";
    in property <bool> inspector-has-selection: false;
    in-out property <float> inspector-pos-x: 0.0;
    in-out property <float> inspector-pos-y: 0.0;
    in-out property <float> inspector-pos-z: 0.0;
    in-out property <float> inspector-rot-x: 0.0;
    in-out property <float> inspector-rot-y: 0.0;
    in-out property <float> inspector-rot-z: 0.0;
    in-out property <float> inspector-scale-x: 1.0;
    in-out property <float> inspector-scale-y: 1.0;
    in-out property <float> inspector-scale-z: 1.0;
    in-out property <float> inspector-quat-x: 0.0;
    in-out property <float> inspector-quat-y: 0.0;
    in-out property <float> inspector-quat-z: 0.0;
    in-out property <float> inspector-quat-w: 1.0;
    in property <bool> inspector-pos-x-mixed: false;
    in property <bool> inspector-pos-y-mixed: false;
    in property <bool> inspector-pos-z-mixed: false;
    in property <bool> inspector-rot-x-mixed: false;
    in property <bool> inspector-rot-y-mixed: false;
    in property <bool> inspector-rot-z-mixed: false;
    in property <bool> inspector-scale-x-mixed: false;
    in property <bool> inspector-scale-y-mixed: false;
    in property <bool> inspector-scale-z-mixed: false;
    in-out property <bool> inspector-transform-expanded: true;
    in-out property <bool> inspector-rotation-edit-mode-euler: true;
    in-out property <bool> inspector-scale-link-enabled: true;
    in property <bool> inspector-multi-edit-visible: false;
    in-out property <bool> inspector-multi-edit-absolute: true;

    in property <[BehaviourRow]> inspector-behaviours: [];
    in property <[string]> inspector-behaviour-type-choices: [];
    in property <[string]> inspector-behaviour-clip-name-choices: [];
    in-out property <int> inspector-behaviour-clip-name-picker-id: -1;
    in-out property <string> inspector-behaviour-clip-name-picker-key: "";
    in-out property <bool> inspector-behaviours-expanded: true;

    in property <[SkeletonModifierRow]> inspector-skeleton-modifiers: [];
    in property <[string]> inspector-skeleton-modifier-type-choices: [];
    in-out property <bool> inspector-skeleton-modifiers-expanded: true;

    in property <bool> inspector-has-camera: false;
    in-out property <float> inspector-camera-fov: 45.0;
    in-out property <float> inspector-camera-near: 0.1;
    in-out property <float> inspector-camera-far: 1000.0;
    in-out property <bool> inspector-camera-is-main: false;
    in-out property <bool> inspector-camera-expanded: true;

    in property <bool> inspector-has-light: false;
    in-out property <int> inspector-light-type: 0;
    in-out property <float> inspector-light-color-r: 1.0;
    in-out property <float> inspector-light-color-g: 1.0;
    in-out property <float> inspector-light-color-b: 1.0;
    in-out property <float> inspector-light-intensity: 1.0;
    in-out property <bool> inspector-light-enabled: true;
    in-out property <int> inspector-light-contribution: 0;
    in-out property <float> inspector-light-range: 10.0;
    in-out property <float> inspector-light-inner-cone: 0.0;
    in-out property <float> inspector-light-outer-cone: 45.0;
    in-out property <float> inspector-light-width: 1.0;
    in-out property <float> inspector-light-height: 1.0;
    in-out property <string> inspector-light-linking-text: "";
    in-out property <bool> inspector-light-expanded: true;

    in property <bool> inspector-has-animation-player: false;
    in property <[AnimationClipRow]> inspector-animation-clips: [];
    in property <[AnimationClipPickerRow]> inspector-clip-picker-choices: [];
    in-out property <bool> inspector-clip-picker-open: false;
    in property <int> inspector-clip-picker-target-index: -1;
    in property <int> inspector-clip-drop-highlight-index: -2;
    in-out property <length> inspector-clip-list-origin-x: 0px;
    in-out property <length> inspector-clip-list-origin-y: 0px;
    in-out property <length> inspector-clip-list-width: 0px;
    in-out property <length> inspector-clip-row-pitch: 72px;
    in-out property <length> inspector-add-clip-origin-y: 0px;
    in-out property <length> inspector-add-clip-height: 24px;
    in-out property <bool> inspector-animation-player-expanded: true;
    in property <bool> inspector-add-menu-enabled: false;
    in property <bool> inspector-has-skeleton: false;
    in property <bool> inspector-has-animation-tree: false;
    in property <bool> inspector-remove-skeleton-enabled: true;

    in property <bool> inspector-asset-mode: false;
    in property <string> inspector-asset-display-name: "";
    in property <string> inspector-asset-guid: "";
    in property <string> inspector-asset-type: "";
    in property <string> inspector-asset-intermediate-path: "";

    in property <image> inspector-mesh-preview-image;
    in property <bool> inspector-mesh-preview-has-image: false;
    callback inspector-mesh-preview-orbit(float, float);
    callback inspector-mesh-preview-zoom(float);
    callback inspector-mesh-preview-reset();
    callback inspector-activated();
    in property <bool> mesh-material-section-visible: false;
    in-out property <bool> mesh-material-unlit: false;
    in-out property <float> mesh-base-color-r: 1.0;
    in-out property <float> mesh-base-color-g: 1.0;
    in-out property <float> mesh-base-color-b: 1.0;
    in-out property <float> mesh-base-color-a: 1.0;
    in-out property <float> mesh-metallic: 0.0;
    in-out property <float> mesh-roughness: 1.0;
    in-out property <float> mesh-ambient-r: 0.0;
    in-out property <float> mesh-ambient-g: 0.0;
    in-out property <float> mesh-ambient-b: 0.0;
    in-out property <float> mesh-diffuse-r: 1.0;
    in-out property <float> mesh-diffuse-g: 1.0;
    in-out property <float> mesh-diffuse-b: 1.0;
    in-out property <float> mesh-specular-r: 0.4;
    in-out property <float> mesh-specular-g: 0.4;
    in-out property <float> mesh-specular-b: 0.4;
    in-out property <float> mesh-shininess: 32.0;
    in property <string> mesh-slot-base-color-name: "";
    in property <bool> mesh-slot-base-color-assigned: false;
    in property <string> mesh-slot-metallic-name: "";
    in property <bool> mesh-slot-metallic-assigned: false;
    in property <string> mesh-slot-normal-name: "";
    in property <bool> mesh-slot-normal-assigned: false;
    in property <string> mesh-slot-occlusion-name: "";
    in property <bool> mesh-slot-occlusion-assigned: false;
    callback mesh-material-unlit-toggled(bool);
    callback mesh-material-scalar-committed(int, float, float, float, float);
    callback mesh-material-reset-requested();
    callback mesh-slot-pick-requested(int);
    callback mesh-slot-clear-requested(int);
    callback mesh-slot-drop-requested(int);

    callback inspector-transform-edited();
    callback inspector-field-text-committed(int, string);
    callback inspector-field-focus-changed(int, bool);
    callback inspector-rotation-mode-changed(bool);
    callback inspector-scale-link-toggled(bool);
    callback inspector-multi-edit-mode-changed(bool);
    callback inspector-add-behaviour(string);
    callback inspector-remove-behaviour(int);
    callback inspector-reorder-behaviour(int, int);
    callback inspector-commit-behaviour-prop(int, string, string, float, bool);
    callback inspector-add-skeleton-modifier(string);
    callback inspector-remove-skeleton-modifier(int);
    callback inspector-reorder-skeleton-modifier(int, int);
    callback inspector-set-skeleton-modifier-enabled(int, bool);
    callback inspector-commit-skeleton-modifier-field(int, string, string, float, bool);
    callback inspector-camera-edited();
    callback inspector-light-edited();
    callback inspector-add-unique-attachment(string);
    callback inspector-remove-unique-attachment(string);
    callback inspector-add-clip();
    callback inspector-remove-clip(int);
    callback inspector-commit-animation-clip(int, string, string);
    callback inspector-open-clip-picker(int);
    callback inspector-pick-clip-choice(string, string, string);
    callback save-scene-requested();
    callback save-scene-as-requested();
    callback edit-undo-requested();
    callback edit-redo-requested();
    in property <bool> edit-can-undo: false;
    in property <bool> edit-can-redo: false;

    callback play-requested();
    callback play-pause-requested();
    callback play-stop-requested();
    in property <bool> play-pause-enabled: false;
    in property <bool> play-stop-enabled: false;
    in property <bool> play-session-paused: false;

    callback anim-preview-play-requested();
    callback anim-preview-pause-requested();
    callback anim-preview-stop-requested();
    callback anim-preview-loop-toggled();
    callback anim-preview-params-edited();
    callback anim-preview-sync-fire-requested();
    callback anim-preview-enter-cine-requested();
    callback anim-preview-end-cine-requested();
    in property <bool> anim-preview-enabled: false;
    in property <bool> anim-preview-pause-enabled: false;
    in property <bool> anim-preview-stop-enabled: false;
    in property <bool> anim-preview-paused: false;
    in property <bool> anim-preview-looping: false;
    in-out property <float> anim-preview-time-scale: 1.0;
    in-out property <float> anim-preview-blend-weight: 0.0;
    in-out property <float> anim-preview-fade-seconds: 0.0;
    in-out property <string> anim-preview-slot0: "";
    in-out property <string> anim-preview-slot1: "";
    in property <bool> anim-preview-in-cine: false;
    in property <bool> anim-preview-input-suppressed: false;
    in property <bool> anim-preview-sync-fire-enabled: false;
    in property <bool> anim-preview-enter-cine-enabled: false;
    in property <bool> anim-preview-end-cine-enabled: false;

    in property <bool> anim-tree-canvas-open: false;
    in property <string> anim-tree-canvas-guid: "";
    in property <bool> anim-tree-canvas-dirty: false;
    in property <[AnimationTreeCanvasNodeRow]> anim-tree-canvas-nodes: [];
    in property <[AnimationTreeCanvasEdgeRow]> anim-tree-canvas-edges: [];
    callback anim-tree-canvas-close-requested();
    callback anim-tree-canvas-save-requested();
    callback anim-tree-canvas-open-from-selection-requested();
    in property <bool> anim-tree-canvas-open-enabled: false;

    in-out property <bool> play-dirty-dialog-visible: false;
    in-out property <bool> open-dirty-dialog-visible: false;
    in-out property <bool> detection-reimport-dialog-visible: false;
    in-out property <int> detection-reimport-asset-count: 1;
    callback play-dirty-save-and-play();
    callback play-dirty-play-last-saved();
    callback play-dirty-cancelled();
    callback open-dirty-save-and-open();
    callback open-dirty-discard-and-open();
    callback open-dirty-cancelled();
    callback detection-reimport-all();
    callback detection-reimport-dismissed();
    in-out property <bool> browser-delete-dialog-visible: false;
    in-out property <string> browser-delete-dialog-name: "";
    in-out property <int> browser-delete-dialog-asset-count: 0;
    callback browser-delete-confirmed();
    callback browser-delete-cancelled();

    in-out property <bool> viewport-is-perspective: true;
    in property <bool> viewport-image-ready: false;
    callback viewport-projection-toggled();

    in-out property <int> transform-gizmo-mode: 0;
    in-out property <bool> transform-gizmo-space-global: true;
    callback transform-mode-selected(int);
    callback gizmo-space-toggled();

    in property <bool> camera-preview-visible: false;
    in property <image> camera-preview-image;
    in-out property <bool> camera-preview-collapsed: false;
    in property <string> camera-preview-title: "Camera";
    in-out property <length> camera-preview-panel-x: 0px;
    in-out property <length> camera-preview-panel-y: 0px;
    in-out property <length> camera-preview-content-w: 320px;
    in-out property <length> camera-preview-content-h: 180px;
    in-out property <bool> camera-preview-position-initialized: false;
    callback camera-preview-collapse-toggled();

    in-out property <bool> import-mesh-dialog-visible: false;
    in-out property <bool> import-mesh-materials: true;
    in-out property <bool> import-mesh-animations: true;
    in-out property <float> import-mesh-scale: 1.0;
    callback import-mesh-confirmed();
    callback import-mesh-cancelled();

    in-out property <bool> piercing-menu-visible: false;
    in-out property <length> piercing-menu-anchor-x: 0px;
    in-out property <length> piercing-menu-anchor-y: 0px;
    in-out property <[PiercingMenuRow]> piercing-menu-rows: [];
    callback piercing-entity-selected(int);
    callback piercing-menu-dismissed();

    in-out property <bool> view-menu-visible: false;
    in-out property <length> view-menu-anchor-x: 0px;
    in-out property <length> view-menu-anchor-y: 0px;
    callback view-menu-dismissed();
    callback view-align-view-to-camera-requested();
    callback view-align-camera-to-view-requested();

    in property <bool> docking-visible: true;
    in property <[DockTile]> docking-tiles: [];
    in property <[DockTab]> docking-tabs: [];
    in property <[DockSplitterHandle]> docking-splitters: [];
    in property <[DockGuide]> docking-guides: [];
    in property <[DockHostGuide]> docking-host-guides: [];
    in property <[DockFloating]> docking-floatings: [];
    in property <DockPreview> docking-preview;
    in property <DockPreview> docking-host-dock-preview;
    in property <DockAutoHideDropPreview> docking-auto-hide-drop-preview;
    in property <bool> docking-cross-guides-visible: false;
    in property <DockDragPreview> docking-drag-preview;
    in property <bool> docking-drag-active: false;

    out property <length> docking-width: docking_host.width;
    out property <length> docking-height: docking_host.height;
    out property <length> docking-origin-x: docking_host.absolute-position.x;
    out property <length> docking-origin-y: docking_host.absolute-position.y;

    callback docking-tab-pressed(int, length, length);
    callback docking-tab-moved(length, length);
    callback docking-tab-released(length, length);
    callback docking-tab-activated(int);
    callback docking-widget-closed(int);
    callback docking-splitter-pressed(int, length, length);
    callback docking-splitter-moved(int, length, length);
    callback docking-splitter-released();
    callback docking-floating-move-pressed(int, length, length);
    callback docking-floating-resize-pressed(int, length, length);
    callback docking-floating-moved(length, length);
    callback docking-floating-released();
    callback docking-floating-window-close(int);

    in property <[DockAutoHideTab]> docking-auto-hide-tabs: [];
    in property <[DockAutoHideOverlay]> docking-auto-hide-overlays: [];
    callback docking-auto-hide-tab-pressed(int);
    callback docking-auto-hide-tab-unpin(int);
    callback docking-tab-pin-pressed(int);
    callback docking-auto-hide-overlay-minimize(int);
    callback docking-auto-hide-overlay-close(int);
    callback docking-auto-hide-overlay-resize-pressed(int, length, length);
    callback docking-auto-hide-overlay-resize-moved(int, length, length);
    callback docking-auto-hide-overlay-resize-released();

    root-layer := Rectangle {
        width: 100%;
        height: 100%;

        VerticalLayout {
            width: 100%;
            height: 100%;
            spacing: 0;

            Rectangle {
                height: EditorTheme.app-bar-height;
                vertical-stretch: 0;
                background: EditorTheme.app-bar;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 11px;
                    padding-bottom: 11px;
                    spacing: 4px;
                    alignment: start;

                    Text {
                        text: "Blunder Editor";
                        color: EditorTheme.default-text;
                        font-size: 16px;
                        vertical-alignment: center;
                    }

                    Rectangle { width: 12px; }

                    EditorButton {
                        text: "Save";
                        ghost: true;
                        clicked => { root.save-scene-requested(); }
                    }
                    EditorButton {
                        text: "Undo";
                        ghost: true;
                        enabled: root.edit-can-undo;
                        clicked => { root.edit-undo-requested(); }
                    }
                    EditorButton {
                        text: "Redo";
                        ghost: true;
                        enabled: root.edit-can-redo;
                        clicked => { root.edit-redo-requested(); }
                    }
                    EditorButton {
                        text: "Save As…";
                        ghost: true;
                        clicked => { root.save-scene-as-requested(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    EditorSegmented {
                        EditorButton {
                            icon: EditorGlyphs.play;
                            primary: true;
                            clicked => { root.play-requested(); }
                        }
                        EditorButton {
                            icon: root.play-session-paused ? EditorGlyphs.play : EditorGlyphs.pause;
                            enabled: root.play-pause-enabled;
                            clicked => { root.play-pause-requested(); }
                        }
                        EditorButton {
                            icon: EditorGlyphs.stop;
                            enabled: root.play-stop-enabled;
                            clicked => { root.play-stop-requested(); }
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    view-menu-button := EditorButton {
                        text: "View";
                        ghost: true;
                        clicked => {
                            root.view-menu-anchor-x = self.absolute-position.x;
                            root.view-menu-anchor-y = self.absolute-position.y + self.height;
                            root.view-menu-visible = true;
                        }
                    }
                }
            }

            docking_host := Rectangle {
                vertical-stretch: 1;
                background: EditorTheme.app-bar;

                TouchArea {
                    width: 100%;
                    height: 100%;
                }

                for tile in root.docking-tiles: Rectangle {
                    x: tile.tab-x;
                    y: tile.tab-y;
                    width: tile.tab-width;
                    height: tile.tab-height;
                    background: EditorTheme.app-bar;
                }

                for tile in root.docking-tiles: Rectangle {
                    x: tile.content-x;
                    y: tile.content-y;
                    width: tile.content-width;
                    height: tile.content-height;
                    background: EditorTheme.window;
                    border-color: EditorTheme.hairline;
                    border-width: 1px;
                    border-radius: EditorTheme.radius-surface;
                    clip: true;

