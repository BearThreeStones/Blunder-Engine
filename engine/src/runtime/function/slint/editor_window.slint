import { EditorTheme, EditorButton, EditorSegmented } from "editor_controls.slint";
import { EditorGlyphs } from "editor_icons.slint";
import { BrowserTreeRow, BrowserGridRow, BrowserPathSegment } from "content_browser.slint";
import { FilesystemHistoryHost, HistoryRow } from "history_panel.slint";
import { ImportMeshDialog } from "import_mesh_dialog.slint";
import { PlayDirtySceneDialog } from "play_dirty_scene_dialog.slint";
import { OpenDirtySceneDialog } from "open_dirty_scene_dialog.slint";
import { DetectionReimportDialog } from "detection_reimport_dialog.slint";
import { BrowserDeleteDialog } from "browser_delete_dialog.slint";
import { PiercingMenu, PiercingMenuRow } from "piercing_menu.slint";
import { HierarchyPanel, HierarchyTreeRow } from "hierarchy.slint";
import { AttachmentPreviewCard, AttachmentPreviewCardRow } from "attachment_preview_card.slint";
import { ViewportProjectionToggle } from "viewport_projection_toggle.slint";
import { TransformToolbar } from "transform_toolbar.slint";
import { AnimationPreviewToolbar } from "animation_preview_toolbar.slint";
import { CameraPreviewPanel } from "camera_preview_panel.slint";
import { InspectorPanel, BehaviourRow, SkeletonModifierRow, AnimationClipRow, AnimationClipPickerRow } from "inspector_panel.slint";
import { AnimationTreeCanvasPanel, AnimationTreeCanvasNodeRow, AnimationTreeCanvasEdgeRow } from "animation_tree_canvas_panel.slint";
import { FloatingPanelWindow } from "floating_panel_window.slint";
export { FloatingPanelWindow }
import { DockChromeBar, DockChromeMetrics, DockSplittersLayer, DockGuidesLayer, DockHostGuidesLayer, DockAutoHideDropPreviewLayer, DockAutoHideTabsLayer, DockAutoHideOverlaysLayer, DockFloatingDragPreviewLayer, DockTile, DockTab, DockSplitterHandle, DockGuide, DockHostGuide, DockPreview, DockAutoHideDropPreview, DockDragPreview, DockFloating, DockAutoHideTab, DockAutoHideOverlay } from "docking_panel.slint";

export component MainEditorWindow inherits Window {
    // Logical size comes only from C++ dispatch_resize_event (see SlintWindowAdapter).
    in-out property <string> window-title: "Blunder Editor";
    title: root.window-title;
    background: EditorTheme.app-bar;

    in property <image> viewport-image;

    in-out property <length> viewport-origin-x: 0px;
    in-out property <length> viewport-origin-y: 0px;
    in-out property <length> viewport-width: 0px;
    in-out property <length> viewport-height: 0px;

    in-out property <float> light-dir-x: 0.45;
    in-out property <float> light-dir-y: 0.7;
    in-out property <float> light-dir-z: 0.55;
    in-out property <float> light-color-r: 1.0;
    in-out property <float> light-color-g: 1.0;
    in-out property <float> light-color-b: 1.0;

    in-out property <[HierarchyTreeRow]> hierarchy-tree-rows: [];
    in property <int> hierarchy-selected-entity-id: 0;
    in-out property <string> hierarchy-scene-display-name: "(No Scene)";

    in-out property <length> hierarchy-origin-x: 0px;
    in-out property <length> hierarchy-origin-y: 0px;
    in-out property <length> hierarchy-width: 0px;
    in-out property <length> hierarchy-height: 0px;
    in-out property <length> hierarchy-tree-origin-y: 0px;

    callback hierarchy-entity-selected(int);
    callback hierarchy-entity-context-selected(int);
    callback hierarchy-entity-toggle(int);
    callback hierarchy-create-requested(int, string);
    callback hierarchy-delete-requested(int);
    callback hierarchy-icon-pressed(int, float, float);

    in-out property <[AttachmentPreviewCardRow]> attachment-preview-cards: [];
    callback attachment-preview-pin-toggled(int, int, int);
    callback attachment-preview-close-requested(int, int, int);
    callback attachment-preview-focus-changed(bool);
    callback attachment-preview-transform-edited(int, int, int, float, float, float, float, float, float, float, float, float);
    callback attachment-preview-camera-edited(int, int, int, float, float, float, bool);
    callback attachment-preview-light-edited(int, int, int, int, float, float, float, float, bool, float);
    callback attachment-preview-unique-remove(int, int, int);
    callback attachment-preview-tree-canvas(int, int, int);
    callback attachment-preview-behaviour-remove(int, int, int);
    callback attachment-preview-behaviour-prop(int, int, int, int, string, string, float, bool);
    callback attachment-preview-modifier-remove(int, int, int);
    callback attachment-preview-modifier-enabled(int, int, int, bool);
    callback attachment-preview-modifier-field(int, int, int, string, string, float, bool);

    in-out property <[BrowserTreeRow]> browser-tree-rows: [];
    in-out property <[BrowserGridRow]> browser-grid-rows: [];
    in-out property <[BrowserPathSegment]> browser-path-segments: [];
    in property <bool> browser-drag-active: false;
    in property <string> browser-drag-source-path: "";
    in property <string> browser-drop-highlight-path: "";
    in property <bool> browser-viewport-drop-active: false;
    in property <string> browser-status-text: "0 items";
    in property <string> browser-selected-folder-path: "";
    in-out property <string> browser-selected-grid-path: "";

    in-out property <length> browser-origin-x: 0px;
    in-out property <length> browser-origin-y: 0px;
    in-out property <length> browser-width: 0px;
    in-out property <length> browser-height: 0px;
    in-out property <length> browser-tree-origin-y: 0px;
    in-out property <length> browser-tree-panel-height: 0px;
    in-out property <length> browser-tree-panel-width: 150px;
    in-out property <length> browser-thumb-size: 64px;
    in-out property <bool> browser-details-view: false;
    in property <int> browser-sort-column: 0;
    in property <bool> browser-sort-ascending: true;

    in-out property <[HistoryRow]> history-rows: [];
    in-out property <bool> history-filter-scene: true;
    in-out property <bool> history-filter-global: true;
    in-out property <int> filesystem-history-subtab: 0;

    callback browser-folder-selected(string);
    callback browser-folder-toggle(string);
    callback browser-refresh-requested();
    callback browser-import-requested();
    callback browser-new-scene-requested(string);
    callback browser-new-folder-requested(string);
    callback browser-rename-requested(string);
    callback browser-delete-requested(string);
    callback browser-duplicate-scene-requested(string);
    callback browser-open-scene-requested(string);
    callback browser-grid-select(string, bool, bool);
    callback browser-item-press(string, float, float);
