import { EditorTheme, EditorButton, EditorModalPanel } from "editor_controls.slint";

export component PlayDirtySceneDialog inherits Rectangle {
    in property <bool> show-dialog: false;

    callback save-and-play();
    callback play-last-saved();
    callback cancelled();

    visible: root.show-dialog;
    background: EditorTheme.modal-dim;

    TouchArea {
        width: 100%;
        height: 100%;
    }

    EditorModalPanel {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        panel-width: 420px;

        Text {
            text: "Scene has unsaved changes";
            color: EditorTheme.default-text;
            font-size: EditorTheme.font-lg;
        }

        Text {
            text: "Save before Play, play the last saved asset, or cancel.";
            color: EditorTheme.window-text;
            font-size: EditorTheme.font;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            EditorButton {
                text: "Cancel";
                clicked => { root.cancelled(); }
            }
            EditorButton {
                text: "Play Last Saved";
                clicked => { root.play-last-saved(); }
            }
            EditorButton {
                text: "Save and Play";
                primary: true;
                clicked => { root.save-and-play(); }
            }
        }
    }
}
