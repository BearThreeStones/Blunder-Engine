import { EditorTheme } from "editor_theme.slint";
import { HierarchyPanel, HierarchyTreeRow } from "hierarchy.slint";
import { InspectorPanel, BehaviourRow, SkeletonModifierRow, AnimationClipRow, AnimationClipPickerRow } from "inspector_panel.slint";
import { BrowserTreeRow, BrowserGridRow, BrowserPathSegment } from "content_browser.slint";
import { FilesystemHistoryHost, HistoryRow } from "history_panel.slint";
import { DockChromeBar, DockChromeMetrics, DockTab } from "docking_panel.slint";
import { AnimationWindowPanel } from "animation_window_panel.slint";
import { ConsolePanel, ConsoleRow } from "console_panel.slint";

export component FloatingPanelWindow inherits Window {
    in property <int> node-id: 0;
    in property <int> panel-kind: 0;
    in property <string> title-text: "";
    in property <[DockTab]> tabs: [];

    in property <[HierarchyTreeRow]> hierarchy-tree-rows: [];
    in property <int> hierarchy-selected-entity-id: 0;
    in property <string> hierarchy-scene-display-name: "(No Scene)";

    in property <bool> inspector-has-selection: false;
    in property <string> inspector-entity-name: "";
    in-out property <float> inspector-pos-x: 0.0;
    in-out property <float> inspector-pos-y: 0.0;
    in-out property <float> inspector-pos-z: 0.0;
    in-out property <float> inspector-rot-x: 0.0;
    in-out property <float> inspector-rot-y: 0.0;
    in-out property <float> inspector-rot-z: 0.0;
    in-out property <float> inspector-scale-x: 1.0;
    in-out property <float> inspector-scale-y: 1.0;
    in-out property <float> inspector-scale-z: 1.0;
    in-out property <float> inspector-quat-x: 0.0;
    in-out property <float> inspector-quat-y: 0.0;
    in-out property <float> inspector-quat-z: 0.0;
    in-out property <float> inspector-quat-w: 1.0;
    in property <bool> inspector-pos-x-mixed: false;
    in property <bool> inspector-pos-y-mixed: false;
    in property <bool> inspector-pos-z-mixed: false;
    in property <bool> inspector-rot-x-mixed: false;
    in property <bool> inspector-rot-y-mixed: false;
    in property <bool> inspector-rot-z-mixed: false;
    in property <bool> inspector-scale-x-mixed: false;
    in property <bool> inspector-scale-y-mixed: false;
    in property <bool> inspector-scale-z-mixed: false;
    in-out property <bool> inspector-transform-expanded: true;
    in-out property <bool> inspector-rotation-edit-mode-euler: true;
    in-out property <bool> inspector-scale-link-enabled: true;
    in property <bool> inspector-multi-edit-visible: false;
    in-out property <bool> inspector-multi-edit-absolute: true;
    in property <[BehaviourRow]> inspector-behaviours: [];
    in property <[string]> inspector-behaviour-type-choices: [];
    in property <[string]> inspector-behaviour-clip-name-choices: [];
    in-out property <int> inspector-behaviour-clip-name-picker-id: -1;
    in-out property <string> inspector-behaviour-clip-name-picker-key: "";
    in-out property <bool> inspector-behaviours-expanded: true;
    in property <[SkeletonModifierRow]> inspector-skeleton-modifiers: [];
    in property <[string]> inspector-skeleton-modifier-type-choices: [];
    in-out property <bool> inspector-skeleton-modifiers-expanded: true;
    in property <bool> inspector-has-camera: false;
    in-out property <float> inspector-camera-fov: 45.0;
    in-out property <float> inspector-camera-near: 0.1;
    in-out property <float> inspector-camera-far: 1000.0;
    in-out property <bool> inspector-camera-is-main: false;
    in-out property <bool> inspector-camera-expanded: true;
    in property <bool> inspector-has-light: false;
    in-out property <int> inspector-light-type: 0;
    in-out property <float> inspector-light-color-r: 1.0;
    in-out property <float> inspector-light-color-g: 1.0;
    in-out property <float> inspector-light-color-b: 1.0;
    in-out property <float> inspector-light-intensity: 1.0;
    in-out property <bool> inspector-light-enabled: true;
    in-out property <int> inspector-light-contribution: 0;
    in-out property <float> inspector-light-range: 10.0;
    in-out property <float> inspector-light-inner-cone: 0.0;
    in-out property <float> inspector-light-outer-cone: 45.0;
    in-out property <float> inspector-light-width: 1.0;
    in-out property <float> inspector-light-height: 1.0;
    in-out property <string> inspector-light-linking-text: "";
    in-out property <bool> inspector-light-expanded: true;
    in property <bool> inspector-has-animation-player: false;
    in property <[AnimationClipRow]> inspector-animation-clips: [];
    in property <[AnimationClipPickerRow]> inspector-clip-picker-choices: [];
    in-out property <bool> inspector-clip-picker-open: false;
    in property <int> inspector-clip-picker-target-index: -1;
    in property <int> inspector-clip-drop-highlight-index: -2;
    in-out property <bool> inspector-animation-player-expanded: true;
    in property <bool> inspector-add-menu-enabled: false;
    in property <bool> inspector-has-skeleton: false;
    in property <bool> inspector-has-animation-tree: false;
    in property <bool> inspector-remove-skeleton-enabled: true;
    in property <bool> inspector-asset-mode: false;
    in property <string> inspector-asset-display-name: "";
    in property <string> inspector-asset-guid: "";
    in property <string> inspector-asset-type: "";
    in property <string> inspector-asset-intermediate-path: "";
    in property <bool> mesh-material-section-visible: false;
    in-out property <bool> mesh-material-unlit: false;
    in-out property <float> mesh-base-color-r: 1.0;
    in-out property <float> mesh-base-color-g: 1.0;
    in-out property <float> mesh-base-color-b: 1.0;
    in-out property <float> mesh-base-color-a: 1.0;
    in-out property <float> mesh-metallic: 0.0;
    in-out property <float> mesh-roughness: 1.0;
    in-out property <float> mesh-ambient-r: 0.0;
    in-out property <float> mesh-ambient-g: 0.0;
    in-out property <float> mesh-ambient-b: 0.0;
    in-out property <float> mesh-diffuse-r: 1.0;
    in-out property <float> mesh-diffuse-g: 1.0;
    in-out property <float> mesh-diffuse-b: 1.0;
    in-out property <float> mesh-specular-r: 0.4;
    in-out property <float> mesh-specular-g: 0.4;
    in-out property <float> mesh-specular-b: 0.4;
    in-out property <float> mesh-shininess: 32.0;
    in property <string> mesh-slot-base-color-name: "";
    in property <bool> mesh-slot-base-color-assigned: false;
    in property <string> mesh-slot-metallic-name: "";
    in property <bool> mesh-slot-metallic-assigned: false;
    in property <string> mesh-slot-normal-name: "";
    in property <bool> mesh-slot-normal-assigned: false;
    in property <string> mesh-slot-occlusion-name: "";
    in property <bool> mesh-slot-occlusion-assigned: false;

    in-out property <[BrowserTreeRow]> browser-tree-rows: [];
    in-out property <[BrowserGridRow]> browser-grid-rows: [];
    in-out property <[BrowserPathSegment]> browser-path-segments: [];
    in property <bool> browser-drag-active: false;
    in property <string> browser-drag-source-path: "";
    in property <string> browser-drop-highlight-path: "";
    in property <bool> browser-viewport-drop-active: false;
    in property <string> browser-status-text: "0 items";
    in property <string> browser-selected-folder-path: "";
    in-out property <string> browser-selected-grid-path: "";
    in-out property <length> browser-thumb-size: 64px;
    in-out property <bool> browser-details-view: false;
    in property <int> browser-sort-column: 0;
    in property <bool> browser-sort-ascending: true;
    in-out property <[HistoryRow]> history-rows: [];
    in-out property <bool> history-filter-scene: true;
    in-out property <bool> history-filter-global: true;
    in-out property <int> filesystem-history-subtab: 0;

    in-out property <[ConsoleRow]> console-rows: [];
    in-out property <int> console-selected-index: -1;
    in-out property <string> console-detail-text: "";
    in-out property <string> console-detail-stack: "";
    in-out property <bool> console-collapse: false;
    in-out property <bool> console-clear-on-play: true;
    in-out property <bool> console-error-pause: false;
    in-out property <bool> console-filter-log: true;
    in-out property <bool> console-filter-warning: true;
    in-out property <bool> console-filter-error: true;
    in property <int> console-count-log: 0;
    in property <int> console-count-warning: 0;
    in property <int> console-count-error: 0;
    in-out property <string> console-search-text: "";
    callback console-clear-clicked();
    callback console-collapse-toggled();
    callback console-clear-on-play-toggled();
    callback console-error-pause-toggled();
    callback console-filter-changed();
    callback console-search-edited();
    callback console-row-selected(int);

    callback close-pressed();
    callback title-move-pressed(float, float);
    callback title-move-moved(float, float);
    callback title-move-released();
    callback grip-resize-pressed(int, float, float);
    callback grip-resize-moved(float, float);
    callback grip-resize-released();
    callback tab-pressed(int, float, float);
    callback tab-moved(float, float);
    callback tab-released(float, float);
    callback widget-closed(int);
    callback hierarchy-entity-selected(int);
    callback hierarchy-entity-context-selected(int);
    callback hierarchy-entity-toggle(int);
    callback hierarchy-create-requested(int, string);
    callback hierarchy-delete-requested(int);
    callback hierarchy-icon-pressed(int, float, float);
    callback inspector-transform-edited();
    callback inspector-field-text-committed(int, string);
    callback inspector-field-focus-changed(int, bool);
    callback inspector-rotation-mode-changed(bool);
    callback inspector-scale-link-toggled(bool);
    callback inspector-multi-edit-mode-changed(bool);
    callback inspector-add-behaviour(string);
    callback inspector-remove-behaviour(int);
    callback inspector-reorder-behaviour(int, int);
    callback inspector-commit-behaviour-prop(int, string, string, float, bool, bool);
    callback inspector-add-skeleton-modifier(string);
    callback inspector-remove-skeleton-modifier(int);
    callback inspector-reorder-skeleton-modifier(int, int);
    callback inspector-set-skeleton-modifier-enabled(int, bool);
    callback inspector-commit-skeleton-modifier-field(int, string, string, float, bool, bool);
    callback inspector-camera-edited(bool);
    callback inspector-light-edited(bool);
    callback inspector-add-unique-attachment(string);
    callback inspector-remove-unique-attachment(string);
    callback inspector-add-clip();
    callback inspector-remove-clip(int);
    callback inspector-commit-animation-clip(int, string, string);
    callback inspector-open-clip-picker(int);
    callback inspector-pick-clip-choice(string, string, string);
    callback inspector-activated();
    callback mesh-material-unlit-toggled(bool);
    callback mesh-material-scalar-committed(int, float, float, float, float, bool);
    callback color-hex-entered(int, string);
    callback mesh-material-reset-requested();
    callback mesh-slot-pick-requested(int);
    callback mesh-slot-clear-requested(int);
    callback mesh-slot-drop-requested(int);
    callback browser-folder-selected(string);
    callback browser-folder-toggle(string);
    callback browser-refresh-requested();
    callback browser-import-requested();
    callback browser-new-scene-requested(string);
    callback browser-new-folder-requested(string);
    callback browser-rename-requested(string);
    callback browser-delete-requested(string);
    callback browser-duplicate-scene-requested(string);
    callback browser-open-scene-requested(string);
    callback browser-grid-select(string, bool, bool);
    callback browser-item-press(string, float, float);
    callback browser-item-move(string, float, float);
    callback browser-item-release(string, float, float);
    callback browser-search-changed(string);
    callback browser-path-segment-clicked(string);
    callback browser-sort-clicked(int);
    callback history-filter-changed();
    callback history-entry-clicked(int, int);
    in-out property <string> browser-inline-rename-path: "";
    in-out property <string> browser-inline-rename-buffer: "";
    callback browser-inline-rename-commit(string);
    callback browser-inline-rename-cancel();

    in property <bool> anim-preview-enabled: false;
    in property <bool> anim-preview-playing: false;
    in property <bool> anim-preview-pause-enabled: false;
    in property <bool> anim-preview-stop-enabled: false;
    in property <bool> anim-preview-paused: false;
    in property <bool> anim-preview-looping: false;
    in-out property <float> anim-preview-time-scale: 1.0;
    in property <string> anim-preview-time-scale-text: "1.00";
    in property <float> anim-preview-playhead: 0.0;
    in property <float> anim-preview-clip-length: 1.0;
    in property <string> anim-preview-clip-name: "";
    in property <string> anim-preview-clock-text: "";
    in property <[string]> anim-preview-fire-clips: [];
    in-out property <string> anim-preview-fire-target: "";
    in property <bool> anim-preview-in-cine: false;
    in property <bool> anim-preview-input-suppressed: false;
    callback anim-preview-play-requested();
    callback anim-preview-pause-requested();
    callback anim-preview-stop-requested();
    callback anim-preview-loop-toggled();
    callback anim-preview-params-edited();
    callback anim-preview-timescale-pressed();
    callback anim-preview-timescale-edited();
    callback anim-preview-sync-fire-requested();
    callback anim-preview-enter-cine-requested();
    callback anim-preview-end-cine-requested();
    callback anim-preview-seeked(float);
    callback anim-preview-fire-target-changed(string);

    preferred-width: 320px;
    preferred-height: 240px;
    background: EditorTheme.window;

    property <length> grip-size: 14px;
    property <length> resize-edge: 5px;

    VerticalLayout {
        padding: 0;
        spacing: 0;

        chrome-bar := DockChromeBar {
            height: DockChromeMetrics.bar-height;
            embedded: true;
            show-chrome-move: true;
            show-window-close: true;
            tabs: root.tabs;
            chrome-move-pressed(x, y) => {
                root.title-move-pressed(
                    (chrome-bar.absolute-position.x - root.absolute-position.x + x) / 1px,
                    (chrome-bar.absolute-position.y - root.absolute-position.y + y) / 1px);
            }
            chrome-move-moved(x, y) => {
                root.title-move-moved(
                    (chrome-bar.absolute-position.x - root.absolute-position.x + x) / 1px,
                    (chrome-bar.absolute-position.y - root.absolute-position.y + y) / 1px);
            }
            chrome-move-released() => { root.title-move-released(); }
            window-close-pressed() => { root.close-pressed(); }
            tab-pressed(id, px, py) => {
                root.tab-pressed(id,
                    (chrome-bar.absolute-position.x - root.absolute-position.x + px) / 1px,
                    (chrome-bar.absolute-position.y - root.absolute-position.y + py) / 1px);
            }
            tab-moved(px, py) => {
                root.tab-moved(
                    (chrome-bar.absolute-position.x - root.absolute-position.x + px) / 1px,
                    (chrome-bar.absolute-position.y - root.absolute-position.y + py) / 1px);
            }
            tab-released(px, py) => {
                root.tab-released(
                    (chrome-bar.absolute-position.x - root.absolute-position.x + px) / 1px,
                    (chrome-bar.absolute-position.y - root.absolute-position.y + py) / 1px);
            }
            tab-activated(_) => { }
            widget-closed(id) => { root.widget-closed(id); }
            tab-pin-pressed(_) => { }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.panel-kind == 2 : HierarchyPanel {
                width: 100%;
                height: 100%;
                tree-rows: root.hierarchy-tree-rows;
                selected-entity-id: root.hierarchy-selected-entity-id;
                scene-display-name: root.hierarchy-scene-display-name;
                entity-selected(id) => { root.hierarchy-entity-selected(id); }
                entity-context-selected(id) => { root.hierarchy-entity-context-selected(id); }
                entity-toggle(id) => { root.hierarchy-entity-toggle(id); }
                create-requested(id, kind) => { root.hierarchy-create-requested(id, kind); }
                delete-requested(id) => { root.hierarchy-delete-requested(id); }
                icon-pressed(id, mx, rw) => { root.hierarchy-icon-pressed(id, mx, rw); }
            }

            if root.panel-kind == 3 : InspectorPanel {
                width: 100%;
                height: 100%;
                has-selection: root.inspector-has-selection;
                entity-name: root.inspector-entity-name;
                asset-mode: root.inspector-asset-mode;
                asset-display-name: root.inspector-asset-display-name;
                asset-guid: root.inspector-asset-guid;
                asset-type: root.inspector-asset-type;
                asset-intermediate-path: root.inspector-asset-intermediate-path;
                pos-x <=> root.inspector-pos-x;
                pos-y <=> root.inspector-pos-y;
                pos-z <=> root.inspector-pos-z;
                rot-x <=> root.inspector-rot-x;
                rot-y <=> root.inspector-rot-y;
                rot-z <=> root.inspector-rot-z;
                scale-x <=> root.inspector-scale-x;
                scale-y <=> root.inspector-scale-y;
                scale-z <=> root.inspector-scale-z;
                quat-x <=> root.inspector-quat-x;
                quat-y <=> root.inspector-quat-y;
                quat-z <=> root.inspector-quat-z;
                quat-w <=> root.inspector-quat-w;
                pos-x-mixed: root.inspector-pos-x-mixed;
                pos-y-mixed: root.inspector-pos-y-mixed;
                pos-z-mixed: root.inspector-pos-z-mixed;
                rot-x-mixed: root.inspector-rot-x-mixed;
                rot-y-mixed: root.inspector-rot-y-mixed;
                rot-z-mixed: root.inspector-rot-z-mixed;
                scale-x-mixed: root.inspector-scale-x-mixed;
                scale-y-mixed: root.inspector-scale-y-mixed;
                scale-z-mixed: root.inspector-scale-z-mixed;
                transform-expanded <=> root.inspector-transform-expanded;
                rotation-edit-mode-euler <=> root.inspector-rotation-edit-mode-euler;
                scale-link-enabled <=> root.inspector-scale-link-enabled;
                multi-edit-visible: root.inspector-multi-edit-visible;
                multi-edit-absolute <=> root.inspector-multi-edit-absolute;
                mesh-material-section-visible: root.mesh-material-section-visible;
                mesh-material-unlit <=> root.mesh-material-unlit;
                mesh-base-color-r <=> root.mesh-base-color-r;
                mesh-base-color-g <=> root.mesh-base-color-g;
                mesh-base-color-b <=> root.mesh-base-color-b;
                mesh-base-color-a <=> root.mesh-base-color-a;
                mesh-metallic <=> root.mesh-metallic;
                mesh-roughness <=> root.mesh-roughness;
                mesh-ambient-r <=> root.mesh-ambient-r;
                mesh-ambient-g <=> root.mesh-ambient-g;
                mesh-ambient-b <=> root.mesh-ambient-b;
                mesh-diffuse-r <=> root.mesh-diffuse-r;
                mesh-diffuse-g <=> root.mesh-diffuse-g;
                mesh-diffuse-b <=> root.mesh-diffuse-b;
                mesh-specular-r <=> root.mesh-specular-r;
                mesh-specular-g <=> root.mesh-specular-g;
                mesh-specular-b <=> root.mesh-specular-b;
                mesh-shininess <=> root.mesh-shininess;
                mesh-slot-base-color-name: root.mesh-slot-base-color-name;
                mesh-slot-base-color-assigned: root.mesh-slot-base-color-assigned;
                mesh-slot-metallic-name: root.mesh-slot-metallic-name;
                mesh-slot-metallic-assigned: root.mesh-slot-metallic-assigned;
                mesh-slot-normal-name: root.mesh-slot-normal-name;
                mesh-slot-normal-assigned: root.mesh-slot-normal-assigned;
                mesh-slot-occlusion-name: root.mesh-slot-occlusion-name;
                mesh-slot-occlusion-assigned: root.mesh-slot-occlusion-assigned;
                inspector-activated => { root.inspector-activated(); }
                mesh-material-unlit-toggled(checked) => { root.mesh-material-unlit-toggled(checked); }
                mesh-material-scalar-committed(id, a, b, c, d, commit) => { root.mesh-material-scalar-committed(id, a, b, c, d, commit); }
                color-hex-entered(target, hex) => { root.color-hex-entered(target, hex); }
                mesh-material-reset-requested => { root.mesh-material-reset-requested(); }
                mesh-slot-pick-requested(slot) => { root.mesh-slot-pick-requested(slot); }
                mesh-slot-clear-requested(slot) => { root.mesh-slot-clear-requested(slot); }
                mesh-slot-drop-requested(slot) => { root.mesh-slot-drop-requested(slot); }
                transform-edited => { root.inspector-transform-edited(); }
                field-text-committed(id, text) => { root.inspector-field-text-committed(id, text); }
                field-focus-changed(id, focused) => { root.inspector-field-focus-changed(id, focused); }
                rotation-mode-changed(euler) => { root.inspector-rotation-mode-changed(euler); }
                scale-link-toggled(linked) => { root.inspector-scale-link-toggled(linked); }
                multi-edit-mode-changed(absolute) => { root.inspector-multi-edit-mode-changed(absolute); }
                behaviours: root.inspector-behaviours;
                behaviour-type-choices: root.inspector-behaviour-type-choices;
                behaviour-clip-name-choices: root.inspector-behaviour-clip-name-choices;
                behaviour-clip-name-picker-id <=> root.inspector-behaviour-clip-name-picker-id;
                behaviour-clip-name-picker-key <=> root.inspector-behaviour-clip-name-picker-key;
                behaviours-expanded <=> root.inspector-behaviours-expanded;
                add-behaviour(type) => { root.inspector-add-behaviour(type); }
                remove-behaviour(id) => { root.inspector-remove-behaviour(id); }
                reorder-behaviour(from, to) => { root.inspector-reorder-behaviour(from, to); }
                commit-behaviour-prop(id, key, text, number, flag, commit) => {
                    root.inspector-commit-behaviour-prop(id, key, text, number, flag, commit);
                }
                skeleton-modifiers: root.inspector-skeleton-modifiers;
                skeleton-modifier-type-choices: root.inspector-skeleton-modifier-type-choices;
                skeleton-modifiers-expanded <=> root.inspector-skeleton-modifiers-expanded;
                add-skeleton-modifier(type) => { root.inspector-add-skeleton-modifier(type); }
                remove-skeleton-modifier(index) => { root.inspector-remove-skeleton-modifier(index); }
                reorder-skeleton-modifier(from, to) => { root.inspector-reorder-skeleton-modifier(from, to); }
                set-skeleton-modifier-enabled(index, enabled) => {
                    root.inspector-set-skeleton-modifier-enabled(index, enabled);
                }
                commit-skeleton-modifier-field(index, key, text, number, flag, commit) => {
                    root.inspector-commit-skeleton-modifier-field(index, key, text, number, flag, commit);
                }
                has-camera: root.inspector-has-camera;
                camera-fov <=> root.inspector-camera-fov;
                camera-near <=> root.inspector-camera-near;
                camera-far <=> root.inspector-camera-far;
                camera-is-main <=> root.inspector-camera-is-main;
                camera-expanded <=> root.inspector-camera-expanded;
                camera-edited(commit) => { root.inspector-camera-edited(commit); }
                has-light: root.inspector-has-light;
                light-type <=> root.inspector-light-type;
                light-comp-color-r <=> root.inspector-light-color-r;
                light-comp-color-g <=> root.inspector-light-color-g;
                light-comp-color-b <=> root.inspector-light-color-b;
                light-intensity <=> root.inspector-light-intensity;
                light-enabled <=> root.inspector-light-enabled;
                light-contribution <=> root.inspector-light-contribution;
                light-range <=> root.inspector-light-range;
                light-inner-cone <=> root.inspector-light-inner-cone;
                light-outer-cone <=> root.inspector-light-outer-cone;
                light-width <=> root.inspector-light-width;
                light-height <=> root.inspector-light-height;
                light-linking-text <=> root.inspector-light-linking-text;
                light-expanded <=> root.inspector-light-expanded;
                light-edited(commit) => { root.inspector-light-edited(commit); }
                has-animation-player: root.inspector-has-animation-player;
                animation-clips: root.inspector-animation-clips;
                animation-player-expanded <=> root.inspector-animation-player-expanded;
                browser-drag-active: root.browser-drag-active;
                clip-drop-highlight-index: root.inspector-clip-drop-highlight-index;
                clip-picker-choices: root.inspector-clip-picker-choices;
                clip-picker-open <=> root.inspector-clip-picker-open;
                clip-picker-target-index: root.inspector-clip-picker-target-index;
                add-menu-enabled: root.inspector-add-menu-enabled;
                has-skeleton: root.inspector-has-skeleton;
                has-animation-tree: root.inspector-has-animation-tree;
                remove-skeleton-enabled: root.inspector-remove-skeleton-enabled;
                add-unique-attachment(kind) => { root.inspector-add-unique-attachment(kind); }
                remove-unique-attachment(kind) => { root.inspector-remove-unique-attachment(kind); }
                add-clip => { root.inspector-add-clip(); }
                remove-clip(index) => { root.inspector-remove-clip(index); }
                commit-animation-clip(index, name, guid) => {
                    root.inspector-commit-animation-clip(index, name, guid);
                }
                open-clip-picker(index) => { root.inspector-open-clip-picker(index); }
                pick-clip-choice(guid, stem, display) => {
                    root.inspector-pick-clip-choice(guid, stem, display);
                }
            }

            if root.panel-kind == 4 || root.panel-kind == 6 : Rectangle {
                width: 100%;
                height: 100%;

            FilesystemHistoryHost {
                width: 100%;
                height: 100%;
                visible: root.panel-kind == 4;
                tree-rows: root.browser-tree-rows;
                grid-rows: root.browser-grid-rows;
                path-segments: root.browser-path-segments;
                drag-active: root.browser-drag-active;
                drag-source-path: root.browser-drag-source-path;
                drop-highlight-path: root.browser-drop-highlight-path;
                viewport-drop-active: root.browser-viewport-drop-active;
                status-text: root.browser-status-text;
                selected-folder-path: root.browser-selected-folder-path;
                selected-grid-path <=> root.browser-selected-grid-path;
                thumb-size <=> root.browser-thumb-size;
                details-view <=> root.browser-details-view;
                sort-column: root.browser-sort-column;
                sort-ascending: root.browser-sort-ascending;
                history-rows <=> root.history-rows;
                history-filter-scene <=> root.history-filter-scene;
                history-filter-global <=> root.history-filter-global;
                active-subtab <=> root.filesystem-history-subtab;
                inline-rename-path: root.browser-inline-rename-path;
                inline-rename-buffer: root.browser-inline-rename-buffer;
                folder-selected(path) => { root.browser-folder-selected(path); }
                folder-toggle(path) => { root.browser-folder-toggle(path); }
                refresh-requested => { root.browser-refresh-requested(); }
                import-requested => { root.browser-import-requested(); }
                new-scene-requested(path) => { root.browser-new-scene-requested(path); }
                new-folder-requested(path) => { root.browser-new-folder-requested(path); }
                rename-requested(path) => { root.browser-rename-requested(path); }
                delete-requested(path) => { root.browser-delete-requested(path); }
                duplicate-scene-requested(path) => { root.browser-duplicate-scene-requested(path); }
                open-scene-requested(path) => { root.browser-open-scene-requested(path); }
                grid-select(path, ctrl, shift) => { root.browser-grid-select(path, ctrl, shift); }
                item-press(path, x, y) => { root.browser-item-press(path, x, y); }
                item-move(path, x, y) => { root.browser-item-move(path, x, y); }
                item-release(path, x, y) => { root.browser-item-release(path, x, y); }
                search-changed(text) => { root.browser-search-changed(text); }
                path-segment-clicked(path) => { root.browser-path-segment-clicked(path); }
                sort-clicked(column) => { root.browser-sort-clicked(column); }
                history-filter-changed => { root.history-filter-changed(); }
                history-entry-clicked(stack, index) => { root.history-entry-clicked(stack, index); }
                inline-rename-commit(name) => { root.browser-inline-rename-commit(name); }
                inline-rename-cancel => { root.browser-inline-rename-cancel(); }
            }

            ConsolePanel {
                width: 100%;
                height: 100%;
                visible: root.panel-kind == 6;
                rows <=> root.console-rows;
                selected-index <=> root.console-selected-index;
                detail-text <=> root.console-detail-text;
                detail-stack <=> root.console-detail-stack;
                collapse <=> root.console-collapse;
                clear-on-play <=> root.console-clear-on-play;
                error-pause <=> root.console-error-pause;
                filter-log <=> root.console-filter-log;
                filter-warning <=> root.console-filter-warning;
                filter-error <=> root.console-filter-error;
                count-log: root.console-count-log;
                count-warning: root.console-count-warning;
                count-error: root.console-count-error;
                search-text <=> root.console-search-text;
                clear-clicked => { root.console-clear-clicked(); }
                collapse-toggled => { root.console-collapse-toggled(); }
                clear-on-play-toggled => { root.console-clear-on-play-toggled(); }
                error-pause-toggled => { root.console-error-pause-toggled(); }
                filter-changed => { root.console-filter-changed(); }
                search-edited => { root.console-search-edited(); }
                row-selected(i) => { root.console-row-selected(i); }
            }
            }

            if root.panel-kind == 5 : AnimationWindowPanel {
                width: 100%;
                height: 100%;
                bound: root.anim-preview-enabled;
                playing: root.anim-preview-playing;
                paused: root.anim-preview-paused;
                pause-enabled: root.anim-preview-pause-enabled;
                stop-enabled: root.anim-preview-stop-enabled;
                looping: root.anim-preview-looping;
                time-scale <=> root.anim-preview-time-scale;
                time-scale-text: root.anim-preview-time-scale-text;
                playhead: root.anim-preview-playhead;
                clip-length: root.anim-preview-clip-length;
                clip-name: root.anim-preview-clip-name;
                clock-text: root.anim-preview-clock-text;
                fire-clips: root.anim-preview-fire-clips;
                fire-target <=> root.anim-preview-fire-target;
                in-cine: root.anim-preview-in-cine;
                input-suppressed: root.anim-preview-input-suppressed;
                play-requested => { root.anim-preview-play-requested(); }
                pause-requested => { root.anim-preview-pause-requested(); }
                stop-requested => { root.anim-preview-stop-requested(); }
                loop-toggled => { root.anim-preview-loop-toggled(); }
                fire-requested => { root.anim-preview-sync-fire-requested(); }
                enter-cine-requested => { root.anim-preview-enter-cine-requested(); }
                end-cine-requested => { root.anim-preview-end-cine-requested(); }
                timescale-pressed => { root.anim-preview-timescale-pressed(); }
                timescale-edited => { root.anim-preview-timescale-edited(); }
                timescale-committed => { root.anim-preview-params-edited(); }
                seeked(t) => { root.anim-preview-seeked(t); }
                fire-target-changed(name) => { root.anim-preview-fire-target-changed(name); }
            }

            grip := Rectangle {
                x: parent.width - root.grip-size;
                y: parent.height - root.grip-size;
                width: root.grip-size;
                height: root.grip-size;
                background: grip-drag.has-hover ? EditorTheme.accent-hover : EditorTheme.button;

                grip-drag := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.nwse-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(3,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: root.resize-edge;
                y: 0;
                width: parent.width - 2 * root.resize-edge;
                height: root.resize-edge;
                north-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.ns-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(5,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: root.resize-edge;
                y: parent.height - root.resize-edge;
                width: parent.width - 2 * root.resize-edge;
                height: root.resize-edge;
                south-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.ns-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(2,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: root.resize-edge;
                width: root.resize-edge;
                height: parent.height - 2 * root.resize-edge;
                west-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.ew-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(4,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - root.resize-edge;
                y: root.resize-edge;
                width: root.resize-edge;
                height: parent.height - 2 * root.resize-edge;
                east-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.ew-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(1,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: 0;
                width: root.resize-edge;
                height: root.resize-edge;
                nw-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.nwse-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(7,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - root.resize-edge;
                y: 0;
                width: root.resize-edge;
                height: root.resize-edge;
                ne-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.nesw-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(6,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }

            Rectangle {
                x: 0;
                y: parent.height - root.resize-edge;
                width: root.resize-edge;
                height: root.resize-edge;
                sw-edge := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: MouseCursor.nesw-resize;
                    moved => {
                        root.grip-resize-moved(
                            (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                            (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                    }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            root.grip-resize-pressed(8,
                                (self.absolute-position.x - root.absolute-position.x + self.mouse-x) / 1px,
                                (self.absolute-position.y - root.absolute-position.y + self.mouse-y) / 1px);
                        }
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.up) {
                            root.grip-resize-released();
                        }
                    }
                }
            }
        }
    }
}
