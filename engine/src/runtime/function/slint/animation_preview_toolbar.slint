import { EditorTheme, EditorButton, EditorTextField } from "editor_controls.slint";
import { AxisNumberField } from "axis_number_field.slint";

export component AnimationPreviewToolbar inherits Rectangle {
    in property <bool> preview-enabled: false;
    in property <bool> preview-pause-enabled: false;
    in property <bool> preview-stop-enabled: false;
    in property <bool> preview-paused: false;
    in property <bool> preview-looping: false;

    in-out property <float> preview-time-scale: 1.0;
    in-out property <float> preview-blend-weight: 0.0;
    in-out property <float> preview-fade-seconds: 0.0;
    in-out property <string> preview-slot0: "";
    in-out property <string> preview-slot1: "";

    in property <bool> preview-in-cine: false;
    in property <bool> preview-input-suppressed: false;
    in property <bool> preview-sync-fire-enabled: false;
    in property <bool> preview-enter-cine-enabled: false;
    in property <bool> preview-end-cine-enabled: false;

    callback preview-play-requested();
    callback preview-pause-requested();
    callback preview-stop-requested();
    callback preview-loop-toggled();
    callback preview-params-edited();
    callback preview-sync-fire-requested();
    callback preview-enter-cine-requested();
    callback preview-end-cine-requested();

    visible: root.preview-enabled || root.preview-in-cine || root.preview-sync-fire-enabled;
    y: 48px;
    x: 8px;
    height: 58px;
    background: EditorTheme.toolbar.with-alpha(88%);
    border-radius: EditorTheme.radius-surface;
    border-width: 1px;
    border-color: EditorTheme.hairline;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000066;

    VerticalLayout {
        padding: 4px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 4px;

            EditorButton {
                text: "Play";
                primary: true;
                enabled: root.preview-enabled;
                clicked => { root.preview-play-requested(); }
            }

            EditorButton {
                text: root.preview-paused ? "Resume" : "Pause";
                enabled: root.preview-pause-enabled;
                clicked => { root.preview-pause-requested(); }
            }

            EditorButton {
                text: "Stop";
                enabled: root.preview-stop-enabled;
                clicked => { root.preview-stop-requested(); }
            }

            Rectangle { width: 8px; }

            EditorButton {
                text: "Loop";
                checked: root.preview-looping;
                enabled: root.preview-enabled;
                clicked => { root.preview-loop-toggled(); }
            }

            Rectangle { width: 8px; }

            AxisNumberField {
                width: 72px;
                axis-label: "TS";
                axis-color: #8ab4f8;
                value <=> root.preview-time-scale;
                scrub-sensitivity: 0.05;
                live-edited => { root.preview-params-edited(); }
            }

            AxisNumberField {
                width: 72px;
                axis-label: "BW";
                axis-color: #f8b48a;
                value <=> root.preview-blend-weight;
                show-slider: true;
                slider-min: 0.0;
                slider-max: 1.0;
                scrub-sensitivity: 0.01;
                live-edited => { root.preview-params-edited(); }
            }

            AxisNumberField {
                width: 72px;
                axis-label: "Fd";
                axis-color: #b4f88a;
                value <=> root.preview-fade-seconds;
                scrub-sensitivity: 0.05;
                live-edited => { root.preview-params-edited(); }
            }
        }

        HorizontalLayout {
            spacing: 4px;

            Text {
                text: "S0";
                color: EditorTheme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            EditorTextField {
                width: 80px;
                height: EditorTheme.line;
                text <=> root.preview-slot0;
                edited => { root.preview-params-edited(); }
            }

            Text {
                text: "S1";
                color: EditorTheme.muted;
                font-size: 11px;
                vertical-alignment: center;
            }
            EditorTextField {
                width: 80px;
                height: EditorTheme.line;
                text <=> root.preview-slot1;
                edited => { root.preview-params-edited(); }
            }

            Rectangle { width: 8px; }

            EditorButton {
                text: "Fire";
                visible: root.preview-sync-fire-enabled;
                enabled: root.preview-sync-fire-enabled && root.preview-slot0 != "";
                clicked => { root.preview-sync-fire-requested(); }
            }

            EditorButton {
                text: "Enter";
                visible: root.preview-enter-cine-enabled;
                enabled: root.preview-enter-cine-enabled;
                clicked => { root.preview-enter-cine-requested(); }
            }

            EditorButton {
                text: "End";
                visible: root.preview-end-cine-enabled;
                enabled: root.preview-end-cine-enabled;
                clicked => { root.preview-end-cine-requested(); }
            }

            Rectangle { width: 8px; }

            Rectangle {
                width: 52px;
                height: 24px;
                border-radius: EditorTheme.radius-ctl;
                background: root.preview-in-cine ? #6a3d9a : #2a2a2a;
                border-width: 1px;
                border-color: root.preview-in-cine ? #b06aff : #444444;
                visible: root.preview-in-cine;
                Text {
                    text: "CINE";
                    color: #ffffff;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                width: 44px;
                height: 24px;
                border-radius: EditorTheme.radius-ctl;
                background: root.preview-input-suppressed ? #9a3d3d : #2a2a2a;
                border-width: 1px;
                border-color: root.preview-input-suppressed ? #ff6a6a : #444444;
                visible: root.preview-input-suppressed;
                Text {
                    text: "Inp";
                    color: #ffffff;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
