import { HorizontalBox } from "std-widgets.slint";

export component AnimationPreviewToolbar inherits Rectangle {
    in property <bool> preview-enabled: false;
    in property <bool> preview-pause-enabled: false;
    in property <bool> preview-stop-enabled: false;
    in property <bool> preview-paused: false;
    in property <bool> preview-looping: false;

    callback preview-play-requested();
    callback preview-pause-requested();
    callback preview-stop-requested();
    callback preview-loop-toggled();

    visible: root.preview-enabled;
    y: 48px;
    x: 8px;
    height: 32px;
    background: #1a1a1acc;
    border-radius: 4px;
    border-width: 1px;
    border-color: #3a3a3a;

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 3px;
            background: play-touch.has-hover ? #3d6b9a : #2a2a2a;
            border-width: 1px;
            border-color: #444444;
            Text {
                text: "Play";
                color: #e8e8e8;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            play-touch := TouchArea {
                enabled: root.preview-enabled;
                clicked => { root.preview-play-requested(); }
            }
        }

        Rectangle {
            width: 52px;
            height: 24px;
            border-radius: 3px;
            background: pause-touch.has-hover ? #3d6b9a : #2a2a2a;
            border-width: 1px;
            border-color: #444444;
            Text {
                text: root.preview-paused ? "Resume" : "Pause";
                color: root.preview-pause-enabled ? #e8e8e8 : #707070;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            pause-touch := TouchArea {
                enabled: root.preview-pause-enabled;
                clicked => { root.preview-pause-requested(); }
            }
        }

        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: 3px;
            background: stop-touch.has-hover ? #3d6b9a : #2a2a2a;
            border-width: 1px;
            border-color: #444444;
            Text {
                text: "Stop";
                color: root.preview-stop-enabled ? #e8e8e8 : #707070;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            stop-touch := TouchArea {
                enabled: root.preview-stop-enabled;
                clicked => { root.preview-stop-requested(); }
            }
        }

        Rectangle { width: 8px; }

        Rectangle {
            width: 52px;
            height: 24px;
            border-radius: 3px;
            background: root.preview-looping ? #3d6b9a : #2a2a2a;
            border-width: 1px;
            border-color: root.preview-looping ? #6ab0ff : #444444;
            Text {
                text: "Loop";
                color: root.preview-looping ? #ffffff : #b0b0b0;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            loop-touch := TouchArea {
                enabled: root.preview-enabled;
                clicked => { root.preview-loop-toggled(); }
            }
        }
    }
}
