import { EditorTheme, EditorSlider } from "editor_controls.slint";
import {
    EditorIconSearch,
    EditorIconReload,
    EditorIconFolder,
    EditorIconTreeArrowRight,
    EditorIconTreeArrowDown,
    EditorIconScene,
    EditorIconMesh,
    EditorIconTexture,
    EditorIconAnimation,
    EditorIconFile,
    EditorIconViewLayout,
} from "editor_icons.slint";

export struct BrowserTreeRow {
    path: string,
    name: string,
    depth: int,
    is-dir: bool,
    expanded: bool,
    has-children: bool,
}

export struct BrowserGridRow {
    path: string,
    name: string,
    thumb: image,
    is-dir: bool,
    is-scene: bool,
    selected: bool,
    type-kind: int,
    type-label: string,
    size-text: string,
    date-text: string,
}

export struct BrowserPathSegment {
    path: string,
    name: string,
}

component BrowserContextMenu {
    in property <string> target-path: "";
    in property <bool> show-new: false;
    in property <bool> show-scene-actions: false;
    in property <bool> show-rename: false;
    in property <bool> show-delete: false;
    in property <bool> enabled: true;
    property <bool> show-separator:
        (root.show-new || root.show-scene-actions)
        && (root.show-rename || root.show-delete);

    callback new-folder(string);
    callback new-scene(string);
    callback open-scene(string);
    callback duplicate-scene(string);
    callback rename(string);
    callback delete-item(string);

    width: 100%;
    height: 100%;

    ContextMenuArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        Menu {
            if root.show-new: MenuItem {
                title: "New Folder";
                activated => { root.new-folder(root.target-path); }
            }
            if root.show-new: MenuItem {
                title: "New Scene";
                activated => { root.new-scene(root.target-path); }
            }
            if root.show-scene-actions: MenuItem {
                title: "Open";
                activated => { root.open-scene(root.target-path); }
            }
            if root.show-scene-actions: MenuItem {
                title: "Duplicate";
                activated => { root.duplicate-scene(root.target-path); }
            }
            if root.show-separator: MenuSeparator {}
            if root.show-rename: MenuItem {
                title: "Rename";
                activated => { root.rename(root.target-path); }
            }
            if root.show-delete: MenuItem {
                title: "Delete";
                activated => { root.delete-item(root.target-path); }
            }
        }
    }
}

export component ContentBrowser {
    // --- Data from C++ ---
    in-out property <[BrowserTreeRow]> tree-rows: [];
    in-out property <[BrowserGridRow]> grid-rows: [];
    in-out property <[BrowserPathSegment]> path-segments: [];
    in property <bool> drag-active: false;
    in property <string> drag-source-path: "";
    in property <string> drop-highlight-path: "";
    in property <bool> viewport-drop-active: false;
    in property <string> status-text: "0 items";
    in property <string> selected-folder-path: "";
    in-out property <string> selected-grid-path: "";
    in property <int> sort-column: 0;
    in property <bool> sort-ascending: true;

    // --- Local UI state ---
    in-out property <length> thumb-size: 80px;
    in-out property <bool> details-view: false;
    in-out property <length> tree-pane-width: 200px;
    in property <bool> layout-drag-active: false;
    property <bool> view-menu-visible: false;
    property <bool> context-menus-enabled:
        !root.drag-active && !root.layout-drag-active
        && root.inline-rename-path == "";

    // --- Callbacks ---
    callback folder-selected(string);
    callback folder-toggle(string);
    callback refresh-requested();
    callback import-requested();
    callback new-scene-requested(string);
    callback new-folder-requested(string);
    callback rename-requested(string);
    callback delete-requested(string);
    callback duplicate-scene-requested(string);
    callback open-scene-requested(string);
    /// Grid click selection: ctrl = toggle, shift = range from anchor.
    callback grid-select(string, bool, bool);
    callback item-press(string, float, float);
    callback item-move(string, float, float);
    callback item-release(string, float, float);
    callback layout-drag-active-changed(bool);
    callback search-changed(string);
    callback path-segment-clicked(string);
    callback sort-clicked(int);
    in-out property <string> inline-rename-path: "";
    in-out property <string> inline-rename-buffer: "";
    callback inline-rename-commit(string);
    callback inline-rename-cancel();

    // --- Geometry output for C++ hit-testing ---
    out property <length> browser-origin-x: browser-root.absolute-position.x;
    out property <length> browser-origin-y: browser-root.absolute-position.y;
    out property <length> browser-width: browser-root.width;
    out property <length> browser-height: browser-root.height;
    in-out property <length> tree-origin-y: tree-list.absolute-position.y;
    in-out property <length> tree-panel-height: tree-panel.height;
    in-out property <length> grid-origin-x: grid-flickable.absolute-position.x;
    in-out property <length> grid-origin-y: grid-flickable.absolute-position.y;
    in-out property <length> grid-area-width: grid-area.width;
    in-out property <length> grid-viewport-y: grid-flickable.viewport-y;
    in-out property <int> grid-column-count: root.grid-cols;

    min-height: 120px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    // --- Grid layout calculations ---
    property <length> cell-gap: 8px;
    property <length> details-row-h: 22px;
    property <length> details-type-w: 90px;
    property <length> details-size-w: 72px;
    property <length> details-date-w: 118px;
    property <length> cell-total-w: root.thumb-size + root.cell-gap;
    property <length> cell-total-h: root.details-view ? root.details-row-h : (root.thumb-size + 28px + root.cell-gap);
    property <int> grid-cols: root.details-view ? 1 : Math.max(1, Math.floor(grid-area.width / Math.max(1px, root.cell-total-w)));
    property <int> icon-px: (root.thumb-size / 1px);
    property <int> dist-48: Math.abs(root.icon-px - 48);
    property <int> dist-80: Math.abs(root.icon-px - 80);
    property <int> dist-104: Math.abs(root.icon-px - 104);
    property <int> dist-128: Math.abs(root.icon-px - 128);
    property <int> nearest-icon-dist: Math.min(Math.min(root.dist-48, root.dist-80), Math.min(root.dist-104, root.dist-128));
    property <int> nearest-icon-px: root.dist-128 == root.nearest-icon-dist ? 128
        : (root.dist-104 == root.nearest-icon-dist ? 104
            : (root.dist-80 == root.nearest-icon-dist ? 80 : 48));

    browser-root := Rectangle {
        width: 100%;
        height: 100%;
        background: EditorTheme.window;
        border-color: EditorTheme.hairline;
        border-width: 1px;
        horizontal-stretch: 1;
        vertical-stretch: 1;

        VerticalLayout {
            spacing: 0px;
            width: 100%;
            height: 100%;

            // ═══════════════ Toolbar ═══════════════
            Rectangle {
                height: 34px;
                background: EditorTheme.toolbar;

                HorizontalLayout {
                    padding: 5px;
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;

                    // Search box
                    Rectangle {
                        horizontal-stretch: 1;
                        background: EditorTheme.field;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;

                            VerticalLayout {
                                width: 18px;
                                alignment: center;
                                EditorIconSearch {
                                    icon-size: 12px;
                                    icon-color: EditorTheme.icon;
                                }
                            }

                            search-input := TextInput {
                                horizontal-stretch: 1;
                                font-size: 11px;
                                color: EditorTheme.default-text;
                                vertical-alignment: center;

                                accepted => {
                                    root.search-changed(self.text);
                                }
                                edited => {
                                    root.search-changed(self.text);
                                }
                            }
                        }
                    }

                    // Refresh button
                    refresh-btn := Rectangle {
                        width: 26px;
                        height: 24px;
                        background: refresh-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;

                        EditorIconReload {
                            icon-size: 14px;
                            icon-color: EditorTheme.icon;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        refresh-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down) {
                                    root.refresh-requested();
                                }
                            }
                        }
                    }

                    // Import button
                    import-btn := Rectangle {
                        width: 68px;
                        height: 24px;
                        background: import-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;

                        Text {
                            text: "+ Import";
                            color: EditorTheme.button-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        import-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down) {
                                    root.import-requested();
                                }
                            }
                        }
                    }

                    // New Folder
                    new-folder-btn := Rectangle {
                        width: 88px;
                        height: 24px;
                        background: new-folder-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;

                        Text {
                            text: "+ New Folder";
                            color: EditorTheme.button-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        new-folder-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down) {
                                    root.new-folder-requested(root.selected-folder-path);
                                }
                            }
                        }
                    }

                    // New Scene Asset
                    new-scene-btn := Rectangle {
                        width: 88px;
                        height: 24px;
                        background: new-scene-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;

                        Text {
                            text: "+ New Scene";
                            color: EditorTheme.button-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        new-scene-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down) {
                                    root.new-scene-requested(root.selected-folder-path);
                                }
                            }
                        }
                    }

                    // Delete selected Asset
                    delete-btn := Rectangle {
                        width: 68px;
                        height: 24px;
                        background: delete-touch.has-hover ? EditorTheme.button-hover : EditorTheme.button;
                        border-radius: EditorTheme.radius-ctl;
                        border-color: EditorTheme.hairline;
                        border-width: 1px;
                        opacity: root.selected-grid-path == "" ? 0.45 : 1.0;

                        Text {
                            text: "Delete";
                            color: EditorTheme.button-text;
                            font-size: 11px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        delete-touch := TouchArea {
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down
                                    && root.selected-grid-path != "") {
                                    root.delete-requested("");
                                }
                            }
                        }
                    }
                }
            }

            // Toolbar separator
            Rectangle { height: 1px; background: EditorTheme.hairline; }

            // ═══════════════ Breadcrumb Path Bar ═══════════════
            Rectangle {
                height: 24px;
                background: EditorTheme.toolbar;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 0px;

                    for seg[seg-index] in root.path-segments: HorizontalLayout {
                        spacing: 0px;

                        if seg-index > 0: VerticalLayout {
                            padding-left: 4px;
                            padding-right: 4px;
                            alignment: center;
                            EditorIconTreeArrowRight {
                                icon-size: 10px;
                                icon-color: EditorTheme.icon;
                            }
                        }

                        path-seg-touch := TouchArea {

                            Rectangle {
                                background: path-seg-touch.has-hover ? EditorTheme.tab-hover : #00000000;
                                border-radius: 2px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;

                                    Text {
                                        text: seg.name;
                                        color: path-seg-touch.has-hover ? EditorTheme.default-text : EditorTheme.muted;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left
                                    && event.kind == PointerEventKind.down) {
                                    root.path-segment-clicked(seg.path);
                                }
                            }
                        }
                    }
                }
            }

            // Path bar separator
            Rectangle { height: 1px; background: EditorTheme.hairline; }

            // ═══════════════ Main Body: Tree (left) + Grid (right) ═══════════════
            body := HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0px;

                // ─── Left: Folder Tree ───
                tree-panel := Rectangle {
                    width: root.tree-pane-width;
                    background: EditorTheme.field;
                    clip: true;

                    tree-scroll := Flickable {
                        width: parent.width;
                        height: parent.height;
                        interactive: true;
                        viewport-width: parent.width;
                        viewport-height: tree-list.preferred-height;

                        BrowserContextMenu {
                            width: parent.width;
                            height: Math.max(parent.height, tree-list.preferred-height);
                            target-path: root.selected-folder-path;
                            show-new: true;
                            enabled: root.context-menus-enabled;
                            new-folder(path) => { root.new-folder-requested(path); }
                            new-scene(path) => { root.new-scene-requested(path); }
                        }

                        tree-list := VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 0px;
                            padding-top: 2px;

                            for row[index] in root.tree-rows: Rectangle {
                                horizontal-stretch: 1;
                                height: 22px;
                                background:
                                    row.path == root.selected-folder-path
                                        ? EditorTheme.accent-sel-fill
                                    : tree-name-touch.has-hover || tree-arrow-touch.has-hover
                                        ? EditorTheme.tab-hover
                                    : #00000000;

                                HorizontalLayout {
                                    horizontal-stretch: 1;
                                    padding-left: 4px + row.depth * 16px;
                                    spacing: 0px;
                                    height: 22px;

                                    // Expand/collapse arrow
                                    tree-arrow-touch := TouchArea {
                                        width: 18px;
                                        height: 22px;

                                        if row.has-children && row.expanded: EditorIconTreeArrowDown {
                                            icon-size: 10px;
                                            icon-color: EditorTheme.icon;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if row.has-children && !row.expanded: EditorIconTreeArrowRight {
                                            icon-size: 10px;
                                            icon-color: EditorTheme.icon;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }

                                        pointer-event(event) => {
                                            if (row.has-children
                                                && event.button == PointerEventButton.left
                                                && event.kind == PointerEventKind.down) {
                                                root.folder-toggle(row.path);
                                            }
                                        }
                                    }

                                    // Folder icon
                                    VerticalLayout {
                                        width: 18px;
                                        alignment: center;
                                        EditorIconFolder {
                                            icon-size: 12px;
                                            icon-color: EditorTheme.icon;
                                        }
                                    }

                                    // Folder name
                                    tree-name-touch := TouchArea {
                                        horizontal-stretch: 1;
                                        height: 22px;

                                        Text {
                                            text: row.name;
                                            color: row.path == root.selected-folder-path
                                                ? EditorTheme.accent-sel-text : EditorTheme.default-text;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }

                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left
                                                && event.kind == PointerEventKind.down) {
                                                root.folder-selected(row.path);
                                            }
                                        }
                                    }
                                }

                                BrowserContextMenu {
                                    x: 0px;
                                    y: 0px;
                                    width: 100%;
                                    height: 100%;
                                    target-path: row.path;
                                    show-new: true;
                                    show-rename: row.path != "assets" && row.path != "assets/";
                                    show-delete: row.path != "assets" && row.path != "assets/";
                                    enabled: root.context-menus-enabled;
                                    new-folder(path) => { root.new-folder-requested(path); }
                                    new-scene(path) => { root.new-scene-requested(path); }
                                    rename(path) => { root.rename-requested(path); }
                                    delete-item(path) => { root.delete-requested(path); }
                                }
                            }
                        }
                    }
                }

                // Vertical divider (tree ↔ grid)
                Rectangle {
                    width: 3px;
                    background: EditorTheme.hairline;
                }

                // ─── Right: Asset Grid ───
                grid-area := Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: EditorTheme.toolbar;
                    clip: true;

                    VerticalLayout {
                        spacing: 0px;
                        width: 100%;
                        height: 100%;

                        if root.details-view: Rectangle {
                            height: root.details-row-h;
                            background: EditorTheme.toolbar;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 6px;

                                Rectangle {
                                    width: 16px;
                                }
                                details-name-hdr := TouchArea {
                                    horizontal-stretch: 1;
                                    clicked => { root.sort-clicked(0); }
                                    Text {
                                        text: root.sort-column == 0
                                            ? (root.sort-ascending ? "Name ▲" : "Name ▼")
                                            : "Name";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                details-type-hdr := TouchArea {
                                    width: root.details-type-w;
                                    clicked => { root.sort-clicked(1); }
                                    Text {
                                        text: root.sort-column == 1
                                            ? (root.sort-ascending ? "Type ▲" : "Type ▼")
                                            : "Type";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                                details-size-hdr := TouchArea {
                                    width: root.details-size-w;
                                    clicked => { root.sort-clicked(2); }
                                    Text {
                                        text: root.sort-column == 2
                                            ? (root.sort-ascending ? "Size ▲" : "Size ▼")
                                            : "Size";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }
                                details-date-hdr := TouchArea {
                                    width: root.details-date-w;
                                    clicked => { root.sort-clicked(3); }
                                    Text {
                                        text: root.sort-column == 3
                                            ? (root.sort-ascending ? "Date modified ▲" : "Date modified ▼")
                                            : "Date modified";
                                        color: EditorTheme.muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                        horizontal-alignment: right;
                                    }
                                }
                            }
                        }

                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            if root.drag-active: Rectangle {
                                z: 10;
                                height: 26px;
                                background: EditorTheme.accent-sel-fill;

                                Text {
                                    text: root.viewport-drop-active
                                        ? "Release over viewport to place"
                                        : "Dragging: " + root.drag-source-path;
                                    color: EditorTheme.accent-sel-text;
                                    font-size: 10px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            grid-flickable := Flickable {
                                width: parent.width;
                                height: parent.height;
                                interactive: !root.layout-drag-active;
                                viewport-width: parent.width;
                                viewport-height: Math.max(parent.height,
                                    Math.ceil(root.grid-rows.length / Math.max(1, root.grid-cols))
                                    * root.cell-total-h + 8px);

                                BrowserContextMenu {
                                    width: parent.width;
                                    height: Math.max(parent.height,
                                        Math.ceil(root.grid-rows.length / Math.max(1, root.grid-cols))
                                        * root.cell-total-h + 8px);
                                    target-path: root.selected-folder-path;
                                    show-new: true;
                                    enabled: root.context-menus-enabled;
                                    new-folder(path) => { root.new-folder-requested(path); }
                                    new-scene(path) => { root.new-scene-requested(path); }
                                }

                                for tile[index] in root.grid-rows: Rectangle {
                                    x: root.details-view ? 0px
                                        : (Math.mod(index, Math.max(1, root.grid-cols))
                                           * root.cell-total-w + 4px);
                                    y: root.details-view
                                        ? Math.floor(index / Math.max(1, root.grid-cols))
                                           * root.cell-total-h
                                        : (Math.floor(index / Math.max(1, root.grid-cols))
                                           * root.cell-total-h + 4px);
                                    width: root.details-view ? parent.width : root.thumb-size;
                                    height: root.details-view ? root.details-row-h
                                        : (root.thumb-size + 24px);
                                    border-radius: root.details-view ? 0px : EditorTheme.radius-surface;
                                    border-width: (!root.details-view && (tile.selected || tile.path == root.selected-grid-path)) ? 2px : 0px;
                                    border-color: EditorTheme.accent;
                                    background:
                                        tile.selected || tile.path == root.selected-grid-path
                                            ? EditorTheme.accent-sel-fill
                                        : tile.path == root.drag-source-path
                                            ? EditorTheme.accent-soft
                                        : grid-tile-touch.has-hover
                                            ? EditorTheme.tab-hover
                                        : (root.details-view ? #00000000 : EditorTheme.toolbar);

                                    if !root.details-view: VerticalLayout {
                                        spacing: 2px;
                                        padding: 3px;

                                        Rectangle {
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            background: tile.is-dir ? #00000000 : EditorTheme.field;
                                            border-radius: EditorTheme.radius-ctl;

                                            if tile.is-dir: EditorIconFolder {
                                                icon-size: root.thumb-size * 0.4;
                                                icon-color: EditorTheme.icon;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            if !tile.is-dir: Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: tile.thumb;
                                                image-fit: contain;
                                            }
                                        }

                                        if tile.path == root.inline-rename-path: Rectangle {
                                            height: 16px;
                                            background: EditorTheme.field;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: EditorTheme.accent;
                                            rename-input := TextInput {
                                                x: 4px;
                                                width: parent.width - 8px;
                                                height: 100%;
                                                text <=> root.inline-rename-buffer;
                                                color: EditorTheme.default-text;
                                                font-size: 10px;
                                                single-line: true;
                                                init => { self.focus(); }
                                                accepted => {
                                                    root.inline-rename-commit(self.text);
                                                }
                                                key-pressed(event) => {
                                                    if (event.text == Key.Escape) {
                                                        root.inline-rename-cancel();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                        }
                                        if tile.path != root.inline-rename-path: Rectangle {
                                            height: 16px;
                                            Text {
                                                text: tile.name;
                                                color: EditorTheme.default-text;
                                                font-size: 10px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                                width: 100%;
                                                height: 100%;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    if (tile.selected) {
                                                        root.rename-requested(tile.path);
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    if root.details-view: HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;

                                        VerticalLayout {
                                            width: 16px;
                                            alignment: center;
                                            if tile.type-kind == 0: EditorIconFolder {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                            if tile.type-kind == 1: EditorIconMesh {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                            if tile.type-kind == 2: EditorIconScene {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                            if tile.type-kind == 3: EditorIconTexture {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                            if tile.type-kind == 4: EditorIconAnimation {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                            if tile.type-kind == 5: EditorIconFile {
                                                icon-size: 16px;
                                                icon-color: EditorTheme.icon;
                                            }
                                        }

                                        if tile.path == root.inline-rename-path: Rectangle {
                                            vertical-stretch: 1;
                                            background: EditorTheme.field;
                                            border-radius: 3px;
                                            border-width: 1px;
                                            border-color: EditorTheme.accent;
                                            TextInput {
                                                x: 4px;
                                                width: parent.width - 8px;
                                                height: 100%;
                                                text <=> root.inline-rename-buffer;
                                                color: EditorTheme.default-text;
                                                font-size: 11px;
                                                single-line: true;
                                                init => { self.focus(); }
                                                accepted => {
                                                    root.inline-rename-commit(self.text);
                                                }
                                                key-pressed(event) => {
                                                    if (event.text == Key.Escape) {
                                                        root.inline-rename-cancel();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                        }
                                        if tile.path != root.inline-rename-path: Rectangle {
                                            horizontal-stretch: 1;
                                            vertical-stretch: 1;
                                            Text {
                                                text: tile.name;
                                                color: EditorTheme.default-text;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                width: 100%;
                                                height: 100%;
                                            }
                                            TouchArea {
                                                clicked => {
                                                    if (tile.selected) {
                                                        root.rename-requested(tile.path);
                                                    }
                                                }
                                            }
                                        }
                                        Text {
                                            text: tile.type-label;
                                            color: EditorTheme.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            width: root.details-type-w;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: tile.size-text;
                                            color: EditorTheme.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            width: root.details-size-w;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: tile.date-text;
                                            color: EditorTheme.muted;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            width: root.details-date-w;
                                            overflow: elide;
                                        }
                                    }

                                    grid-tile-touch := TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        moved => {
                                            root.item-move(tile.path,
                                                self.mouse-x / 1px, self.mouse-y / 1px);
                                        }
                                        clicked => {
                                            root.item-release(tile.path,
                                                self.mouse-x / 1px, self.mouse-y / 1px);
                                        }
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left
                                                && event.kind == PointerEventKind.down) {
                                                root.grid-select(
                                                    tile.path,
                                                    event.modifiers.control,
                                                    event.modifiers.shift);
                                                root.item-press(tile.path,
                                                    self.mouse-x / 1px, self.mouse-y / 1px);
                                            }
                                            if (event.button == PointerEventButton.left
                                                && event.kind == PointerEventKind.up) {
                                                root.item-release(tile.path,
                                                    self.mouse-x / 1px, self.mouse-y / 1px);
                                            }
                                        }
                                    }

                                    BrowserContextMenu {
                                        x: 0px;
                                        y: 0px;
                                        width: 100%;
                                        height: 100%;
                                        target-path: tile.path;
                                        show-new: tile.is-dir;
                                        show-scene-actions: tile.is-scene;
                                        show-rename: tile.path != "assets"
                                            && tile.path != "assets/";
                                        show-delete: !tile.is-dir
                                            || (tile.path != "assets"
                                                && tile.path != "assets/");
                                        enabled: root.context-menus-enabled;
                                        new-folder(path) => { root.new-folder-requested(path); }
                                        new-scene(path) => { root.new-scene-requested(path); }
                                        open-scene(path) => { root.open-scene-requested(path); }
                                        duplicate-scene(path) => { root.duplicate-scene-requested(path); }
                                        rename(path) => { root.rename-requested(path); }
                                        delete-item(path) => { root.delete-requested(path); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ═══════════════ Status Bar ═══════════════
            Rectangle {
                height: 22px;
                background: EditorTheme.toolbar;
                border-color: EditorTheme.hairline;
                border-width: 0px;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;

                    // Item count
                    Text {
                        text: root.status-text;
                        color: EditorTheme.muted;
                        font-size: 10px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Drag status during drag
                    if root.drag-active: Text {
                        text: root.viewport-drop-active
                            ? "Drop on viewport to place"
                            : "Dragging...";
                        color: EditorTheme.accent-sel-text;
                        font-size: 10px;
                        vertical-alignment: center;
                    }

                    view-layout-btn := TouchArea {
                        width: 18px;
                        height: 18px;
                        clicked => {
                            root.view-menu-visible = !root.view-menu-visible;
                        }
                        VerticalLayout {
                            alignment: center;
                            EditorIconViewLayout {
                                icon-size: 12px;
                                icon-color: view-layout-btn.has-hover ? EditorTheme.default-text : EditorTheme.icon;
                            }
                        }
                    }

                    EditorSlider {
                        width: 100px;
                        minimum: 0;
                        maximum: 128;
                        value: root.details-view ? 0 : (root.thumb-size / 1px);
                        edited => {
                            if (self.value < 48) {
                                root.details-view = true;
                            } else {
                                root.details-view = false;
                                root.thumb-size = self.value * 1px;
                            }
                        }
                    }
                }
            }
        }

        if root.view-menu-visible: context-dismiss := TouchArea {
            z: 100;
            width: 100%;
            height: 100%;
            clicked => {
                root.view-menu-visible = false;
            }
        }

        if root.view-menu-visible: view-menu-panel := Rectangle {
            z: 101;
            x: browser-root.width - 198px;
            y: browser-root.height - 22px - 142px;
            width: 188px;
            height: 138px;
            background: EditorTheme.window;
            border-color: EditorTheme.hairline;
            border-width: 1px;
            border-radius: EditorTheme.radius-ctl;

            VerticalLayout {
                padding: 4px;
                spacing: 0px;

                view-xl := TouchArea {
                    height: 26px;
                    clicked => {
                        root.details-view = false;
                        root.thumb-size = 128px;
                        root.view-menu-visible = false;
                    }
                    Rectangle {
                        background: view-xl.has-hover ? EditorTheme.tab-hover : transparent;
                        border-radius: 2px;
                        Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (!root.details-view && root.nearest-icon-px == 128 ? "✓  " : "    ") + "Extra Large Icons";
                            color: EditorTheme.default-text;
                            font-size: 12px;
                        }
                    }
                }
                view-lg := TouchArea {
                    height: 26px;
                    clicked => {
                        root.details-view = false;
                        root.thumb-size = 104px;
                        root.view-menu-visible = false;
                    }
                    Rectangle {
                        background: view-lg.has-hover ? EditorTheme.tab-hover : transparent;
                        border-radius: 2px;
                        Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (!root.details-view && root.nearest-icon-px == 104 ? "✓  " : "    ") + "Large Icons";
                            color: EditorTheme.default-text;
                            font-size: 12px;
                        }
                    }
                }
                view-md := TouchArea {
                    height: 26px;
                    clicked => {
                        root.details-view = false;
                        root.thumb-size = 80px;
                        root.view-menu-visible = false;
                    }
                    Rectangle {
                        background: view-md.has-hover ? EditorTheme.tab-hover : transparent;
                        border-radius: 2px;
                        Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (!root.details-view && root.nearest-icon-px == 80 ? "✓  " : "    ") + "Medium Icons";
                            color: EditorTheme.default-text;
                            font-size: 12px;
                        }
                    }
                }
                view-sm := TouchArea {
                    height: 26px;
                    clicked => {
                        root.details-view = false;
                        root.thumb-size = 48px;
                        root.view-menu-visible = false;
                    }
                    Rectangle {
                        background: view-sm.has-hover ? EditorTheme.tab-hover : transparent;
                        border-radius: 2px;
                        Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (!root.details-view && root.nearest-icon-px == 48 ? "✓  " : "    ") + "Small Icons";
                            color: EditorTheme.default-text;
                            font-size: 12px;
                        }
                    }
                }
                view-dt := TouchArea {
                    height: 26px;
                    clicked => {
                        root.details-view = true;
                        root.view-menu-visible = false;
                    }
                    Rectangle {
                        background: view-dt.has-hover ? EditorTheme.tab-hover : transparent;
                        border-radius: 2px;
                        Text {
                            x: 8px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: (root.details-view ? "✓  " : "    ") + "Details";
                            color: EditorTheme.default-text;
                            font-size: 12px;
                        }
                    }
                }
            }
        }
    }
}
