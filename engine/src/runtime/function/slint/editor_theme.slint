// Editor Theme tokens (ADR 0039). Import this file; use EditorTheme.* as the chrome source of truth.

export global EditorTheme {
    // Base layers
    out property <color> app-bar: #191B1F;
    out property <color> window: #2A2D31;
    out property <color> toolbar: #34383D;
    out property <color> field: #1E2125;
    out property <color> viewport: #1E2125;

    out property <color> hairline: #3B3F45;
    out property <color> window-text: #B8BFC6;
    out property <color> default-text: #E8EBEF;
    out property <color> muted: #98A0A8;
    out property <color> icon: #B3BBC4;
    out property <color> label: #B8BFC6;

    out property <color> button: #3A3E44;
    out property <color> button-hover: #454A51;
    out property <color> button-pressed: #4E545C;
    out property <color> button-text: #E8EBEF;

    out property <color> titlebar: #34383D;
    out property <color> titlebar-hover: #3C4046;

    out property <color> tab-idle: transparent;
    out property <color> tab-hover: #24272B;
    out property <color> tab-active: #2A2D31;
    out property <color> tab-text: #98A0A8;

    out property <color> accent: #4C8DFF;
    out property <color> accent-text: #ffffff;
    out property <color> accent-soft: #4C8DFF2B;
    out property <color> accent-line: #4C8DFF73;
    out property <color> accent-hover: #6CA2FF;
    out property <color> accent-sel-fill: #4C8DFF38;
    out property <color> accent-sel-text: #85B2FF;

    out property <color> modal-dim: #0A0C0E94;
    out property <color> hier-line: #737373;

    out property <length> radius-ctl: 6px;
    out property <length> radius-surface: 10px;
    out property <length> radius-modal: 14px;
    out property <length> line: 22px;
    out property <length> line-lg: 26px;
    out property <length> app-bar-height: 48px;
    out property <length> font: 12px;
    out property <length> font-sm: 11px;
    out property <length> font-lg: 14px;
}
