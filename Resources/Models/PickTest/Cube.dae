  <library_effects>
    <effect id="Texture-fx" name="Texture">
      <profile_COMMON>
        <newparam sid="Texture-diffuse-surface">
          <surface type="2D">
            <init_from>Texture-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Texture-diffuse-sampler">
          <sampler2D>
            <source>Texture-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="Texture-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
    <effect id="material_1-fx" name="">
      <profile_COMMON>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <color sid="diffuse">1   1   1   1</color>
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
